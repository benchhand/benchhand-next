---
// SPDX-FileCopyrightText: 2026 Sjors Robroek
//
// SPDX-License-Identifier: MPL-2.0
// Starlight's SocialIcons, after the header's section links: uppercase mono, like the labels of a drawing
// sheet. Starlight shows this group from 50rem up; below that the menu button opens the sidebar.
import Default from "@astrojs/starlight/components/SocialIcons.astro";

import { siteLink } from "../site-link";

const SECTIONS = [
  { label: "Get started", link: "/getting-started/install/" },
  { label: "Concepts", link: "/concepts/process/overview/" },
  { label: "Reference", link: "/reference/" },
];
---

<nav class="bh-sections" aria-label="Sections">
  <ul>
    {
      SECTIONS.map(({ label, link }) => (
        <li>
          <a href={siteLink(link)}>{label}</a>
        </li>
      ))
    }
  </ul>
</nav>
<Default />

<style>
  ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    font: 500 0.8rem/1 var(--__sl-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
