---
// SPDX-FileCopyrightText: 2026 Sjors Robroek
//
// SPDX-License-Identifier: MPL-2.0
// Starlight's MarkdownContent, with the "Planned" aside on every page whose front matter sets
// `phase`. The label lives in PlannedAside, not in each page's prose, and links to the plan's phase list.
import Default from "@astrojs/starlight/components/MarkdownContent.astro";

import PlannedAside from "./PlannedAside.astro";

const { phase } = Astro.locals.starlightRoute.entry.data;
---

<Default>
  {phase !== undefined && <PlannedAside phases={[phase]} />}
  <slot />
</Default>
