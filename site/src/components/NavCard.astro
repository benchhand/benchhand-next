---
// A card that links to one page: an icon, a heading that holds the link, and a description.
// The whole card is clickable through the link's ::after, while the accessible name stays the
// heading text. Starlight's LinkCard has no icon and puts the description in the link's name.
import { Badge, Icon } from "@astrojs/starlight/components";
import type { StarlightIcon } from "@astrojs/starlight/types";

import { siteLink } from "../site-link";

interface Props {
  title: string;
  /** A site route ("/reference/"), "repo:<path>" or an absolute URL; see src/site-link.ts. */
  href: string;
  icon: StarlightIcon;
  /** Heading level, so the card fits the page outline. */
  level?: 2 | 3;
  /** A short status shown under the heading, such as "Available". */
  status?: string;
  statusVariant?: "success" | "caution" | "note" | "default";
}

const { title, href, icon, level = 3, status, statusVariant = "default" } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---

<article class="bh-card not-content">
  <span class="bh-card-icon"><Icon name={icon} size="1.25rem" /></span>
  <Heading class="bh-card-title"><a href={siteLink(href)}>{title}</a></Heading>
  {status && <p class="bh-card-status"><Badge text={status} variant={statusVariant} /></p>}
  <div class="bh-card-body"><slot /></div>
</article>

<style>
  .bh-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    align-content: start;
    padding: 1.125rem 1.25rem 1.25rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    transition: border-color 120ms ease-out, background-color 120ms ease-out;
  }
  .bh-card:hover {
    border-color: var(--sl-color-text-accent);
  }
  .bh-card:has(a:focus-visible) {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .bh-card-icon {
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
  }
  .bh-card-title {
    grid-row: 1;
    align-self: center;
    margin: 0;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
  }
  .bh-card-title a {
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .bh-card-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .bh-card-title a:focus-visible {
    outline: none;
  }
  .bh-card:hover .bh-card-title a {
    color: var(--sl-color-text-accent);
  }
  .bh-card-status {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
  }
  .bh-card-body {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .bh-card-body :global(code) {
    font-size: 0.85em;
  }
  @media (prefers-reduced-motion: reduce) {
    .bh-card {
      transition: none;
    }
  }
</style>
