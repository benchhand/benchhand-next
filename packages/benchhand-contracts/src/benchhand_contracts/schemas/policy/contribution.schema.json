{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/policy/contribution.schema.json",
  "title": "benchhand policy provider contribution, provisional",
  "description": "Provisional: what one policy provider adds to the flow (ADR-0014): rule lists in the shape of flow/<kind>.rules.yaml, and CEL requirements for the gates of flow.yaml. The merge order is fixed. A contributed rule list's rules come before the rules of the flow's list of the same kind, so a contributed rule matches first; the contributions are taken in ascending provider name, each in its own order. A gate's contributed requirements must hold as well as flow.yaml's, and are checked after them in the same provider order. A requirement for a step the gate doesn't have, or for a gate flow.yaml doesn't declare, is refused when the flow loads",
  "x-status": "provisional",
  "x-version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../flow/rules.schema.json"
      }
    },
    "gates": {
      "description": "Requirements by the gate id flow.yaml declares",
      "type": "object",
      "propertyNames": {
        "$ref": "../record/common.schema.json#/$defs/gate_id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/PolicyGateRequirements"
      },
      "minProperties": 1
    }
  },
  "examples": [
    {
      "rules": [
        {
          "rules_version": 1,
          "kind": "rigor",
          "rules": [
            {
              "when": "policy.rigor == \"regulated\"",
              "then": [
                "record.requirements.all(r, r.standard.present)"
              ]
            }
          ]
        }
      ],
      "gates": {
        "design_freeze": {
          "human": [
            "record.verification.all(v, v.reviewed_by.present)"
          ]
        }
      }
    },
    {
      "rules": [
        {
          "rules_version": 1,
          "kind": "dispatch",
          "rules": [
            {
              "when": "obligation.family.startsWith(\"process.welding.\")",
              "then": [
                "process.welding"
              ]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "PolicyGateRequirements": {
      "description": "Extra requirements for the steps of one gate",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "provisional": {
          "$ref": "../common/cel.schema.json#/$defs/CelExpressions"
        },
        "full": {
          "$ref": "../common/cel.schema.json#/$defs/CelExpressions"
        },
        "human": {
          "$ref": "../common/cel.schema.json#/$defs/CelExpressions"
        }
      }
    }
  }
}
