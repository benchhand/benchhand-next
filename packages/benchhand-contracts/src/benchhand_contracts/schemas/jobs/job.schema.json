{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/jobs/job.schema.json",
  "title": "benchhand job",
  "description": "A long-running job of the job service. JobRecord is the run record kept at <project>/.benchhand/runs/<jobId>.json; JobHandle is what jobs.start, jobs.status and jobs.result return to the agent.",
  "x-version": "1.0.0",
  "oneOf": [
    {
      "$ref": "#/$defs/JobRecord"
    },
    {
      "$ref": "#/$defs/JobHandle"
    }
  ],
  "examples": [
    {
      "jobId": "3f9c1a7b02de",
      "kind": "collision/sweep",
      "status": "running",
      "progress": {
        "fraction": 0.4,
        "message": "pair 12 of 30"
      },
      "argv": [
        "python3",
        "-m",
        "sweep",
        "--version",
        "LMP-0003"
      ],
      "cwd": "/work/lamp",
      "host": "workstation",
      "owner": {
        "pid": 4121,
        "identity": "6f3a0c1e-9d1b-4a52-8d0e-0b7d2f5f1c11:48213377"
      },
      "process": {
        "pid": 4188,
        "identity": "6f3a0c1e-9d1b-4a52-8d0e-0b7d2f5f1c11:48213391"
      },
      "resultPath": "/work/lamp/.benchhand/runs/3f9c1a7b02de.result",
      "logPath": "/work/lamp/.benchhand/runs/3f9c1a7b02de.log",
      "exitCode": null,
      "error": null,
      "createdAt": "2026-03-02T09:14:07+00:00",
      "startedAt": "2026-03-02T09:14:07+00:00",
      "finishedAt": null
    },
    {
      "jobId": "3f9c1a7b02de",
      "kind": "collision/sweep",
      "status": "succeeded",
      "progress": {
        "fraction": 1,
        "message": "30 of 30 pairs"
      },
      "resultPath": "/work/lamp/.benchhand/runs/3f9c1a7b02de.result",
      "logPath": "/work/lamp/.benchhand/runs/3f9c1a7b02de.log",
      "exitCode": 0,
      "error": null,
      "createdAt": "2026-03-02T09:14:07+00:00",
      "startedAt": "2026-03-02T09:14:07+00:00",
      "finishedAt": "2026-03-02T09:16:41+00:00"
    },
    {
      "jobId": "a81e5c0d77b4",
      "kind": "fem/solve",
      "status": "failed",
      "progress": {
        "fraction": null,
        "message": null
      },
      "resultPath": null,
      "logPath": "/work/lamp/.benchhand/runs/a81e5c0d77b4.log",
      "exitCode": 3,
      "error": "the job exited with status 3",
      "createdAt": "2026-03-02T09:20:00+00:00",
      "startedAt": "2026-03-02T09:20:00+00:00",
      "finishedAt": "2026-03-02T09:20:12+00:00"
    }
  ],
  "$defs": {
    "JobId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "JobKind": {
      "description": "What the job does, named by whoever starts it, for example collision/sweep.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9./-]{0,63}$"
    },
    "JobStatus": {
      "description": "queued: recorded, process not started. running. succeeded: the process exited 0. failed: it exited otherwise. cancelled: cancellation stopped it.",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "JobProgress": {
      "description": "The last progress the job reported: the same fraction and message as a provider $/progress notification. Both are null until the first report.",
      "type": "object",
      "properties": {
        "fraction": {
          "minimum": 0,
          "maximum": 1,
          "type": [
            "number",
            "null"
          ]
        },
        "message": {
          "maxLength": 500,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "fraction",
        "message"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "description": "UTC, RFC 3339, with an uppercase T and Z: the validators of each language disagree on a lowercase t or z, so the pattern refuses them.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$",
      "format": "date-time"
    },
    "OptionalTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "ProcessIdentity": {
      "description": "A process id with its start identity. The kernel reuses ids, so a pid proves nothing once its process is gone: the process runs only while some process has that pid and that identity. On Linux the identity is the boot id and the start time, elsewhere ps lstart.",
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "pid",
        "identity"
      ],
      "additionalProperties": false
    },
    "ExitCode": {
      "description": "The job's exit status. A negative value is the signal that ended it. Null until it ends.",
      "type": [
        "integer",
        "null"
      ]
    },
    "JobRecord": {
      "type": "object",
      "properties": {
        "jobId": {
          "$ref": "#/$defs/JobId"
        },
        "kind": {
          "$ref": "#/$defs/JobKind"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "progress": {
          "$ref": "#/$defs/JobProgress"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "description": "The host the job runs on. A record of another host cannot be checked."
        },
        "owner": {
          "$ref": "#/$defs/ProcessIdentity",
          "description": "The process of the job service that started the job. It reaps the job and writes its final status."
        },
        "process": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProcessIdentity"
            },
            {
              "type": "null"
            }
          ],
          "description": "The job's supervisor: it starts the command in a process group of its own, ends that group when the command ends or its owner does, and exits with the command's status. Null while queued."
        },
        "resultPath": {
          "type": "string",
          "description": "Where the job is to write its result. Absolute."
        },
        "logPath": {
          "type": "string",
          "description": "The job's standard output and error. Absolute."
        },
        "exitCode": {
          "$ref": "#/$defs/ExitCode"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/OptionalTimestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/OptionalTimestamp"
        }
      },
      "required": [
        "jobId",
        "kind",
        "status",
        "progress",
        "argv",
        "cwd",
        "host",
        "owner",
        "process",
        "resultPath",
        "logPath",
        "exitCode",
        "error",
        "createdAt",
        "startedAt",
        "finishedAt"
      ],
      "additionalProperties": false
    },
    "JobHandle": {
      "type": "object",
      "properties": {
        "jobId": {
          "$ref": "#/$defs/JobId"
        },
        "kind": {
          "$ref": "#/$defs/JobKind"
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "progress": {
          "$ref": "#/$defs/JobProgress"
        },
        "resultPath": {
          "description": "The job's result file. Set only once the job succeeded and wrote it; null otherwise.",
          "type": [
            "string",
            "null"
          ]
        },
        "logPath": {
          "type": "string"
        },
        "exitCode": {
          "$ref": "#/$defs/ExitCode"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/OptionalTimestamp"
        },
        "finishedAt": {
          "$ref": "#/$defs/OptionalTimestamp"
        }
      },
      "required": [
        "jobId",
        "kind",
        "status",
        "progress",
        "resultPath",
        "logPath",
        "exitCode",
        "error",
        "createdAt",
        "startedAt",
        "finishedAt"
      ],
      "additionalProperties": false
    }
  }
}
