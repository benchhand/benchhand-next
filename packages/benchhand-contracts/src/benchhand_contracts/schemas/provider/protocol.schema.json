{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/provider/protocol.schema.json",
  "title": "benchhand provider protocol",
  "description": "Message shapes of the benchhand provider protocol. Prose rules: docs/contract/provider-protocol.md.",
  "x-protocol-version": 1,
  "x-version": "1.1.0",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Notification"
    },
    {
      "$ref": "#/$defs/SuccessResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ],
  "examples": [
    {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "initialize",
      "params": {
        "protocolVersion": 1,
        "minProtocolVersion": 1,
        "host": {
          "name": "benchhand",
          "version": "0.1.0"
        },
        "capabilities": {
          "hooks": [
            "kernel"
          ],
          "features": [
            "progress",
            "artifacts",
            "cancel"
          ]
        },
        "limits": {
          "maxMessageBytes": 16777216,
          "maxInFlight": 16
        },
        "projectRoot": "/work/lamp"
      }
    },
    {
      "jsonrpc": "2.0",
      "method": "$/progress",
      "params": {
        "id": 2,
        "fraction": 0.5,
        "message": "LMP-0003 built"
      }
    },
    {
      "jsonrpc": "2.0",
      "id": 3,
      "error": {
        "code": -32007,
        "message": "FreeCAD 1.0.2 is not a supported version",
        "data": {
          "code": "external-missing",
          "fix": "Run `benchhand setup` to install FreeCAD 1.1.4."
        }
      }
    }
  ],
  "$defs": {
    "RequestId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ProtocolVersion": {
      "type": "integer",
      "minimum": 1
    },
    "HookKind": {
      "enum": [
        "kernel",
        "cad-app",
        "solver",
        "collision",
        "renderer",
        "viewer",
        "process-check",
        "store",
        "policy",
        "cli"
      ]
    },
    "HookId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "FeatureName": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*|x-[a-z0-9-]+)$"
    },
    "AbsPath": {
      "description": "Absolute POSIX path.",
      "type": "string",
      "pattern": "^/",
      "minLength": 2
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "HookDecl": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/HookKind"
        },
        "id": {
          "$ref": "#/$defs/HookId"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "kind": "kernel",
          "id": "build123d"
        }
      ]
    },
    "ErrorObject": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "parse-error",
                "invalid-request",
                "method-not-found",
                "invalid-params",
                "internal-error",
                "protocol-version-unsupported",
                "required-feature-missing",
                "not-initialized",
                "message-too-large",
                "request-cancelled",
                "input-unsupported",
                "external-missing"
              ]
            },
            "supported": {
              "type": "object",
              "properties": {
                "min": {
                  "$ref": "#/$defs/ProtocolVersion"
                },
                "max": {
                  "$ref": "#/$defs/ProtocolVersion"
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            },
            "fix": {
              "type": "string"
            },
            "detail": true
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "code": -32602,
          "message": "params.input.parts is missing",
          "data": {
            "code": "invalid-params"
          }
        }
      ]
    },
    "Limits": {
      "type": "object",
      "properties": {
        "maxMessageBytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 16777216
        },
        "maxInFlight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "maxMessageBytes": 16777216,
          "maxInFlight": 4
        }
      ]
    },
    "InitializeParams": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "minProtocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "host": {
          "type": "object",
          "properties": {
            "name": {
              "const": "benchhand"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "hooks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/HookKind"
              },
              "uniqueItems": true
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FeatureName"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "hooks",
            "features"
          ],
          "additionalProperties": false
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "projectRoot": {
          "$ref": "#/$defs/AbsPath"
        }
      },
      "required": [
        "protocolVersion",
        "host",
        "capabilities",
        "limits"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "protocolVersion": 1,
          "host": {
            "name": "benchhand",
            "version": "0.1.0"
          },
          "capabilities": {
            "hooks": [
              "kernel"
            ],
            "features": [
              "progress",
              "cancel"
            ]
          },
          "limits": {
            "maxMessageBytes": 16777216,
            "maxInFlight": 16
          },
          "projectRoot": "/work/lamp"
        }
      ]
    },
    "InitializeResult": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "provider": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "hooks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HookDecl"
          },
          "minItems": 1
        },
        "features": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FeatureName"
              }
            },
            "optional": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FeatureName"
              }
            }
          },
          "required": [
            "required",
            "optional"
          ],
          "additionalProperties": false
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "needs": {
          "$ref": "#/$defs/Needs"
        }
      },
      "required": [
        "protocolVersion",
        "provider",
        "hooks",
        "features",
        "limits",
        "needs"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "protocolVersion": 1,
          "provider": {
            "name": "benchhand-build123d",
            "version": "0.1.0"
          },
          "hooks": [
            {
              "kind": "kernel",
              "id": "build123d"
            }
          ],
          "features": {
            "required": [],
            "optional": [
              "progress"
            ]
          },
          "limits": {
            "maxInFlight": 4
          },
          "needs": {
            "freecad": false,
            "chromium": false,
            "network": false
          }
        }
      ]
    },
    "Needs": {
      "type": "object",
      "properties": {
        "freecad": {
          "type": "boolean"
        },
        "chromium": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        }
      },
      "required": [
        "freecad",
        "chromium",
        "network"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "freecad": true,
          "chromium": false,
          "network": false
        }
      ]
    },
    "CancelParams": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "id": 7
        }
      ]
    },
    "ProgressParams": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "stage": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "id": 7,
          "fraction": 0.25,
          "message": "LMP-0003 built",
          "stage": "build"
        }
      ]
    },
    "LogParams": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 4000
        },
        "data": true
      },
      "required": [
        "level",
        "message"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "level": "warning",
          "message": "fillet radius clamped to 0.4 mm",
          "data": {
            "pn": "LMP-0003"
          }
        }
      ]
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/AbsPath"
        },
        "mediaType": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "path",
        "mediaType",
        "role",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "path": "/work/lamp/out/LMP-0003.step",
          "mediaType": "model/step",
          "role": "step",
          "bytes": 48213,
          "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
        }
      ]
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ],
      "examples": [
        {
          "status": "pass"
        },
        {
          "status": "unknown",
          "reason": "no mesh for LMP-0004"
        }
      ]
    },
    "HookParamsBase": {
      "type": "object",
      "properties": {
        "projectRoot": {
          "$ref": "#/$defs/AbsPath"
        },
        "outDir": {
          "$ref": "#/$defs/AbsPath"
        },
        "input": {
          "type": "object"
        }
      },
      "required": [
        "projectRoot",
        "outDir",
        "input"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "projectRoot": "/work/lamp",
          "outDir": "/work/lamp/out",
          "input": {
            "parts": [
              "LMP-0003"
            ]
          }
        }
      ]
    },
    "HookResultBase": {
      "type": "object",
      "properties": {
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          }
        },
        "nondeterministic": {
          "type": "boolean"
        },
        "output": {
          "type": "object"
        }
      },
      "required": [
        "coverage",
        "artifacts"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "coverage": {
            "status": "pass"
          },
          "artifacts": [
            {
              "path": "/work/lamp/out/LMP-0003.step",
              "mediaType": "model/step",
              "role": "step",
              "bytes": 48213,
              "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
            }
          ],
          "output": {}
        }
      ]
    },
    "KernelBuildPart": {
      "type": "object",
      "properties": {
        "pn": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{1,31}$"
        },
        "name": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/AbsPath"
        },
        "modelFrame": {
          "type": "string"
        },
        "step": {
          "$ref": "#/$defs/AbsPath"
        },
        "manufactureStep": {
          "$ref": "#/$defs/AbsPath"
        }
      },
      "required": [
        "pn",
        "model",
        "step"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "pn": "LMP-0003",
          "name": "arm link",
          "model": "/work/lamp/hw/parts/LMP-0003/model.py",
          "step": "/work/lamp/out/LMP-0003.step"
        }
      ]
    },
    "KernelBuildParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "KernelBuildPartResult": {
      "type": "object",
      "properties": {
        "pn": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{1,31}$"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "error": {
          "type": "string"
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "pn",
        "status"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "pn": "LMP-0003",
          "status": "pass",
          "seconds": 1.8
        },
        {
          "pn": "LMP-0004",
          "status": "fail",
          "error": "fillet failed"
        }
      ]
    },
    "KernelBuildResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "KernelExportParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "KernelExportResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "KernelInspectParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "KernelInspectResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "CadAppDrawingParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "CadAppDrawingResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "CadAppAssemblyParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "CadAppAssemblyResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "CadAppFemParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "CadAppFemResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "CadAppUnfoldParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "CadAppUnfoldResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "SolverSolveParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "SolverSolveResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "CollisionCheckParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "CollisionCheckResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "CollisionSweepParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "CollisionSweepResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "RendererRenderParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "RendererRenderResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "RendererSnapshotParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "RendererSnapshotResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "ViewerShowParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "ViewerShowResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "ViewerCompareParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "ViewerCompareResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "ViewerCaptureParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "ViewerCaptureResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "ProcessCheckCheckParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "ProcessCheckCheckResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "StorePutParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "StorePutResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "StoreGetParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "StoreGetResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "StoreListParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "StoreListResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "PolicyEvaluateParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "PolicyEvaluateResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "CliRunParams": {
      "$ref": "#/$defs/HookParamsBase"
    },
    "CliRunResult": {
      "$ref": "#/$defs/HookResultBase"
    },
    "Method": {
      "enum": [
        "initialize",
        "initialized",
        "shutdown",
        "exit",
        "$/cancelRequest",
        "$/progress",
        "$/log",
        "kernel/build",
        "kernel/export",
        "kernel/inspect",
        "cad-app/drawing",
        "cad-app/assembly",
        "cad-app/fem",
        "cad-app/unfold",
        "solver/solve",
        "collision/check",
        "collision/sweep",
        "renderer/render",
        "renderer/snapshot",
        "viewer/show",
        "viewer/compare",
        "viewer/capture",
        "process-check/check",
        "store/put",
        "store/get",
        "store/list",
        "policy/evaluate",
        "cli/run"
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "kernel/build",
          "params": {
            "projectRoot": "/work/lamp",
            "outDir": "/work/lamp/out",
            "input": {}
          }
        }
      ]
    },
    "Notification": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "jsonrpc": "2.0",
          "method": "$/cancelRequest",
          "params": {
            "id": 7
          }
        }
      ]
    },
    "SuccessResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": 7,
          "result": {
            "coverage": {
              "status": "pass"
            },
            "artifacts": []
          }
        }
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/ErrorObject"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "jsonrpc": "2.0",
          "id": null,
          "error": {
            "code": -32700,
            "message": "invalid JSON",
            "data": {
              "code": "parse-error"
            }
          }
        }
      ]
    },
    "ErrorCodes": {
      "description": "Numeric code for each data.code.",
      "const": {
        "parse-error": -32700,
        "invalid-request": -32600,
        "method-not-found": -32601,
        "invalid-params": -32602,
        "internal-error": -32603,
