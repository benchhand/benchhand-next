{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/flow/flow.schema.json",
  "title": "benchhand flow definition (flow.yaml), provisional",
  "description": "Provisional: the flow definition, flow.yaml (ADR-0014). The stage and gate graph is data, and every condition in it is a CEL expression: the edge guards, the gate requirements and the VOID cascade scope. The rule lists are files of their own (flow/rules.schema.json), and rules names them by kind. A gate of kind single-human advances its edge when the user approves it; a gate of kind provisional+full+human advances its edge at the provisional gate, and its human gate opens after the full check. The schema checks the shape of one file: every stage of the record's stage enum, once, with at least one gate and one edge. The flow loader checks what refers across the file when it loads it: it refuses a duplicate YAML key, two gates with the same id, an edge that names a gate the file doesn't declare, a standalone CEL expression that doesn't compile or type-check, and a fidelity rule list with a choice that gives \"none\", the no-match value only a contributed list gives",
  "x-status": "provisional",
  "x-version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "flow_version",
    "stages",
    "gates",
    "edges",
    "rules",
    "void_scope"
  ],
  "properties": {
    "flow_version": {
      "const": 1
    },
    "stages": {
      "$ref": "#/$defs/FlowStages"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/FlowGate"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/FlowEdge"
      }
    },
    "rules": {
      "description": "The rule-list files, by kind, each relative to flow.yaml",
      "$ref": "rules.schema.json#/$defs/FlowRuleLists"
    },
    "void_scope": {
      "description": "Selects the stages a VOID reopens besides the voided stage, evaluated for each stage after it",
      "$ref": "../common/cel.schema.json#/$defs/CelExpression"
    },
    "reapproval_scope": {
      "description": "Provisional (ADR-0019, owned by Phase 2): selects the approved items a change affects, next to void_scope. An affected item whose fingerprint differs from its approval is changed_since_approval",
      "x-status": "provisional",
      "$ref": "../common/cel.schema.json#/$defs/CelExpression"
    }
  },
  "examples": [
    {
      "flow_version": 1,
      "stages": {
        "ground": {
          "guides": {
            "lead": "guides/ground.md"
          }
        },
        "intent": {
          "guides": {
            "lead": "guides/intent.md"
          }
        },
        "specify": {
          "guides": {
            "lead": "guides/specify.md"
          }
        },
        "concept": {
          "guides": {
            "lead": "guides/concept.md"
          }
        },
        "layout": {
          "guides": {
            "lead": "guides/layout.md"
          }
        },
        "parts": {
          "guides": {
            "lead": "guides/parts.md",
            "cad-part-designer": "guides/parts.md#part-designer"
          }
        },
        "detail": {
          "guides": {
            "lead": "guides/detail.md"
          }
        },
        "bom": {
          "guides": {
            "lead": "guides/bom.md"
          }
        },
        "analysis": {
          "guides": {
            "lead": "guides/analysis.md"
          }
        },
        "critique": {
          "guides": {
            "lead": "guides/critique.md"
          }
        },
        "reconcile": {
          "guides": {
            "lead": "guides/reconcile.md"
          }
        },
        "design_freeze": {
          "guides": {
            "lead": "guides/design-freeze.md"
          }
        },
        "release": {
          "guides": {
            "lead": "guides/release.md"
          }
        }
      },
      "gates": [
        {
          "id": "layout_freeze",
          "stage": "layout",
          "kind": "provisional+full+human",
          "requires": {
            "provisional": [
              "version.fast_checks.all(c, c.status == \"pass\")"
            ],
            "full": [
              "full_check.status == \"pass\""
            ],
            "human": [
              "full_check.status == \"pass\" && prev_human_gate.approved && (policy.mode == \"auto\" || answer.present)",
              "approvals.all(i, i.status != \"changed_since_approval\" || answer.confirms(i))"
            ]
          }
        }
      ],
      "edges": [
        {
          "from": "layout",
          "to": "parts",
          "gate": "layout_freeze"
        }
      ],
      "void_scope": "stage.index > voided.stage.index && stage.built_on == voided.version",
      "reapproval_scope": "change.items.exists(c, c.kind == item.kind && c.id == item.id)",
      "rules": {
        "checks_by_iteration": {
          "file": "checks-by-iteration.celpolicy",
          "rules_version": 1
        },
        "dispatch": {
          "file": "dispatch.celpolicy",
          "rules_version": 1
        },
        "fidelity": {
          "file": "fidelity.celpolicy",
          "rules_version": 1
        },
        "rigor": {
          "file": "rigor.celpolicy",
          "rules_version": 1
        }
      }
    }
  ],
  "$defs": {
    "FlowStages": {
      "description": "Every stage of the record's stage enum (record/common.schema.json#/$defs/stage), by its id, each once. The order of the stages is the enum's, and the graph is the edges; the order of the keys means nothing",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ground",
        "intent",
        "specify",
        "concept",
        "layout",
        "parts",
        "detail",
        "bom",
        "analysis",
        "critique",
        "reconcile",
        "design_freeze",
        "release"
      ],
      "properties": {
        "ground": {
          "$ref": "#/$defs/FlowStage"
        },
        "intent": {
          "$ref": "#/$defs/FlowStage"
        },
        "specify": {
          "$ref": "#/$defs/FlowStage"
        },
        "concept": {
          "$ref": "#/$defs/FlowStage"
        },
        "layout": {
          "$ref": "#/$defs/FlowStage"
        },
        "parts": {
          "$ref": "#/$defs/FlowStage"
        },
        "detail": {
          "$ref": "#/$defs/FlowStage"
        },
        "bom": {
          "$ref": "#/$defs/FlowStage"
        },
        "analysis": {
          "$ref": "#/$defs/FlowStage"
        },
        "critique": {
          "$ref": "#/$defs/FlowStage"
        },
        "reconcile": {
          "$ref": "#/$defs/FlowStage"
        },
        "design_freeze": {
          "$ref": "#/$defs/FlowStage"
        },
        "release": {
          "$ref": "#/$defs/FlowStage"
        }
      }
    },
    "FlowStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guides"
      ],
      "properties": {
        "guides": {
          "$ref": "#/$defs/FlowGuides"
        }
      }
    },
    "FlowGuides": {
      "description": "The guide fragment for each role at this stage, by role: lead is the lead agent, any other key an agent profile such as cad-part-designer. flow.guide returns a role's own fragment, else the lead's",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/FlowGuideFragment"
      },
      "required": [
        "lead"
      ],
      "properties": {
        "lead": {
          "$ref": "#/$defs/FlowGuideFragment"
        }
      }
    },
    "FlowGuideFragment": {
      "description": "A Markdown file under guides/, relative to flow.yaml, with an optional heading anchor",
      "type": "string",
      "pattern": "^guides/[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*\\.md(#[a-z0-9][a-z0-9-]*)?$"
    },
    "FlowGate": {
      "oneOf": [
        {
          "$ref": "#/$defs/FlowSingleHumanGate"
        },
        {
          "$ref": "#/$defs/FlowStagedGate"
        }
      ]
    },
    "FlowSingleHumanGate": {
      "description": "A gate the user approves in one step. Each requirement must hold",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "kind",
        "requires"
      ],
      "properties": {
        "id": {
          "$ref": "../record/common.schema.json#/$defs/gate_id"
        },
        "stage": {
          "description": "The stage the gate closes",
          "$ref": "../record/common.schema.json#/$defs/stage"
        },
        "kind": {
          "const": "single-human"
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "human"
          ],
          "properties": {
            "human": {
              "$ref": "../common/cel.schema.json#/$defs/CelExpressions"
            }
          }
        }
      }
    },
    "FlowStagedGate": {
      "description": "A gate that approves a built version in three steps: the provisional gate after the fast checks, the full check on the same version, then the human gate. Each step's requirements must hold",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "kind",
        "requires"
      ],
      "properties": {
        "id": {
          "$ref": "../record/common.schema.json#/$defs/gate_id"
        },
        "stage": {
          "description": "The stage the gate closes",
          "$ref": "../record/common.schema.json#/$defs/stage"
        },
        "kind": {
          "const": "provisional+full+human"
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provisional",
            "full",
            "human"
          ],
          "properties": {
            "provisional": {
              "$ref": "../common/cel.schema.json#/$defs/CelExpressions"
            },
            "full": {
              "description": "When the full check counts as done",
              "$ref": "../common/cel.schema.json#/$defs/CelExpressions"
            },
            "human": {
              "$ref": "../common/cel.schema.json#/$defs/CelExpressions"
            }
          }
        }
      }
    },
    "FlowEdge": {
      "description": "A transition between two stages. gate names the gate it passes through; guard must also hold",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "../record/common.schema.json#/$defs/stage"
        },
        "to": {
          "$ref": "../record/common.schema.json#/$defs/stage"
        },
        "gate": {
          "$ref": "../record/common.schema.json#/$defs/gate_id"
        },
        "guard": {
          "$ref": "../common/cel.schema.json#/$defs/CelExpression"
        }
      }
    },
    "GateDecisionRequest": {
      "description": "What the flow engine takes to record a human-gate decision, from the gate card (app) or from the user's reply in chat. status approved passes the gate. status void withdraws the gate's provisional approval because of a change the user named at the human gate, so it needs a human channel (app or chat) and cites that provisional decision; the VOID the interpreter records itself, after a failing full check or a MAJOR light-review finding, doesn't go through this request. provisional cites the provisional decision of a provisional+full+human gate. Every channel but auto names who decided and quotes their words, and each has at least one character that isn't whitespace (NonblankText): an empty answer is no answer, and a blank name is nobody. form is refused: form elicitation is not used (ADR-0018)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "channel"
      ],
      "properties": {
        "gate": {
          "$ref": "../record/common.schema.json#/$defs/gate_id"
        },
        "status": {
          "$ref": "#/$defs/GateDecisionStatus"
        },
        "version": {
          "description": "The built version the decision is on",
          "$ref": "../record/common.schema.json#/$defs/version"
        },
        "channel": {
          "$ref": "../record/decision.schema.json#/$defs/approval/properties/channel",
          "not": {
            "const": "form"
          }
        },
        "by": {
          "description": "Who decided",
          "$ref": "#/$defs/NonblankText"
        },
        "quote": {
          "description": "The user's words, quoted",
          "$ref": "#/$defs/NonblankText"
        },
        "provisional": {
          "$ref": "../record/common.schema.json#/$defs/decision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": "auto"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "quote"
              ]
            }
          },
          "else": {
            "required": [
              "by",
              "quote"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "void"
              }
            }
          },
          "then": {
            "required": [
              "provisional"
            ],
            "properties": {
              "channel": {
                "enum": [
                  "app",
                  "chat"
                ]
              }
            }
          }
        }
      ],
      "examples": [
        {
          "gate": "layout_freeze",
          "status": "approved",
          "version": "v3",
          "channel": "chat",
          "by": "the user",
          "quote": "Yes, freeze the layout.",
          "provisional": "DR-012"
        },
        {
          "gate": "intent",
          "status": "approved",
          "channel": "auto"
        },
        {
          "gate": "layout_freeze",
          "status": "void",
          "version": "v3",
          "channel": "chat",
          "by": "the user",
          "quote": "The arm needs 20 mm more reach; don't freeze this.",
          "provisional": "DR-012"
        }
      ]
    },
    "NonblankText": {
      "description": "Text with at least one character that isn't whitespace. Whitespace is ECMAScript's whitespace class (Unicode's White_Space but U+0085 NEXT LINE, so every Zs character, and U+FEFF), U+0085 itself, and U+001C to U+001F, which Python's str.isspace also counts",
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\s\\u001c-\\u001f\\u0085]"
    },
    "ApprovalScope": {
      "description": "Provisional (ADR-0019, owned by Phase 2): the items a human-gate approval covers, each with its fingerprint at approval time, computed the way the evidence service fingerprints its inputs. The decision contract refers to it once Phase 2 adds it there",
      "x-status": "provisional",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ApprovedItem"
          }
        }
      },
      "examples": [
        {
          "items": [
            {
              "kind": "interface",
              "id": "IF-001",
              "fingerprint": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
            },
            {
              "kind": "part",
              "id": "LMP-0003",
              "fingerprint": "60303ae22b998861bce3b28f33eec1be758a213c86c93c076dbe9f558c11c752"
            }
          ]
        }
      ]
    },
    "ApprovedItem": {
      "description": "Provisional (ADR-0019): one approved item",
      "x-status": "provisional",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "fingerprint"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ApprovedItemKind"
        },
        "id": {
          "description": "The item's id in the record, such as an interface id or a PN",
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "../record/common.schema.json#/$defs/sha256"
        }
      }
    },
    "GateDecisionStatus": {
      "enum": [
        "approved",
        "void"
      ]
    },
    "ApprovedItemStatus": {
      "enum": [
        "approved",
        "changed_since_approval"
      ]
    },
    "ApprovedItemKind": {
      "enum": [
        "concept",
        "envelope",
        "interface",
        "joint",
        "part"
      ]
    },
    "ApprovedItemState": {
      "description": "Provisional (ADR-0019): an approved item now. approved: its fingerprint is the one recorded at approval; changed_since_approval: it differs, and the next human gate shows the item with a diff and confirms it. The stage stays where it is",
      "x-status": "provisional",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "decision",
        "status",
        "fingerprint"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ApprovedItemKind"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "description": "The decision that approved it",
          "$ref": "../record/common.schema.json#/$defs/decision"
        },
        "status": {
          "$ref": "#/$defs/ApprovedItemStatus"
        },
        "fingerprint": {
          "description": "The item's fingerprint now",
          "$ref": "../record/common.schema.json#/$defs/sha256"
        }
      },
      "examples": [
        {
          "kind": "interface",
          "id": "IF-001",
          "decision": "DR-013",
          "status": "changed_since_approval",
          "fingerprint": "fd61a03af4f77d870fc21e05e7e80678095c92d808cfb3b5c279ee04c74aca13"
        }
      ]
    }
  }
}
