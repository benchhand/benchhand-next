{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/part.schema.json",
  "title": "benchhand part record (hw/parts/<PN>/part.yaml)",
  "x-version": "1.0.0",
  "type": "object",
  "properties": {
    "PN": {
      "$ref": "common.schema.json#/$defs/pn"
    },
    "rev": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "material": {
      "type": "string",
      "minLength": 1,
      "description": "A declaration of the part's material, kept for BOM and drawings; it is not a sourced grade or property. intent.material_profile names the qualified profile"
    },
    "process": {
      "$ref": "common.schema.json#/$defs/primary_process",
      "description": "The scalar label of the primary process; intent.route is the authority for the operations"
    },
    "finish": {
      "type": "string",
      "minLength": 1
    },
    "mass_target": {
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "description": "grams",
      "x-plausible": {
        "max": 50000
      },
      "type": [
        "number",
        "null"
      ]
    },
    "make_buy": {
      "type": "string",
      "enum": [
        "make",
        "buy"
      ]
    },
    "supplier": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/decision"
      },
      "uniqueItems": true
    },
    "model_frame": {
      "description": "Frame of model.py's geometry: assembly_zero (default) is assembly coordinates at the zero joint pose, one identity-placed occurrence only; part_local is the definition's own origin and axes, placed by each occurrence",
      "type": "string",
      "enum": [
        "assembly_zero",
        "part_local"
      ]
    },
    "form_class": {
      "description": "The part's form type for the form check; absent means solid, and only a solid part is judged block_like",
      "type": "string",
      "enum": [
        "solid",
        "frame",
        "plate",
        "skeleton",
        "shell"
      ]
    },
    "transparency": {
      "type": "string",
      "enum": [
        "opaque",
        "translucent",
        "transparent"
      ],
      "description": "How much light the part passes; absent means opaque. Only a transparent part is see-through to the visibility check. An optical requirement is a hard selection constraint met by a purchased transparent part or identified transparent stock on a suitable route, never by an opaque process"
    },
    "procurement": {
      "$ref": "drawing.schema.json#/$defs/procurement"
    },
    "drawing": {
      "$ref": "drawing.schema.json#/$defs/part_drawing"
    },
    "manufacture": {
      "type": "object",
      "properties": {
        "relationship": {
          "description": "same: made in its installed shape; different: model.py build_manufacture(params) defines the manufacturing state",
          "enum": [
            "same",
            "different"
          ]
        },
        "state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "name of the manufacturing state, such as flat"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "why the states differ, such as elastic_bending"
        },
        "decision": {
          "$ref": "common.schema.json#/$defs/decision",
          "description": "the decision record approving the difference"
        },
        "volume_rel_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.1,
          "description": "allowed |V_manufactured - V_installed| / V_installed",
          "x-plausible": {
            "max": 0.01
          }
        },
        "volume_abs_tolerance_mm3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "absolute floor of the allowed volume difference",
          "x-plausible": {
            "max": 10
          }
        },
        "mesh": {
          "type": "object",
          "properties": {
            "linear_deflection_mm": {
              "type": "number",
              "default": 0.05,
              "minimum": 0.001,
              "maximum": 1,
              "x-plausible": {
                "min": 0.01,
                "max": 0.2
              }
            },
            "angular_deflection_rad": {
              "type": "number",
              "default": 0.1,
              "exclusiveMinimum": 0,
              "maximum": 3.141592653589793,
              "x-plausible": {
                "min": 0.05,
                "max": 0.5
              }
            }
          },
          "additionalProperties": false,
          "description": "FDM part.stl tessellation, overriding the layout default (0.05 mm, 0.1 rad)",
          "minProperties": 1
        }
      },
      "required": [
        "relationship"
      ],
      "additionalProperties": false,
      "description": "How a custom-made part is manufactured relative to its installed definition. Absent: relationship same, compared to 1e-9 relative volume, default mesh.",
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "state"
              ]
            },
            {
              "required": [
                "reason"
              ]
            },
            {
              "required": [
                "decision"
              ]
            },
            {
              "required": [
                "volume_rel_tolerance"
              ]
            },
            {
              "required": [
                "volume_abs_tolerance_mm3"
              ]
            }
          ]
        }
      },
      "then": {
        "required": [
          "state",
          "reason",
          "decision"
        ],
        "anyOf": [
          {
            "required": [
              "volume_rel_tolerance"
            ]
          },
          {
            "required": [
              "volume_abs_tolerance_mm3"
            ]
          }
        ]
      },
      "if": {
        "properties": {
          "relationship": {
            "const": "different"
          }
        }
      }
    },
    "intent": {
      "$ref": "#/$defs/intent"
    }
  },
  "required": [
    "PN",
    "rev",
    "title",
    "material",
    "process",
    "finish",
    "mass_target",
    "make_buy"
  ],
  "additionalProperties": false,
