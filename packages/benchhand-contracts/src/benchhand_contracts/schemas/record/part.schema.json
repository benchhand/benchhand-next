  "$defs": {
    "intent": {
      "description": "Record version 2 manufacturing intent: what the part does, the qualified material profile, the service it sees, its critical surfaces and its complete ordered route. make_buy and procurement.mode stay the sourcing authority; manufacture stays the manufacturing-state authority. A sole solid is the implicit main component; a part with several solids lists components",
      "type": "object",
      "properties": {
        "functions": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/function_entry"
              },
              "minItems": 1
            },
            {
              "$ref": "common.schema.json#/$defs/fact_unknown"
            }
          ]
        },
        "material_profile": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/profile_id"
            },
            {
              "$ref": "common.schema.json#/$defs/fact_open"
            }
          ],
          "description": "a profile id in manufacturing/materials.yaml"
        },
        "color": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "The part's print colour as an sRGB hex string #RRGGBB (for example #FF8000 for orange). 3MF export uses it as the part's display colour"
        },
        "selection": {
          "$ref": "common.schema.json#/$defs/semantic_id",
          "description": "the selection.yaml candidate this intent implements"
        },
        "service": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "requirements": {
                  "$ref": "common.schema.json#/$defs/requirement_ids"
                },
                "loads": {
                  "$ref": "common.schema.json#/$defs/semantic_ids",
                  "description": "product.yaml use_case.loads ids"
                },
                "environment": {
                  "$ref": "common.schema.json#/$defs/text"
                },
                "duty": {
                  "$ref": "common.schema.json#/$defs/text"
                },
                "life": {
                  "$ref": "common.schema.json#/$defs/quantity_fact"
                },
                "differences": {
                  "$ref": "common.schema.json#/$defs/text",
                  "description": "where this part's service differs from the product use case"
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            },
            {
              "$ref": "common.schema.json#/$defs/fact_open"
            }
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          },
          "minItems": 1
        },
        "critical_surfaces": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/critical_surface"
              },
              "minItems": 1
            },
            {
              "$ref": "common.schema.json#/$defs/fact_open"
            }
          ]
        },
        "route": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/operation"
              },
              "minItems": 1
            },
            {
              "$ref": "common.schema.json#/$defs/fact_unknown"
            }
          ]
        },
        "rationale": {
          "type": "object",
          "properties": {
            "decision": {
              "$ref": "common.schema.json#/$defs/decision"
            },
            "selection": {
              "$ref": "common.schema.json#/$defs/semantic_id"
            },
            "alternatives": {
              "$ref": "common.schema.json#/$defs/texts"
            },
            "tradeoffs": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "functions",
        "material_profile",
        "service",
        "critical_surfaces",
        "route"
      ],
      "additionalProperties": false
    },
    "component": {
      "description": "One disconnected solid of the part, bound by an interior witness point in the native manufacturing frame (mm) or a semantic locator; every solid binds exactly once. Equivalent members list their multiplicity",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "witness": {
          "$ref": "common.schema.json#/$defs/vector"
        },
        "locator": {
          "$ref": "common.schema.json#/$defs/target"
        },
        "material_profile": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/profile_id"
            },
            {
              "$ref": "common.schema.json#/$defs/fact_open"
            }
          ]
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/function_entry"
          },
          "minItems": 1
        },
        "multiplicity": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "witness"
          ]
        },
        {
          "required": [
            "locator"
          ]
        }
      ]
    },
    "critical_surface": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "feature": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "region": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "component": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "role": {
          "enum": [
            "datum",
            "bore",
            "seat",
            "journal",
            "running",
            "sliding",
            "flank",
            "cam",
            "seal",
            "fastener",
            "locating",
            "optical",
            "other"
          ]
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/interface_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "requirements": {
          "$ref": "common.schema.json#/$defs/requirement_ids"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/criterion"
          },
          "minItems": 1
        },
        "finish": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "inspection": {
          "$ref": "common.schema.json#/$defs/semantic_id",
          "description": "the route inspection id that verifies it"
        },
        "dimension_state": {
          "$ref": "common.schema.json#/$defs/dimension_state"
        }
      },
      "required": [
        "id",
        "feature",
        "role",
        "dimension_state"
      ],
      "additionalProperties": false
    },
    "operation": {
      "description": "One route operation, in route order: the previous operation is its predecessor unless depends_on names the true dependencies. A made operation names its capability profile or why it is unknown; a purchase names its identity, specification and ratings",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/route_kind"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "capability": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/profile_id"
            },
            {
              "$ref": "common.schema.json#/$defs/fact_unknown"
            }
          ]
        },
        "provider": {
          "enum": [
            "local",
            "outsourced"
          ]
        },
        "supplier": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "components": {
          "$ref": "common.schema.json#/$defs/semantic_ids"
        },
        "depends_on": {
          "$ref": "common.schema.json#/$defs/semantic_ids"
        },
        "input_state": {
          "$ref": "common.schema.json#/$defs/semantic_id",
          "description": "stock, or the output_state of an earlier operation"
        },
        "output_state": {
          "$ref": "common.schema.json#/$defs/semantic_id",
          "description": "installed, part.yaml manufacture.state, or an intermediate state"
        },
        "material_state_in": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "material_state_out": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "minItems": 1
        },
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "orientation": {
          "oneOf": [
            {
              "$ref": "#/$defs/orientation"
            },
            {
              "$ref": "common.schema.json#/$defs/fact_open"
            }
          ]
        },
        "supports": {
          "oneOf": [
            {
              "$ref": "#/$defs/supports"
            },
            {
              "$ref": "common.schema.json#/$defs/fact_open"
            }
          ]
        },
        "allowances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/allowance"
          },
          "minItems": 1
        },
        "post_processing": {
          "$ref": "common.schema.json#/$defs/texts"
        },
        "inspection": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inspection"
          },
          "minItems": 1
        },
        "requirements": {
          "$ref": "common.schema.json#/$defs/requirement_ids"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/criterion"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "purchase": {
          "$ref": "#/$defs/purchase"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "else": {
        "required": [
          "capability"
        ],
        "not": {
          "required": [
            "purchase"
          ]
        }
      },
      "then": {
        "required": [
          "purchase"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "capability"
              ]
            },
            {
              "required": [
                "supports"
              ]
            },
            {
              "required": [
                "orientation"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "purchased"
          }
        }
      }
    },
    "purchase": {
      "description": "Traceable purchase criteria: the identity, specification and ratings that make a bought item the right one, never an unidentified description",
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "common.schema.json#/$defs/text_fact",
          "description": "manufacturer and part number, or a standard designation"
        },
        "specification": {
          "$ref": "common.schema.json#/$defs/text_fact",
          "description": "material grade, standard or datasheet the item conforms to"
        },
        "ratings": {
          "$ref": "common.schema.json#/$defs/text_fact",
          "description": "load, speed, temperature or other ratings"
        },
        "optical": {
          "$ref": "common.schema.json#/$defs/text_fact",
          "description": "optical grade and transmission, for a transparent item"
        },
        "thickness": {
          "$ref": "common.schema.json#/$defs/quantity_fact"
        },
        "availability": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "supplier_evidence": {
          "$ref": "common.schema.json#/$defs/sources"
        }
      },
      "required": [
        "identity",
        "specification",
        "ratings"
      ],
      "additionalProperties": false
    },
    "setup": {
      "description": "Stock, datums, workholding and access of one operation. Nothing here is guessed from a bounding box",
      "type": "object",
      "properties": {
        "stock": {
          "type": "object",
          "properties": {
            "material_profile": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/profile_id"
                },
                {
                  "$ref": "common.schema.json#/$defs/fact_open"
                }
              ]
            },
            "grade": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "form": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "dimensions": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "thickness": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "state": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "supplier": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "datums": {
          "$ref": "common.schema.json#/$defs/semantic_ids"
        },
        "workholding": {
          "type": "object",
          "properties": {
            "method": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "contact_regions": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/target"
              },
              "minItems": 1
            },
            "fixture": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "clamping_force": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "allowable_deformation": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            }
          },
          "required": [
            "method"
          ],
          "additionalProperties": false
        },
        "access": {
          "type": "object",
          "properties": {
            "sides": {
              "$ref": "common.schema.json#/$defs/texts"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "description": {
                    "$ref": "common.schema.json#/$defs/text"
                  },
                  "capability": {
                    "$ref": "common.schema.json#/$defs/profile_id"
                  },
                  "diameter": {
                    "$ref": "common.schema.json#/$defs/quantity_fact"
                  },
                  "reach": {
                    "$ref": "common.schema.json#/$defs/quantity_fact"
                  },
                  "holder": {
                    "$ref": "common.schema.json#/$defs/text_fact"
                  }
                },
                "required": [
                  "description"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "inspection_access": {
          "$ref": "common.schema.json#/$defs/text_fact"
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "orientation": {
      "description": "The fixed manufacturing orientation in the native manufacture frame: a proper rotation, as a unit quaternion [w, x, y, z] or an axis and angle. An approved orientation names its decision; an envelope auto-fit is never approved",
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "rotation": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "quaternion": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "quaternion"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "axis": {
                  "$ref": "common.schema.json#/$defs/vector"
                },
                "angle_deg": {
                  "type": "number"
                }
              },
              "required": [
                "axis",
                "angle_deg"
              ],
              "additionalProperties": false
            }
          ]
        },
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "selection": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        }
      },
      "required": [
        "status",
        "rotation"
      ],
      "additionalProperties": false,
      "then": {
        "required": [
          "decision"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      }
    },
    "supports": {
      "description": "Where supports start, touch and come off. reachable_noncritical keeps them on reachable non-critical surfaces; finished_critical names the finishing, allowance and inspection that restore a critical surface. Absent supports are unknown, never none",
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "none",
            "reachable_noncritical",
            "finished_critical"
          ]
        },
        "start_regions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "minItems": 1
        },
        "contact_regions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "minItems": 1
        },
        "material": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "removal": {
          "type": "object",
          "properties": {
            "tools": {
              "$ref": "common.schema.json#/$defs/texts"
            },
            "access": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "path": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "required": [
            "tools",
            "access"
          ],
          "additionalProperties": false
        },
        "affected_surfaces": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/target"
          },
          "minItems": 1
        },
        "allowance": {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        "finish": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "inspection": {
          "$ref": "common.schema.json#/$defs/semantic_ids"
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "reachable_noncritical"
              }
            }
          },
          "then": {
            "required": [
              "contact_regions",
              "removal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "finished_critical"
              }
            }
          },
          "then": {
            "required": [
              "contact_regions",
              "removal",
              "allowance",
              "finish",
              "inspection"
            ]
          }
        }
      ]
    },
    "allowance": {
      "type": "object",
      "properties": {
        "feature": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "region": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "dimension": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "amount": {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        "purpose": {
          "enum": [
            "stock",
            "finish",
            "coating",
            "support_removal",
            "shrinkage",
            "other"
          ]
        },
        "limits": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        }
      },
      "required": [
        "feature",
        "amount",
        "purpose",
        "source"
      ],
      "additionalProperties": false
    },
    "inspection": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "feature": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "region": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "requirement": {
          "$ref": "common.schema.json#/$defs/requirement_id"
        },
        "criterion": {
          "$ref": "common.schema.json#/$defs/criterion"
        },
        "method": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "instrument": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "capability": {
          "$ref": "common.schema.json#/$defs/profile_id"
        },
        "state": {
          "$ref": "common.schema.json#/$defs/dimension_state"
        },
        "coupon": {
          "type": "boolean",
          "description": "true when a representative coupon or test piece is the inspected item"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence_id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "method",
        "state"
      ],
      "additionalProperties": false
    }
  }
}
