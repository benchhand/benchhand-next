{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/bom-row.schema.json",
  "title": "benchhand EBOM row (hw/bom.csv)",
  "description": "One hw/bom.csv row. The column order is the property order: the required columns, then optionally all seven procurement columns together. An empty cell is null, so a text value is never empty",
  "x-version": "1.0.0",
  "type": "object",
  "properties": {
    "level": {
      "type": "integer",
      "minimum": 0
    },
    "PN": {
      "$ref": "common.schema.json#/$defs/pn"
    },
    "rev": {
      "pattern": "^(X[1-9][0-9]*|[A-HJ-NPRTUVWY])$",
      "type": [
        "string",
        "null"
      ]
    },
    "qty": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "material": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "process": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/primary_process"
        },
        {
          "type": "null"
        }
      ]
    },
    "make_buy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "make",
        "buy",
        null
      ]
    },
    "supplier": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "mass": {
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "description": "grams, copied from the part mass_target",
      "x-plausible": {
        "max": 50000
      },
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "description": "what qty counts; the BOM counts STEP instances",
      "enum": [
        "pcs"
      ]
    },
    "designation": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "manufacturer": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "manufacturer_part_number": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "supplier_part_number": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "specification_reference": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "specification_revision": {
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "level",
    "PN",
    "rev",
    "qty",
    "title",
    "material",
    "process",
    "make_buy",
    "supplier",
    "mass"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "unit": [
      "designation",
      "manufacturer",
      "manufacturer_part_number",
      "supplier_part_number",
      "specification_reference",
      "specification_revision"
    ],
    "designation": [
      "unit",
      "manufacturer",
      "manufacturer_part_number",
      "supplier_part_number",
      "specification_reference",
      "specification_revision"
    ],
    "manufacturer": [
      "unit",
      "designation",
      "manufacturer_part_number",
      "supplier_part_number",
      "specification_reference",
      "specification_revision"
    ],
    "manufacturer_part_number": [
      "unit",
      "designation",
      "manufacturer",
      "supplier_part_number",
      "specification_reference",
      "specification_revision"
    ],
    "supplier_part_number": [
      "unit",
      "designation",
      "manufacturer",
      "manufacturer_part_number",
      "specification_reference",
      "specification_revision"
    ],
    "specification_reference": [
      "unit",
      "designation",
      "manufacturer",
      "manufacturer_part_number",
      "supplier_part_number",
      "specification_revision"
    ],
    "specification_revision": [
      "unit",
      "designation",
      "manufacturer",
      "manufacturer_part_number",
      "supplier_part_number",
      "specification_reference"
    ]
  },
  "examples": [
    {
      "level": 1,
      "PN": "LMP-0001",
      "rev": "X1",
      "qty": 1,
      "title": "Base plate and pivot boss",
      "material": "PETG",
      "process": "fdm",
      "make_buy": "make",
      "supplier": null,
      "mass": 313,
      "unit": "pcs",
      "designation": null,
      "manufacturer": null,
      "manufacturer_part_number": null,
      "supplier_part_number": null,
      "specification_reference": null,
      "specification_revision": null
    },
    {
      "level": 1,
      "PN": "LMP-0002",
      "rev": "X1",
      "qty": 1,
      "title": "Lower link",
      "material": "Aluminum 6061-T6",
      "process": "cnc",
      "make_buy": "make",
      "supplier": null,
      "mass": 153,
      "unit": "pcs",
      "designation": null,
      "manufacturer": null,
      "manufacturer_part_number": null,
      "supplier_part_number": null,
      "specification_reference": null,
      "specification_revision": null
    },
    {
      "level": 1,
      "PN": "LMP-0001",
      "rev": "X1",
      "qty": 1,
      "title": "Base plate and pivot boss",
      "material": "PETG",
      "process": "fdm",
      "make_buy": "make",
      "supplier": null,
      "mass": 313
    }
  ]
}
