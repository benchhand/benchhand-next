{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/interfaces.schema.json",
  "title": "benchhand interfaces record (hw/interfaces.yaml)",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interfaces"
  ],
  "properties": {
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "type",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/interface_id"
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "mounting",
              "motion",
              "electrical",
              "thermal",
              "clearance",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "pair": {
            "description": "A clearance requirement's two parts, each a PN placed at most once or an @occurrence reference",
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "assembly.schema.json#/$defs/part_ref"
            }
          },
          "min_clearance_mm": {
            "description": "The smallest distance the pair may come to, at the nominal pose and at every swept pose",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 5,
            "x-plausible": {
              "max": 1
            }
          },
          "margin_mm": {
            "description": "This requirement's margin above min_clearance_mm, overriding product.yaml design.clearance_margin_mm",
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "x-plausible": {
              "max": 0.5
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "press_fit": {
                "$ref": "drawing.schema.json#/$defs/fit"
              },
              "running_fit": {
                "$ref": "drawing.schema.json#/$defs/fit"
              },
              "locating_fit": {
                "$ref": "drawing.schema.json#/$defs/fit"
              },
              "heat_set": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "drawing.schema.json#/$defs/heat_set"
                }
              }
            }
          },
          "functional": {
            "$ref": "#/$defs/functional"
          }
        },
        "dependentRequired": {
          "pair": [
            "min_clearance_mm"
          ],
          "min_clearance_mm": [
            "pair"
          ],
          "margin_mm": [
            "min_clearance_mm"
          ]
        },
        "if": {
          "required": [
            "pair"
          ]
        },
        "then": {
          "properties": {
            "type": {
              "const": "clearance"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "face": {
      "description": "One face of a part, by its semantic feature id",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PN",
        "feature"
      ],
      "properties": {
        "PN": {
          "$ref": "common.schema.json#/$defs/pn"
        },
        "occurrence": {
          "$ref": "common.schema.json#/$defs/occurrence_ref"
        },
        "component": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "feature": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "region": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        }
      }
    },
    "functional": {
      "description": "Record version 2 functional contract of an interface. Desired fit limits (limits), calibrated process precision (capability profiles) and inspected finished dimensions (acceptance) stay three distinct things; no tolerance is inferred from a fit name",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "functions"
      ],
      "properties": {
        "critical": {
          "$ref": "common.schema.json#/$defs/boolean_fact"
        },
        "functions": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/function_entry"
              }
            },
            {
              "$ref": "common.schema.json#/$defs/fact_unknown"
            }
          ]
        },
        "requirements": {
          "$ref": "common.schema.json#/$defs/requirement_ids"
        },
        "failure_consequence": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "loads": {
          "description": "product.yaml use_case.loads ids",
          "$ref": "common.schema.json#/$defs/semantic_ids"
        },
        "environment": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "PN",
              "feature",
              "role",
              "dimension_state"
            ],
            "properties": {
              "PN": {
                "$ref": "common.schema.json#/$defs/pn"
              },
              "occurrence": {
                "$ref": "common.schema.json#/$defs/occurrence_ref"
              },
              "component": {
                "$ref": "common.schema.json#/$defs/semantic_id"
              },
              "feature": {
                "$ref": "common.schema.json#/$defs/semantic_id"
              },
              "region": {
                "$ref": "common.schema.json#/$defs/semantic_id"
              },
              "role": {
                "enum": [
                  "datum",
                  "bore",
                  "seat",
                  "journal",
                  "running",
                  "sliding",
                  "flank",
                  "cam",
                  "seal",
                  "fastener",
                  "locating",
                  "optical",
                  "other"
                ]
              },
              "datum": {
                "$ref": "drawing.schema.json#/$defs/datum_label"
              },
              "source": {
                "$ref": "common.schema.json#/$defs/source"
              },
              "dimension_state": {
                "$ref": "common.schema.json#/$defs/dimension_state"
              }
            }
          }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "verification"
            ],
            "properties": {
              "criterion": {
                "$ref": "common.schema.json#/$defs/criterion"
              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method",
                  "evidence_required",
                  "stage"
                ],
                "properties": {
                  "method": {
                    "enum": [
                      "I",
                      "A",
                      "D",
                      "T"
                    ]
                  },
                  "evidence_required": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "common.schema.json#/$defs/evidence_level"
                    }
                  },
                  "stage": {
                    "$ref": "common.schema.json#/$defs/stage"
                  }
                }
              }
            }
          }
        },
        "variation": {
          "description": "The tolerance stack: its managed analysis case, the contributors it includes and the governing method; RSS needs the decision that justifies its statistical assumptions",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stack_case",
            "contributors",
            "method"
          ],
          "properties": {
            "stack_case": {
              "description": "an hw/analysis/cases/<ID> case id",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "contributors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "manufacture",
                  "assembly",
                  "thermal",
                  "moisture",
                  "wear",
                  "deformation",
                  "coating",
                  "adhesive",
                  "joining"
                ]
              }
            },
            "method": {
              "enum": [
                "worst_case",
                "justified_rss"
              ]
            },
            "decision": {
              "$ref": "common.schema.json#/$defs/decision"
            }
          },
          "if": {
            "properties": {
              "method": {
                "const": "justified_rss"
              }
            }
          },
          "then": {
            "required": [
              "decision"
            ]
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "materials"
          ],
          "properties": {
            "materials": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "$ref": "common.schema.json#/$defs/profile_id"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/fact_open"
                  }
                ]
              }
            },
            "finish": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "lubrication": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "load": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "speed": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "duty": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "life": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/evidence_id"
              }
            }
          }
        },
        "play": {
          "description": "The joint's free movement at this interface: each component the total play about the nominal, centred pose (an interval's upper bound governs the extremes), axial along the joint axis, radial across it, angular as tilt of the axis, backlash along the joint's own coordinate; compliance the elastic displacement under the interface's declared loads (spring preload, operating loads), sourced from a calculation or test, added to the play at the extremes. A component the interface function needs and the record does not declare is unknown, never zero. scenario_cases name the motion cases evaluated under play",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "axial": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "radial": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "angular": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "backlash": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "compliance": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "axial": {
                  "$ref": "common.schema.json#/$defs/quantity_fact"
                },
                "radial": {
                  "$ref": "common.schema.json#/$defs/quantity_fact"
                },
                "angular": {
                  "$ref": "common.schema.json#/$defs/quantity_fact"
                }
              }
            },
            "scenario_cases": {
              "description": "hw/motion/cases/<ID> case ids",
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              }
            }
          }
        },
        "assembly_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/assembly_operation_id"
          }
        },
        "print_in_place": {
          "description": "The joints at this interface that print already assembled: each joint's kind, the joint value it prints at, the face pairs its gap separates and how it breaks free after printing. min_clearance_mm must be at least the governing product.yaml flow.profile processes.fdm.pip_clearance_mm",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "joint",
              "print_pose",
              "gap_features",
              "break_free"
            ],
            "properties": {
              "joint": {
                "enum": [
                  "hinge",
                  "pin",
                  "ball",
                  "captive",
                  "living_hinge"
                ]
              },
              "print_pose": {
                "description": "the value each assembly.yaml joint prints at, in that joint's units",
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^J-[0-9]{3}$"
                },
                "additionalProperties": {
                  "type": "number"
                }
              },
              "gap_features": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "$ref": "#/$defs/face"
                  }
                }
              },
              "break_free": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "method"
                ],
                "properties": {
                  "method": {
                    "$ref": "common.schema.json#/$defs/text"
                  },
                  "force_n": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "inspections": {
          "$ref": "common.schema.json#/$defs/semantic_ids"
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/decision"
          }
        }
      }
    }
  },
  "examples": [
    {
      "interfaces": [
        {
          "id": "IF-001",
          "from": "base_sub",
          "to": "lower_link",
          "type": "motion",
          "description": "Base pivot axis; M5 shoulder pin LMP-0005 pressed into the lower-link hub turns in the LMP-0008 brass bushing heat-set into the base boss, retained by the DIN 471 ring LMP-0011 (occurrence @ring-base) under the bushing's lower end (DR-004).",
          "limits": {
            "rotation_deg": [
              -10,
              80
            ],
            "press_fit": {
              "fit": "5 H7/p6",
              "engagement_length_mm": 20.0,
              "hole": {
                "PN": "LMP-0002",
                "feature": "hub_bore"
              },
              "shaft": {
                "PN": "LMP-0005",
                "feature": "press_band"
              },
              "axial_retainer": {
                "type": "press_fit"
              }
            },
            "running_fit": {
              "fit": "5 f7",
              "hole": {
                "PN": "LMP-0008",
                "feature": "bore"
              },
              "shaft": {
                "PN": "LMP-0005",
                "feature": "journal"
              },
              "note": "pin journal 5 f7 in the SPIROL CL8000 bore 5.05/5.15 (vendor limits, not ISO 286): diametral clearance 0.060/0.172 (cad-fits STK-101, DR-004)"
            },
            "heat_set": [
              {
                "pair": [
                  "LMP-0001",
                  "LMP-0008"
                ],
                "engagement_length_mm": 8.0,
                "hole_diameter_mm": 7.77,
                "hole_deviation_mm": [
                  -0.04,
                  0.04
                ],
                "min_depth_mm": 8.0,
                "insert": "SPIROL CMPL 4 X 8 EK CL8000",
                "source": "https://www.spirol.com/assets/files/cmpl-cl8000-cl8100-specification-flyer-us.pdf",
                "note": "knurl 7.97 nominal in the 7.73/7.81 recommended hole: 0.16/0.24 diametral embedment (STK-102)",
                "feature": "seat"
              }
            ],
            "retaining_ring": {
              "pair": [
                "LMP-0005",
                "@ring-base"
              ],
              "ring": "DIN 471 - 5x0.6",
              "groove_d": "4.8 h10",
              "groove_w": "0.7 H13",
              "source": "https://www.beneri.com/en/prodotto/din-471",
              "feature": "groove"
            }
          },
          "functional": {
            "critical": {
              "status": "unknown",
              "reason": "not recorded before record version 2",
              "question": "Q-023"
            },
            "functions": {
              "status": "unknown",
              "reason": "not recorded before record version 2",
              "question": "Q-023"
            }
          }
        },
        {
          "id": "IF-002",
          "from": "lower_link",
          "to": "upper_link",
          "type": "motion",
          "description": "Elbow hinge axis; M5 shoulder pin LMP-0006 pressed into the lower link's +Y clevis cheek carries the upper-link tongue, retained by the DIN 471 ring LMP-0011 (occurrence @ring-elbow) outside the -Y cheek.",
          "limits": {
            "rotation_deg": [
              -120,
              0
            ],
            "press_fit": {
              "fit": "5 H7/p6",
              "engagement_length_mm": 5.8,
              "hole": {
                "PN": "LMP-0002",
                "feature": "elbow_bore",
                "region": "head_side_cheek"
              },
              "shaft": {
                "PN": "LMP-0006",
                "feature": "press_band"
              },
              "axial_retainer": {
                "type": "press_fit"
              }
            },
            "running_fit": {
              "fit": "5 H8/f7",
              "hole": {
                "PN": "LMP-0003",
                "feature": "elbow_bore"
              },
              "shaft": {
                "PN": "LMP-0006",
                "feature": "journal"
              }
            },
            "locating_fit": {
              "fit": "5 H7/f7",
              "hole": {
                "PN": "LMP-0002",
                "feature": "elbow_bore",
                "region": "far_cheek"
              },
              "shaft": {
                "PN": "LMP-0006",
                "feature": "journal"
              },
              "note": "far-cheek support of the journal, locating clearance 0.010/0.034 (DR-003, DR-004)",
              "axial_retainer": {
                "type": "circlip",
                "parts": [
                  "@ring-elbow"
                ]
              }
            },
            "retaining_ring": {
              "pair": [
                "LMP-0006",
                "@ring-elbow"
              ],
              "ring": "DIN 471 - 5x0.6",
              "groove_d": "4.8 h10",
              "groove_w": "0.7 H13",
              "source": "https://www.beneri.com/en/prodotto/din-471",
              "feature": "groove"
            }
          },
          "functional": {
            "critical": {
              "status": "unknown",
              "reason": "not recorded before record version 2",
              "question": "Q-024"
            },
            "functions": {
              "status": "unknown",
              "reason": "not recorded before record version 2",
              "question": "Q-024"
            }
          }
        }
      ]
    },
    {
      "interfaces": []
    }
  ]
}
