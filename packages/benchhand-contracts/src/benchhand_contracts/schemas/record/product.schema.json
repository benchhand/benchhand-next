{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/product.schema.json",
  "title": "benchhand product record (hw/product.yaml)",
  "x-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "id",
    "units",
    "regime",
    "general_tolerance",
    "flow",
    "use_case"
  ],
  "properties": {
    "record_version": {
      "$ref": "common.schema.json#/$defs/record_version"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "units": {
      "const": "mm"
    },
    "regime": {
      "type": "string",
      "enum": [
        "iso",
        "asme"
      ]
    },
    "general_tolerance": {
      "description": "The general tolerance a drawing states for dimensions without their own: a linear value in mm or a standard label such as ISO 2768-m. A tunable, so it defaults to ISO 2768-m and the user changes it. Unknown, with the open question that would settle it, is also valid; validation refuses a drawing while it is unknown",
      "default": "ISO 2768-m",
      "oneOf": [
        {
          "description": "a linear value in mm",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5,
          "x-plausible": {
            "min": 0.01,
            "max": 0.5
          }
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "common.schema.json#/$defs/fact_unknown"
        }
      ]
    },
    "license": {
      "description": "Explicit SPDX license expressions approved for the product's hardware and documentation, such as CERN-OHL-S-2.0 or (MIT OR Apache-2.0); omitted means not recorded. The expression's shape is meant to be checked (identifiers, LicenseRef-, +, WITH, AND, OR, parentheses) but bundles no SPDX license list, so an unlisted identifier such as CERN-OHL-S passes",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "hardware": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "recheck_from"
      ],
      "properties": {
        "stage": {
          "$ref": "common.schema.json#/$defs/stage"
        },
        "recheck_from": {
          "$ref": "common.schema.json#/$defs/stage"
        },
        "frozen": {
          "$ref": "#/$defs/frozen"
        },
        "change": {
          "$ref": "#/$defs/change"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        }
      },
      "dependentRequired": {
        "change": [
          "frozen"
        ]
      }
    },
    "build_volume": {
      "description": "A printer envelope for the legacy build-volume diagnostic. The sizes are facts about the machine, not tunables, so they have no default: they come from the active capability profile's envelope. Margin is a tunable. Fitting it is not printability; a capability profile's envelope and an approved orientation govern manufacturability",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_mm",
        "y_mm",
        "z_mm"
      ],
      "properties": {
        "x_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "x-plausible": {
            "min": 20,
            "max": 500
          }
        },
        "y_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "x-plausible": {
            "min": 20,
            "max": 500
          }
        },
        "z_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000,
          "x-plausible": {
            "min": 20,
            "max": 500
          }
        },
        "orientations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "xyz",
              "xzy",
              "yxz",
              "yzx",
              "zxy",
              "zyx"
            ]
          }
        },
        "margin_mm": {
          "description": "Unusable rim on each side, in mm; at most half the smallest side, which the config loader checks",
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "default": 0,
          "x-plausible": {
            "max": 20
          }
        }
      }
    },
    "design": {
      "description": "Product-wide design rules",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clearance_margin_mm": {
          "description": "Margin above each clearance requirement's minimum (default 0.1); a distance at or above the minimum but below minimum + margin is a margin warning, never a failure. A clearance interface's margin_mm overrides it",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "x-plausible": {
            "max": 0.5
          }
        }
      }
    },
    "manufacturing": {
      "description": "Product-wide manufacturing plan and rules",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processes": {
          "description": "The processes planned at INTENT, before any part record exists",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/primary_process"
          }
        },
        "min_wall_mm": {
          "description": "Minimum wall per made-part process, overriding the form check's built-in defaults. A diagnostic heuristic, never a calibrated capability",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "fdm": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 25,
              "default": 1.2,
              "x-plausible": {
                "min": 0.4,
                "max": 3
              }
            },
            "cnc": {
              "description": "A fact of the shop, not a tunable, so it has no default: it comes from the CNC capability profile and stays UNKNOWN until one exists",
              "type": "number",
              "minimum": 0.2,
              "maximum": 25,
              "x-plausible": {
                "min": 0.4,
                "max": 3
              }
            }
          }
        }
      }
    },
    "storage": {
      "description": "Repository storage choices the user made",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "results_in_git": {
          "description": "Whether generated results (STEP, GLB, renders, check bundles) are tracked in git; absent means the user has not been asked",
          "type": "boolean"
        }
      }
    },
    "drawing": {
      "$ref": "drawing.schema.json#/$defs/product_drawing"
    },
    "use_case": {
      "$ref": "#/$defs/use_case"
    }
  },
  "$defs": {
    "iso_52900_category": {
      "description": "The ISO/ASTM 52900 additive process category of a flow.profile process, null for a subtractive or forming process",
      "enum": [
        "mex",
        "pbf",
        "vpp",
        "bjt",
        "ded",
        "mjt",
        "shl",
        null
      ]
    },
    "limit": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "enum": [
            "calibrated",
            "off"
          ]
        }
      ]
    },
    "clearance": {
      "oneOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "enum": [
            "calibrated"
          ]
        }
      ]
    },
    "fea": {
      "description": "Whether and how FEA runs, the shape agreed with package A. mode is required when enabled. fast escalates a case to accurate when the fast result lies within fast_band_pct of its criterion limit, |limit - result| / limit x 100 <= fast_band_pct; without fast_band_pct, the analysis uses its measured default band, twice the worst-case bias.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "mode": {
          "type": "string",
          "enum": [
            "fast",
            "accurate"
          ],
          "default": "accurate"
        },
        "fast_band_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "mode"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "mode"
                  ]
                },
                {
                  "required": [
                    "fast_band_pct"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "fast_band_pct"
            ]
          },
          "then": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "fast"
              }
            }
          }
        }
      ]
    },
    "profile": {
      "description": "The user's answers to the project-start questions , recorded at INTENT with the decision that holds them. Each question has a default the user is shown; asked records, per question, whether the user answered (user) or accepted the default (asked-accepted-default). A number is the user's design limit; calibrated stays unknown until a calibration exists; off means not assessed. A two-state answer is a boolean; a word answer is a string, written quoted, since YAML reads a bare on, off, yes or no as a boolean",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fea",
        "stack_up",
        "critique",
        "motion",
        "storage_results_in_git",
        "processes"
      ],
      "properties": {
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "fea": {
          "$ref": "#/$defs/fea"
        },
        "stack_up": {
          "description": "auto turns on when SPECIFY names a critical interface or a stack case",
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto"
        },
        "critique": {
          "description": "light: both reviewers at the L2 light-review scope, rerun on the analysed version",
          "type": "string",
          "enum": [
            "full",
            "light",
            "off"
          ],
          "default": "full"
        },
        "motion": {
          "description": "auto: on once a joint moves; stated to the user, never asked",
          "type": "string",
          "enum": [
            "auto"
          ],
          "default": "auto"
        },
        "storage_results_in_git": {
          "type": "boolean",
          "default": false
        },
        "asked": {
          "description": "How each project-start question was settled, keyed by its field path below flow.profile (fea, stack_up, processes/fdm/orientation, processes/fdm/pip_clearance_mm/xy, ...)",
          "type": "object",
          "additionalProperties": {
            "enum": [
              "user",
              "asked-accepted-default"
            ]
          }
        },
        "processes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fdm": {
              "$ref": "#/$defs/fdm_profile"
            }
          }
        }
      }
    },
    "fdm_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation",
        "supports",
        "overhang_deg",
        "bridge_mm",
        "min_wall_mm",
        "min_feature_mm",
        "warp",
        "cosmetic_faces",
        "print_in_place",
        "pip_clearance_mm"
      ],
      "properties": {
        "orientation": {
          "type": "string",
          "enum": [
            "user",
            "propose"
          ],
          "default": "user"
        },
        "supports": {
          "type": "string",
          "enum": [
            "allowed",
            "free",
            "off"
          ],
          "default": "allowed"
        },
        "overhang_deg": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 90
            },
            {
              "type": "string",
              "enum": [
                "calibrated",
                "off"
              ]
            }
          ],
          "default": "calibrated"
        },
        "bridge_mm": {
          "$ref": "#/$defs/limit",
          "default": "calibrated"
        },
        "min_wall_mm": {
          "$ref": "#/$defs/limit",
          "default": "calibrated"
        },
        "min_feature_mm": {
          "$ref": "#/$defs/limit",
          "default": "calibrated"
        },
        "warp": {
          "type": "string",
          "enum": [
            "calibrated",
            "off"
          ],
          "default": "calibrated"
        },
        "cosmetic_faces": {
          "description": "true adds the critical-surface role cosmetic, which supports may not touch",
          "type": "boolean",
          "default": false
        },
        "print_in_place": {
          "description": "true: offer to print hinges and joints already assembled where that fits; false: assemble them",
          "type": "boolean",
          "default": false
        },
        "pip_clearance_mm": {
          "description": "The smallest print-in-place gap that separates, across the layers (xy) and between layers (z)",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xy",
            "z"
          ],
          "properties": {
            "xy": {
              "$ref": "#/$defs/clearance",
              "default": "calibrated"
            },
            "z": {
              "$ref": "#/$defs/clearance",
              "default": "calibrated"
            }
          }
        }
      }
    },
    "frozen": {
      "description": "The frozen configuration: the built version the design_freeze gate approved, its manifest sha256 and the approving decision. Once set, layout findings stay blocking at every stage. A freeze also anchors evidence_sha256, the canonical digest of its acceptance inventory (verification, evidence and finding dispositions, relied-on bundle manifests and source bytes); a freeze without it is refused by a release until a new freeze records one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "manifest_sha256",
        "decision"
      ],
      "properties": {
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "manifest_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "evidence_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "change": {
      "description": "An approved engineering change against the frozen baseline, while it is open",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "baseline_version",
        "affected_parts"
      ],
      "properties": {
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "baseline_version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "affected_parts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/pn"
          }
        }
      }
    },
    "use_case": {
      "description": "What the product must actually do, recorded before any process or material is chosen. Every field is a fact: known with its sources, unknown with the open question that would answer it, or not applicable. confirmed needs the approving decision; a service class never replaces governing safety or regulatory policy",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "service_class",
        "purpose",
        "users",
        "environment",
        "loads",
        "motion",
        "accuracy",
        "consequences",
        "logistics",
        "capability",
        "release_scope",
        "evidence_policy"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "draft",
            "confirmed"
          ]
        },
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "service_class": {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/fact_known"
                },
                {
                  "properties": {
                    "value": {
                      "$ref": "common.schema.json#/$defs/service_class"
                    }
                  }
                }
              ]
            },
            {
              "$ref": "common.schema.json#/$defs/fact_unknown"
            }
          ]
        },
        "purpose": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "users": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "temperature",
            "heat_sources",
            "moisture",
            "chemicals",
            "uv",
            "corrosion"
          ],
          "properties": {
            "temperature": {
              "description": "the operating temperature range, deg_C",
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "heat_sources": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "moisture": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "chemicals": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "uv": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "corrosion": {
              "$ref": "common.schema.json#/$defs/text_fact"
            }
          }
        },
        "loads": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common.schema.json#/$defs/load"
              }
            },
            {
              "$ref": "common.schema.json#/$defs/fact_open"
            }
          ]
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "speed",
            "range",
            "duty_cycle",
            "friction",
            "wear",
            "service_life"
          ],
          "properties": {
            "speed": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "range": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "duty_cycle": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "friction": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "wear": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "service_life": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            }
          }
        },
        "accuracy": {
          "description": "Required accuracy: these are requirements, never manufacturing capability",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tolerance",
            "repeatability",
            "surface_finish",
            "dimensional_stability"
          ],
          "properties": {
            "tolerance": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "repeatability": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "surface_finish": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "dimensional_stability": {
              "$ref": "common.schema.json#/$defs/text_fact"
            }
          }
        },
        "consequences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failure",
            "severity",
            "forbidden_outcomes",
            "standards",
            "supervision",
            "approval_authority"
          ],
          "properties": {
            "failure": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "severity": {
              "oneOf": [
                {
                  "allOf": [
                    {
                      "$ref": "common.schema.json#/$defs/fact_known"
                    },
                    {
                      "properties": {
                        "value": {
                          "$ref": "common.schema.json#/$defs/consequence_severity"
                        }
                      }
                    }
                  ]
                },
                {
                  "$ref": "common.schema.json#/$defs/fact_unknown"
                }
              ]
            },
            "forbidden_outcomes": {
              "$ref": "common.schema.json#/$defs/texts_fact"
            },
            "standards": {
              "$ref": "common.schema.json#/$defs/texts_fact"
            },
            "supervision": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "approval_authority": {
              "$ref": "common.schema.json#/$defs/text_fact"
            }
          }
        },
        "logistics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "budget",
            "lead_time",
            "maintenance",
            "repair"
          ],
          "properties": {
            "quantity": {
              "description": "how many, in count",
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "budget": {
              "$ref": "common.schema.json#/$defs/money_fact"
            },
            "lead_time": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "maintenance": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "repair": {
              "$ref": "common.schema.json#/$defs/text_fact"
            }
          }
        },
        "capability": {
          "description": "What is available to make it. Availability is not a requirement",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equipment",
            "operator",
            "outsourcing"
          ],
          "properties": {
            "equipment": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "common.schema.json#/$defs/profile_id"
                  }
                },
                {
                  "$ref": "common.schema.json#/$defs/fact_open"
                }
              ]
            },
            "operator": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "outsourcing": {
              "$ref": "common.schema.json#/$defs/text_fact"
            }
          }
        },
        "release_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purpose",
            "operating_limits",
            "exclusions"
          ],
          "properties": {
            "purpose": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "operating_limits": {
              "$ref": "common.schema.json#/$defs/texts_fact"
            },
            "exclusions": {
              "$ref": "common.schema.json#/$defs/texts_fact"
            }
          }
        },
        "evidence_policy": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/fact_unknown"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "obligations",
                "decision"
              ],
              "properties": {
                "obligations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "level"
                    ],
                    "anyOf": [
                      {
                        "required": [
                          "requirement"
                        ]
                      },
                      {
                        "required": [
                          "subject"
                        ]
                      }
                    ],
                    "properties": {
