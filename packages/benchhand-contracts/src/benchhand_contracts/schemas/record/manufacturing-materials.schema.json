{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/manufacturing-materials.schema.json",
  "title": "benchhand material profiles (hw/manufacturing/materials.yaml)",
  "description": "Material identity and properties with their conditions. A family profile (PLA+, nylon, PETG, aluminium) is guidance, never a grade specification; a grade profile names the manufacturer's grade. Printed, moulded, bulk, cast and wrought properties are different profiles; every property states its test standard, temperature, conditioning and, for printed forms, orientation. A typical_not_allowable profile holds only typical or estimated values, never design allowables. Density is never strength. Property names and their dimensions are manufacturing_intent.MATERIAL_PROPERTIES",
  "x-version": "1.0.0",
  "type": "object",
  "properties": {
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "required": [
    "profiles"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "profiles": [
        {
          "id": "petg",
          "revision": 1,
          "title": "PETG, printed (family)",
          "level": "family",
          "family": "PETG",
          "grade": {
            "status": "not_applicable",
            "reason": "family guidance only; no filament grade is selected"
          },
          "form": "printed",
          "process_state": {
            "process": "fdm",
            "conditioning": "unknown",
            "notes": "no filament lot, drying or print orientation is recorded, so no property is stated"
          },
          "typical_not_allowable": true,
          "properties": []
        }
      ]
    }
  ],
  "$defs": {
    "conditioning": {
      "description": "dry as moulded or dried, moisture-conditioned, as received, or not stated",
      "enum": [
        "dry",
        "conditioned",
        "as_received",
        "unknown"
      ]
    },
    "qty_modulus": {
      "description": "Elastic, flexural, shear and creep modulus: above 0 and at most 1200 GPa, diamond's",
      "allOf": [
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "GPa"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": 0,
                "maximum": 1200
              },
              "lower": {
                "exclusiveMinimum": 0,
                "maximum": 1200
              },
              "upper": {
                "exclusiveMinimum": 0,
                "maximum": 1200
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "MPa"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": 0,
                "maximum": 1200000
              },
              "lower": {
                "exclusiveMinimum": 0,
                "maximum": 1200000
              },
              "upper": {
                "exclusiveMinimum": 0,
                "maximum": 1200000
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "bar"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": 0,
                "maximum": 12000000
              },
              "lower": {
                "exclusiveMinimum": 0,
                "maximum": 12000000
              },
              "upper": {
                "exclusiveMinimum": 0,
                "maximum": 12000000
              }
            }
          }
        }
      ]
    },
    "fact_modulus": {
      "then": {
        "properties": {
          "value": {
            "$ref": "#/$defs/qty_modulus"
          }
        }
      },
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "known"
          }
        }
      }
    },
    "qty_density": {
      "description": "Density: above 0 and at most 25 g/cm3; below 0.5 g/cm3 is unusual for a solid",
      "x-plausible": {
        "min": 0.5,
        "units": "g_cm3"
      },
      "allOf": [
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "g_cm3"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": 0,
                "maximum": 25
              },
              "lower": {
                "exclusiveMinimum": 0,
                "maximum": 25
              },
              "upper": {
                "exclusiveMinimum": 0,
                "maximum": 25
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "kg_m3"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": 0,
                "maximum": 25000
              },
              "lower": {
                "exclusiveMinimum": 0,
                "maximum": 25000
              },
              "upper": {
                "exclusiveMinimum": 0,
                "maximum": 25000
              }
            }
          }
        }
      ]
    },
    "fact_density": {
      "then": {
        "properties": {
          "value": {
            "$ref": "#/$defs/qty_density"
          }
        }
      },
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "known"
          }
        }
      }
    },
    "qty_temperature": {
      "description": "A temperature property: above absolute zero and at most 1000 deg_C; above 300 deg_C is unusual for a printed polymer",
      "x-plausible": {
        "max": 300,
        "units": "deg_C"
      },
      "allOf": [
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "deg_C"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": -273.15,
                "maximum": 1000
              },
              "lower": {
                "exclusiveMinimum": -273.15,
                "maximum": 1000
              },
              "upper": {
                "exclusiveMinimum": -273.15,
                "maximum": 1000
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "K"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "exclusiveMinimum": 0,
                "maximum": 1273.15
              },
              "lower": {
                "exclusiveMinimum": 0,
                "maximum": 1273.15
              },
              "upper": {
                "exclusiveMinimum": 0,
                "maximum": 1273.15
              }
            }
          }
        }
      ]
    },
    "fact_temperature": {
      "then": {
        "properties": {
          "value": {
            "$ref": "#/$defs/qty_temperature"
          }
        }
      },
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "known"
          }
        }
      }
    },
    "qty_poisson": {
      "description": "Poisson's ratio: 0 up to, not including, 0.5",
      "x-plausible": {
        "max": 0.45,
        "units": "dimensionless"
      },
      "allOf": [
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "dimensionless"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 0,
                "exclusiveMaximum": 0.5
              },
              "lower": {
                "minimum": 0,
                "exclusiveMaximum": 0.5
              },
              "upper": {
                "minimum": 0,
                "exclusiveMaximum": 0.5
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "percent"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 0,
                "exclusiveMaximum": 50
              },
              "lower": {
                "minimum": 0,
                "exclusiveMaximum": 50
              },
              "upper": {
                "minimum": 0,
                "exclusiveMaximum": 50
              }
            }
          }
        }
      ]
    },
    "fact_poisson": {
      "then": {
        "properties": {
          "value": {
            "$ref": "#/$defs/qty_poisson"
          }
        }
      },
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "known"
          }
        }
      }
    },
    "qty_fu_fy": {
      "description": "The ratio of tensile strength fu to yield strength fy: at least 1, since fu is never below fy. EN 1993-1-1 3.2.2 recommends at least 1.10 for structural steel (clause number from a secondary source; the National Annex may change it)",
      "allOf": [
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "dimensionless"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 1
              },
              "lower": {
                "minimum": 1
              },
              "upper": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "units"
            ],
            "properties": {
              "units": {
                "const": "percent"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "minimum": 100
              },
              "lower": {
                "minimum": 100
              },
              "upper": {
                "minimum": 100
              }
            }
          }
        }
      ]
    },
    "fact_fu_fy": {
      "then": {
        "properties": {
          "value": {
            "$ref": "#/$defs/qty_fu_fy"
          }
        }
      },
      "if": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "const": "known"
          }
        }
      }
    },
    "gauge": {
      "description": "The gauge length the elongation after fracture was measured on. Elongations on different gauges are not comparable: ASME uses k=5, EN uses 5.65*sqrt(S0), ASTM E8 uses 50 mm or 2 in. A missing gauge means the value cannot be compared with a ductility threshold, so a gate treats the material as not shown ductile (unknown). The thresholds are percentages and the value is a ratio, so 14% is 0.14. EN 13445-2:2014 4.1.4 requires at least 14% on 5.65*sqrt(S0) for steels, and EN 1993-1-1 3.2.2 recommends at least 15% with fu/fy of at least 1.10; both clause numbers are from secondary sources and are not checked against the standards",
      "enum": [
        "5.65sqrtS0",
        "5d",
        "A50mm",
        "A2in",
        "other"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/profile_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "level": {
          "enum": [
            "family",
            "grade"
          ]
        },
        "family": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "material_family": {
          "$ref": "#/$defs/scope_fact",
          "description": "the structured family a guideline scope matches on, such as pla, petg, pa or tpu; unknown when not stated. It has no default"
        },
        "filler": {
          "$ref": "#/$defs/scope_fact",
          "description": "the fill a guideline scope matches on, such as cf or gf; not applicable for an unfilled material. It has no default"
        },
        "shore": {
          "$ref": "#/$defs/scope_fact",
          "description": "the Shore hardness a guideline scope matches on, such as 95A or 85A. It has no default"
        },
        "grade": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "manufacturer": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "specification": {
          "$ref": "common.schema.json#/$defs/text_fact",
          "description": "the standard or datasheet designation the grade conforms to"
        },
        "form": {
          "enum": [
            "printed",
            "bulk",
            "wrought",
            "cast",
            "moulded",
            "sheet",
            "rod",
            "film",
            "purchased",
            "unknown"
          ]
        },
        "process_state": {
          "type": "object",
          "properties": {
            "process": {
              "oneOf": [
                {
                  "$ref": "common.schema.json#/$defs/route_kind"
                },
                {
                  "$ref": "common.schema.json#/$defs/fact_open"
                }
              ],
              "description": "the route kind that made the tested material, or unknown"
            },
            "orientation": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "layup": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "temper": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "conditioning": {
              "$ref": "#/$defs/conditioning"
            },
            "lot": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "notes": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "required": [
            "process",
            "conditioning"
          ],
          "additionalProperties": false
        },
        "typical_not_allowable": {
          "type": "boolean"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "guidance": {
          "$ref": "common.schema.json#/$defs/texts",
          "description": "family guidance and cautions, such as fibre fill wear on nozzles and mating surfaces; never a grade allowable"
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        }
      },
      "required": [
        "id",
        "revision",
        "title",
        "level",
        "family",
        "grade",
        "form",
        "process_state",
        "typical_not_allowable",
        "properties"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": "family"
              }
            }
          },
          "then": {
            "properties": {
              "grade": {
                "$ref": "common.schema.json#/$defs/fact_open"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "grade"
              }
            }
          },
          "then": {
            "properties": {
              "grade": {
                "$ref": "common.schema.json#/$defs/fact_known"
              }
            }
          }
        }
      ]
    },
    "scope_fact": {
      "description": "A fact a guideline scope matches on: a known value is lowercase, as scope names are, so 'PLA' is refused",
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "known"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[a-z0-9][a-z0-9_.-]*$"
              }
            }
          }
        }
      ]
    },
    "property": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "value": {
          "$ref": "common.schema.json#/$defs/quantity_fact"
        },
        "conditions": {
          "type": "object",
          "properties": {
            "test_standard": {
              "$ref": "common.schema.json#/$defs/text_fact"
            },
            "temperature": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            },
            "conditioning": {
              "$ref": "#/$defs/conditioning"
            },
            "orientation": {
              "$ref": "common.schema.json#/$defs/text_fact",
              "description": "the print or grain orientation of the specimen"
            },
            "gauge": {
              "$ref": "#/$defs/gauge",
              "description": "allowed on elongation_at_break only; optional"
            },
            "specimen": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "rate": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "notes": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "required": [
            "test_standard",
            "temperature",
            "conditioning"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "value",
        "conditions"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "youngs_modulus",
                  "flexural_modulus",
                  "shear_modulus",
                  "creep_modulus"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/fact_modulus"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "density"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/fact_density"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "heat_deflection_temperature",
                  "vicat_softening_temperature",
                  "glass_transition_temperature",
                  "melting_temperature",
                  "max_service_temperature"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/fact_temperature"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "poisson_ratio"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/fact_poisson"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "fu_fy_ratio"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/fact_fu_fy"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "not": {
                  "const": "elongation_at_break"
                }
              }
            }
          },
          "then": {
            "properties": {
              "conditions": {
                "not": {
                  "required": [
                    "gauge"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
