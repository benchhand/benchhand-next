{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/decision.schema.json",
  "title": "benchhand decision record front matter (hw/decisions/DR-###-<slug>.md)",
  "description": "The YAML front matter between the two --- lines at the top of a decision record; the Markdown body after it is kept verbatim and has no required sections. kind gate records a flow gate state (approved, provisional or void); kind design records a design decision (proposed, accepted, rejected or superseded). A decision cited as the approval of a freeze, an engineering change or the flow profile must be a gate decision with status approved or a design decision with status accepted",
  "x-version": "1.0.0",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/decision"
    },
    "kind": {
      "enum": [
        "gate",
        "design"
      ]
    }
  },
  "required": [
    "id",
    "kind"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/gate_decision"
    },
    {
      "$ref": "#/$defs/design_decision"
    }
  ],
  "examples": [
    {
      "id": "DR-012",
      "kind": "gate",
      "title": "Provisional layout freeze of v3",
      "date": "2026-11-22",
      "status": "provisional",
      "gate": "layout_freeze",
      "stage": "layout",
      "version": "v3",
      "evidence": [
        "hw/checks/v3/assembly/result.json"
      ]
    },
    {
      "id": "DR-013",
      "kind": "gate",
      "title": "Layout freeze of v3",
      "date": "2026-11-23",
      "status": "approved",
      "gate": "layout_freeze",
      "stage": "layout",
      "version": "v3",
      "supersedes": [
        "DR-012"
      ],
      "approval": {
        "channel": "chat",
        "by": "the user",
        "quote": "Yes, freeze the layout."
      }
    },
    {
      "id": "DR-003",
      "kind": "design",
      "title": "Press-fit pivot pins",
      "date": "2026-10-26",
      "status": "superseded",
      "superseded_by": [
        "DR-004"
      ]
    },
    {
      "id": "DR-005",
      "kind": "design",
      "title": "Print the PETG parts in-house on a Bambu Lab H2D",
      "date": "2026-11-18",
      "status": "accepted",
      "decision_makers": [
        "the user"
      ]
    }
  ],
  "$defs": {
    "title": {
      "description": "One line of text",
      "type": "string",
      "pattern": "^[^\\n]*[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff][^\\n]*$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/decision"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/title"
      },
      "minItems": 1
    },
    "approval": {
      "description": "Who approved a gate and through which channel: app (an MCP App), form (a form elicitation), chat (the user's words in the conversation) or auto (the policy mode auto, without a human). Every channel but auto names who approved and quotes their words",
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "app",
            "form",
            "chat",
            "auto"
          ]
        },
        "by": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "quote": {
          "$ref": "common.schema.json#/$defs/text"
        }
      },
      "required": [
        "channel"
      ],
      "additionalProperties": false,
      "else": {
        "required": [
          "by",
          "quote"
        ]
      },
      "then": {
        "not": {
          "required": [
            "quote"
          ]
        }
      },
      "if": {
        "properties": {
          "channel": {
            "const": "auto"
          }
        }
      }
    },
    "gate_decision": {
      "description": "A flow gate state. provisional: the fast checks passed and the flow may build on it until the full check and the human gate; approved: the gate is passed; void: a provisional or approved gate is withdrawn. An approved gate supersedes its provisional one, and a void supersedes what it withdraws. An approved gate carries its approval unless the policy mode of its gate is auto, which validation checks against hw/policy.yaml",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "kind": {
          "const": "gate"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "date": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "status": {
          "enum": [
            "approved",
            "provisional",
            "void"
          ]
        },
        "gate": {
          "$ref": "common.schema.json#/$defs/gate_id"
        },
        "stage": {
          "$ref": "common.schema.json#/$defs/stage",
          "description": "The flow stage the gate belongs to"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version",
          "description": "The built version the gate decided on"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/project_path"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "The result files the gate decided on"
        },
        "supersedes": {
          "$ref": "#/$defs/decisions"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "date",
        "status",
        "gate",
        "stage"
      ],
      "additionalProperties": false,
      "else": {
        "not": {
          "required": [
            "approval"
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        }
      }
    },
    "design_decision": {
      "description": "A design decision. superseded names the decisions that replace it in superseded_by; no other status has superseded_by",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/decision"
        },
        "kind": {
          "const": "design"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "date": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "superseded_by": {
          "$ref": "#/$defs/decisions"
        },
        "decision_makers": {
          "$ref": "#/$defs/people"
        },
        "consulted": {
          "$ref": "#/$defs/people"
        },
        "informed": {
          "$ref": "#/$defs/people"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "date",
        "status"
      ],
      "additionalProperties": false,
      "else": {
        "not": {
          "required": [
            "superseded_by"
          ]
        }
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      },
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      }
    }
  }
}
