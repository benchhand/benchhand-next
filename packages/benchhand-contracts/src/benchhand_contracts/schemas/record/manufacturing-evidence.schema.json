{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/manufacturing-evidence.schema.json",
  "title": "benchhand evidence ledger (hw/manufacturing/evidence.yaml)",
  "description": "Accepted evidence per requirement, part, component, interface or operation, one entry per evidence level: CAD-valid, geometrically manufacturable, process planned, simulation-supported and physically validated are independent facets. A pass or fail cites its artifacts or sealed bundle and the configuration, material, process and conditions it applies to; physically validated evidence also records the specimen, protocol, instrument calibration, results, date, approver and scope. Planned and unknown are never a pass, and waived stays waived",
  "x-version": "1.0.0",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "entries": [
        {
          "id": "EV-001",
          "requirement": "REQ-001",
          "subject": {
            "PN": "TST-0001"
          },
          "level": "physically_validated",
          "result": "pass",
          "method": "coupon load test",
          "criterion": {
            "property": "load",
            "operator": ">=",
            "value": 11,
            "units": "N",
            "source": {
              "kind": "user",
              "reference": "bench test request",
              "origin": "the user"
            }
          },
          "configuration": {
            "version": "v1",
            "manifest_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "rev": "X1"
          },
          "artifacts": [
            {
              "path": "hw/manufacturing/sources/test.csv",
              "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            }
          ],
          "physical": {
            "specimen": "coupon 1",
            "configuration": "v1",
            "material": "TST lot 1",
            "process": "print",
            "protocol": "TST protocol",
            "instrument": "TST scale, calibrated",
            "results": "12 N",
            "date": "2026-01-02",
            "approver": "lead",
            "scope": "coupon only"
          }
        },
        {
          "id": "EV-002",
          "requirement": "REQ-002",
          "subject": {
            "PN": "TST-0001"
          },
          "level": "process_planned",
          "result": "planned",
          "method": "print trial"
        }
      ]
    }
  ],
  "$defs": {
    "fingerprint_domain": {
      "enum": [
        "material",
        "lot",
        "condition",
        "process",
        "route",
        "orientation",
        "setup",
        "capability",
        "finish",
        "load",
        "environment",
        "interface",
        "occurrences",
        "criterion",
        "source",
        "geometry",
        "use_case",
        "appearance"
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/evidence_id"
        },
        "requirement": {
          "$ref": "common.schema.json#/$defs/requirement_id"
        },
        "obligation": {
          "$ref": "common.schema.json#/$defs/obligation_id"
        },
        "subject": {
          "$ref": "common.schema.json#/$defs/subject"
        },
        "level": {
          "$ref": "common.schema.json#/$defs/evidence_level"
        },
        "result": {
          "enum": [
            "unknown",
            "planned",
            "pass",
            "fail",
            "waived"
          ]
        },
        "method": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "criterion": {
          "$ref": "common.schema.json#/$defs/criterion"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        },
        "configuration": {
          "type": "object",
          "properties": {
            "version": {
              "$ref": "common.schema.json#/$defs/version"
            },
            "manifest_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "rev": {
              "$ref": "common.schema.json#/$defs/revision"
            },
            "geometry_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "version",
            "manifest_sha256"
          ],
          "additionalProperties": false
        },
        "fingerprints": {
          "minProperties": 1,
          "description": "sha256 of each normalized dependency the evidence relied on, by domain; a changed fingerprint makes the evidence stale until an impact assessment carries it forward",
          "propertyNames": {
            "$ref": "#/$defs/fingerprint_domain"
          },
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/file_hash"
          },
          "minItems": 1
        },
        "bundle": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "common.schema.json#/$defs/project_path"
            },
            "manifest_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "path",
            "manifest_sha256"
          ],
          "additionalProperties": false
        },
        "tool": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "producer": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "uncertainty": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "coverage": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "physical": {
          "type": "object",
          "properties": {
            "specimen": {
              "$ref": "common.schema.json#/$defs/text",
              "description": "the actual item tested: coupon, part or assembly, with its identity"
            },
            "configuration": {
              "$ref": "common.schema.json#/$defs/text",
              "description": "the as-built configuration and revision"
            },
            "material": {
              "$ref": "common.schema.json#/$defs/text",
              "description": "the material and lot as used"
            },
            "process": {
              "$ref": "common.schema.json#/$defs/text",
              "description": "the route and settings as used"
            },
            "protocol": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "setup": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "instrument": {
              "$ref": "common.schema.json#/$defs/text",
              "description": "the instrument and its calibration"
            },
            "results": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "date": {
              "$ref": "common.schema.json#/$defs/date"
            },
            "approver": {
              "$ref": "common.schema.json#/$defs/text"
            },
            "scope": {
              "$ref": "common.schema.json#/$defs/text",
              "description": "what the result covers: a coupon covers its coupon scope, not assembly or end-use life"
            }
          },
          "required": [
            "specimen",
            "configuration",
            "material",
            "process",
            "protocol",
            "instrument",
            "results",
            "date",
            "approver",
            "scope"
          ],
          "additionalProperties": false
        },
        "waiver": {
          "$ref": "common.schema.json#/$defs/waiver"
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/decision"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "note": {
          "$ref": "common.schema.json#/$defs/text"
        }
      },
      "required": [
        "id",
        "subject",
        "level",
        "result",
        "method"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            }
          },
          "then": {
            "required": [
              "configuration",
              "criterion"
            ],
            "anyOf": [
              {
                "required": [
                  "artifacts"
                ]
              },
              {
                "required": [
                  "bundle"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "level": {
                "const": "physically_validated"
              }
            }
          },
          "then": {
            "required": [
              "physical"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "waived"
              }
            }
          },
          "then": {
            "required": [
              "waiver"
            ]
          },
          "else": {
            "not": {
              "required": [
                "waiver"
              ]
            }
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "requirement"
          ]
        },
        {
          "required": [
            "obligation"
          ]
        }
      ]
    }
  }
}
