{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/requirements.schema.json",
  "title": "benchhand requirements record (hw/requirements.yaml)",
  "description": "Requirements, preferences, assumptions and open questions, kept apart: a mandatory requirement is never downgraded into a preference or an assumption to pass, and an unknown with a filled-in reason is still unknown. Record version 2 carries all four lists; preferences, assumptions and open_questions may be empty.",
  "x-version": "1.0.0",
  "type": "object",
  "properties": {
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/preference_id"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000,
            "x-plausible": {
              "max": 100
            }
          },
          "criterion": {
            "$ref": "common.schema.json#/$defs/criterion"
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/subject"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "text",
          "source",
          "weight"
        ],
        "additionalProperties": false
      },
      "description": "What ranks feasible options; a preference never compensates a mandatory failure"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/assumption_id"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "origin": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "reason": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "bounds": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              {
                "$ref": "common.schema.json#/$defs/text"
              }
            ]
          },
          "requirements": {
            "$ref": "common.schema.json#/$defs/requirement_ids"
          },
          "owner": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "validation": {
            "$ref": "common.schema.json#/$defs/text",
            "description": "the check, test or answer that would confirm or refute it"
          },
          "status": {
            "enum": [
              "open",
              "validated",
              "invalidated"
            ]
          },
          "decision": {
            "$ref": "common.schema.json#/$defs/decision"
          }
        },
        "required": [
          "id",
          "text",
          "origin",
          "reason",
          "owner",
          "validation",
          "status"
        ],
        "additionalProperties": false,
        "then": {
          "required": [
            "decision"
          ]
        },
        "if": {
          "properties": {
            "status": {
              "enum": [
                "validated",
                "invalidated"
              ]
            }
          }
        }
      },
      "description": "Bounded statements taken as true for now, each with its owner and the obligation that would validate it"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/question_id"
          },
          "question": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/subject"
            },
            "minItems": 1
          },
          "owner": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "material_to_choice": {
            "type": "boolean"
          },
          "safety_relevant": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "object",
            "properties": {
              "answer": {
                "$ref": "common.schema.json#/$defs/text"
              },
              "source": {
                "$ref": "common.schema.json#/$defs/source"
              },
              "decision": {
                "$ref": "common.schema.json#/$defs/decision"
              }
            },
            "required": [
              "answer"
            ],
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "source"
                ]
              },
              {
                "required": [
                  "decision"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "question",
          "owner",
          "material_to_choice",
          "safety_relevant",
          "status"
        ],
        "additionalProperties": false,
        "else": {
          "not": {
            "required": [
              "resolution"
            ]
          }
        },
        "then": {
          "required": [
            "resolution"
          ]
        },
        "if": {
          "properties": {
            "status": {
              "const": "resolved"
            }
          }
        }
      },
      "description": "Questions still to answer; material_to_choice or safety_relevant open questions block a final material/process recommendation"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/requirement_id"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "must",
              "should",
              "could",
              "MUST",
              "SHOULD",
              "COULD"
            ]
          },
          "verification": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "I",
                  "A",
                  "D",
                  "T"
                ]
              },
              "criteria": {
                "type": "string",
                "minLength": 1
              },
              "step": {
                "description": "The flow step that verifies it, so validation can flag a profile that turns that step off (flow.conflict): fea for a strength or stiffness requirement, physical for a trial or inspection outside CAD",
                "enum": [
                  "interference",
                  "form",
                  "visibility",
                  "access",
                  "process",
                  "motion",
                  "stack_up",
                  "fea",
                  "drawing",
                  "critique",
                  "physical"
                ]
              }
            },
            "required": [
              "method",
              "criteria"
            ],
            "additionalProperties": false
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/subject"
            },
            "minItems": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/criterion"
            },
            "minItems": 1,
            "description": "Structured acceptance criteria; the prose criteria stay, and a final selection evaluates these, never an automatic reading of prose"
          },
          "conditions": {
            "$ref": "common.schema.json#/$defs/text",
            "description": "the service conditions the requirement holds under"
          },
          "risk": {
            "type": "object",
            "properties": {
              "severity": {
                "$ref": "common.schema.json#/$defs/consequence_severity"
              },
              "consequence": {
                "$ref": "common.schema.json#/$defs/text"
              }
            },
            "required": [
              "severity",
              "consequence"
            ],
            "additionalProperties": false
          },
          "evidence_required": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/evidence_level"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "The evidence levels a pass needs"
          },
          "waiver_policy": {
            "enum": [
              "forbidden",
              "approval_required"
            ]
          },
          "visibility": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "view": {
                  "type": "string",
                  "pattern": "^(?:iso|front|side|dir-[pm](?:0|[1-9][0-9]{0,5})(?:d[0-9]{0,5}[1-9])?-[pm](?:0|[1-9][0-9]{0,5})(?:d[0-9]{0,5}[1-9])?-[pm](?:0|[1-9][0-9]{0,5})(?:d[0-9]{0,5}[1-9])?)$",
                  "description": "A render view: iso, front, side, or a dir-X-Y-Z direction in assembly coordinates",
                  "not": {
                    "description": "a direction needs a non-zero component",
                    "pattern": "^dir-[pm]0-[pm]0-[pm]0$"
                  }
                },
                "window": {
                  "type": "array",
                  "items": {
                    "$ref": "assembly.schema.json#/$defs/part_ref"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "$ref": "assembly.schema.json#/$defs/part_ref"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "min_visible_fraction": {
                  "type": "number",
                  "default": 0.5,
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "view",
                "window",
                "targets"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "description": "Show-the-motion checks: from view, rendering only the window and target parts at the nominal pose, each target's own visible share of its projected area must reach min_visible_fraction (default 0.5); the check fails when any target falls short. Only transparency: transparent window parts are see-through"
          }
        },
        "required": [
          "id",
          "text",
          "rationale",
          "source",
          "priority",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "requirements"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "requirements": [
        {
          "id": "REQ-001",
          "text": "Replace with a measurable product requirement.",
          "rationale": "Explain why this requirement matters.",
          "source": "Project brief or other source",
          "priority": "must",
          "verification": {
            "method": "T",
            "criteria": "Describe the acceptance criteria for verification."
          }
        }
      ],
      "preferences": [],
      "assumptions": [],
      "open_questions": [
        {
          "id": "Q-001",
          "question": "Which service class applies: appearance or concept model, fit or assembly prototype, functional demonstration with limited loads and supervised operation, working prototype, production or end-use product, or safety-critical, regulated or high-consequence application?",
          "subjects": [
            {
              "product": true
            }
          ],
          "owner": "lead",
          "material_to_choice": true,
          "safety_relevant": true,
          "status": "open"
        },
        {
          "id": "Q-002",
          "question": "What must the product do, and who uses it?",
          "subjects": [
            {
              "product": true
            }
          ],
          "owner": "lead",
