{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/drawing.schema.json",
  "title": "Drawing intent definitions shared by the product, part and interface records",
  "x-version": "1.0.0",
  "$defs": {
    "datum_label": {
      "type": "string",
      "pattern": "^[A-HJ-NPR-Z]{1,2}$"
    },
    "reference": {
      "description": "A datum label declared in datum_features, or a semantic feature, anchor or view id",
      "type": "string",
      "pattern": "^([A-HJ-NPR-Z]{1,2}|[a-z][a-z0-9_]*)$"
    },
    "references": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      ]
    },
    "policy_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sheet_size": {
      "type": "string",
      "enum": [
        "A4",
        "A3",
        "A2",
        "A1",
        "A0",
        "ANSI A",
        "ANSI B",
        "ANSI C",
        "ANSI D",
        "ANSI E"
      ]
    },
    "scale": {
      "oneOf": [
        {
          "const": "auto"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        }
      ]
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sheet_size"
          }
        },
        "orientation": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait"
          ]
        },
        "scale": {
          "$ref": "#/$defs/scale"
        },
        "multi_sheet": {
          "type": "boolean"
        }
      }
    },
    "direction": {
      "description": "An axis built from resolved datums or features: normal_to or parallel_to fixes the line, toward or toward_axis its sense",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "normal_to": {
          "$ref": "#/$defs/reference"
        },
        "parallel_to": {
          "$ref": "#/$defs/reference"
        },
        "toward": {
          "$ref": "#/$defs/reference"
        },
        "toward_axis": {
          "$ref": "#/$defs/reference"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "normal_to",
              "parallel_to"
            ]
          },
          {
            "required": [
              "toward",
              "toward_axis"
            ]
          }
        ]
      }
    },
    "tolerance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "$ref": "#/$defs/policy_name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deviation_mm"
          ],
          "properties": {
            "deviation_mm": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -10,
                "maximum": 10
              },
              "x-plausible": {
                "min": -1,
                "max": 1
              }
            }
          }
        }
      ]
    },
    "tolerance_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "standard",
            "class",
            "applies_to"
          ],
          "properties": {
            "kind": {
              "const": "standard"
            },
            "standard": {
              "const": "ISO 2768-1:1989"
            },
            "class": {
              "type": "string",
              "enum": [
                "f",
                "m",
                "c",
                "v"
              ]
            },
            "applies_to": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/primary_process"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "linear_mm",
            "applies_to",
            "reference"
          ],
          "properties": {
            "kind": {
              "const": "limits"
            },
            "linear_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5,
              "x-plausible": {
                "max": 0.5
              }
            },
            "angular_deg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10,
              "x-plausible": {
                "max": 5
              }
            },
            "applies_to": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "common.schema.json#/$defs/primary_process"
              }
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "product_drawing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "projection",
        "standards",
        "default_sheet",
        "tolerance_policies",
        "general_tolerance_policy"
      ],
      "properties": {
        "definition": {
          "const": "model_and_drawing"
        },
        "projection": {
          "type": "string",
          "enum": [
            "first_angle",
            "third_angle"
          ]
        },
        "standards": {
          "type": "object",
          "required": [
            "dimensioning"
          ],
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "default_sheet": {
          "allOf": [
            {
              "$ref": "#/$defs/sheet"
            },
            {
              "required": [
                "sizes"
              ]
            }
          ]
        },
        "tolerance_policies": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/policy_name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/tolerance_policy"
          }
        },
        "general_tolerance_policy": {
          "$ref": "#/$defs/policy_name"
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "orthographic",
            "auxiliary",
            "section",
            "detail"
          ]
        },
        "normal_to": {
          "$ref": "#/$defs/reference"
        },
        "along_axis": {
          "$ref": "#/$defs/reference"
        },
        "parallel_to": {
          "$ref": "#/$defs/reference"
        },
        "perpendicular_to": {
          "$ref": "#/$defs/reference"
        },
        "opposite": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "through": {
          "$ref": "#/$defs/references"
        },
        "normal_axis": {
          "description": "section: the cutting plane is normal to this frame axis and passes through the centre of the one through reference",
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "sheet": {
          "description": "the sheet the view is drawn on; the principal view is on sheet 1",
          "type": "integer",
          "minimum": 1
        },
        "toward": {
          "$ref": "#/$defs/reference"
        },
        "feature": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "scale": {
          "$ref": "#/$defs/scale"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "section"
              }
            }
          },
          "then": {
            "required": [
              "through"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "detail"
              }
            }
          },
          "then": {
            "required": [
              "feature"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "orthographic",
                  "auxiliary"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "normal_to"
                ]
              },
              {
                "required": [
                  "along_axis"
                ]
              },
              {
                "required": [
                  "parallel_to"
                ]
              },
              {
                "required": [
                  "perpendicular_to"
                ]
              },
              {
                "required": [
                  "opposite"
                ]
              }
            ]
          }
        }
      ]
    },
    "feature_intent": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "size": {
          "type": "string",
          "enum": [
            "general",
            "interface"
          ]
        },
        "location": {
          "const": "datum_coordinates"
        },
        "profile": {
          "const": "controlled_model"
        },
        "profile_tolerance_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5,
          "x-plausible": {
            "max": 0.5
          }
        },
        "presentation": {
          "description": "general_note: a round's or chamfer's size goes in the sheet's general note of undimensioned edge fillets and edge breaks",
          "type": "string",
          "enum": [
            "auto",
            "visible",
            "section",
            "detail",
            "general_note"
          ]
        },
        "axial_location_from": {
          "$ref": "#/$defs/reference"
        },
        "tolerance_policy": {
          "$ref": "#/$defs/policy_name"
        },
        "thread": {
          "$ref": "#/$defs/thread"
        },
        "surface_texture": {
          "$ref": "#/$defs/texture_requirement"
        },
        "edges": {
          "$ref": "#/$defs/edges"
        }
      }
    },
    "thread": {
      "description": "A thread on a bore or shaft feature, drawn conventionally (ISO 6410-1, ASME Y14.6); the full-thread depth is the measured distance from the feature's entry to its locator anchor",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designation",
        "standard",
        "operation"
      ],
      "properties": {
        "designation": {
          "type": "string",
          "pattern": "^M[0-9]+(\\.[0-9]+)?x[0-9]+(\\.[0-9]+)?-[0-9][a-hA-H]([0-9][a-hA-H])?$"
        },
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "tap",
            "thread_form",
            "roll",
            "cut",
            "vendor"
          ]
        },
        "full_depth_anchor": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        }
      }
    },
    "edge_limits": {
      "description": "ISO 13715:2017 edge size limits [lower, upper] in mm: + permits excess material (burr, passing), - requires removal (edge break, undercut); a single limit pairs with 0",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": -5,
        "maximum": 5
      },
      "x-plausible": {
        "min": -0.5,
        "max": 0.5
      }
    },
    "edges": {
      "description": "Edges of undefined shape: the external and internal edge size limits; on a feature, exceptions to the drawing's general indication",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "external": {
          "$ref": "#/$defs/edge_limits"
        },
        "internal": {
          "$ref": "#/$defs/edge_limits"
        }
      }
    },
    "texture_requirement": {
      "description": "An ISO 21920-1 (ASME Y14.36) surface texture requirement: the parameter's upper limit in micrometres and whether material shall be removed",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter",
        "limit_um",
        "process"
      ],
      "properties": {
        "parameter": {
          "type": "string",
          "enum": [
            "Ra",
            "Rz"
          ]
        },
        "limit_um": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 500,
          "x-plausible": {
            "max": 100
          }
        },
        "process": {
          "type": "string",
          "enum": [
            "any",
            "removal_required",
            "removal_prohibited"
          ]
        }
      }
    },
    "geometric_tolerance": {
      "description": "A geometrical tolerance of ISO 1101 or ASME Y14.5 on resolved features; the zone is design intent, never a measured value",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "characteristic",
        "features",
        "zone_mm"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "characteristic": {
          "type": "string",
          "enum": [
            "position",
            "coaxiality",
            "perpendicularity",
            "parallelism",
            "flatness",
            "cylindricity",
            "circular_runout",
            "total_runout",
            "profile_surface"
          ]
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/semantic_id"
          }
        },
        "zone_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10,
          "x-plausible": {
            "min": 0.01,
            "max": 1
          }
        },
        "diameter_zone": {
          "type": "boolean"
        },
        "datum_frame": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/datum_label"
          }
        }
      }
    },
    "dimension_request": {
      "description": "An additional measured dimension; its value always comes from the model, so there is no value field",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "features"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "operation": {
          "type": "string",
          "enum": [
            "diameter",
            "radius",
            "distance",
            "plane_separation",
            "axis_distance",
            "location",
            "axis_location",
            "angle",
            "depth",
            "width",
            "length",
            "thickness",
            "chamfer"
          ]
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/semantic_id"
          }
        },
        "at": {
          "$ref": "common.schema.json#/$defs/semantic_id",
          "description": "A plane feature a width, thickness or separation is stated at: between two planes that are not parallel (a drafted wall, inclined flanks), the distance between the lines where they meet this plane"
        },
        "instance": {
          "type": "integer",
          "minimum": 1,
          "description": "A distance from a plane_face to a bore's or shaft's centres: which of their distances from that plane it states, 1 the nearest; centres at one distance share the dimension. Required when the centres lie at several distances"
        },
        "datum_frame": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/datum_label"
          }
        },
        "tolerance": {
          "$ref": "#/$defs/tolerance"
        },
        "presentation": {
          "type": "string",
          "enum": [
            "auto",
            "visible",
            "section",
            "detail"
          ]
        },
        "reference": {
          "type": "boolean"
        }
      }
    },
    "part_drawing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "detail",
            "vendor_specification",
            "source_control"
          ]
        },
        "tolerance_policy": {
          "$ref": "#/$defs/policy_name"
        },
        "datum_features": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/datum_label"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "feature",
              "role"
            ],
            "properties": {
              "feature": {
                "$ref": "common.schema.json#/$defs/semantic_id"
              },
              "role": {
                "type": "string",
                "enum": [
                  "plane",
                  "axis",
                  "point",
                  "center_plane",
                  "clocking_feature"
                ]
              }
            }
          }
        },
        "coordinate_frame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin"
          ],
          "properties": {
            "origin": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "intersection"
                  ],
                  "properties": {
                    "intersection": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 3,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/reference"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "at"
                  ],
                  "properties": {
                    "at": {
                      "$ref": "#/$defs/reference"
                    }
                  }
                }
              ]
            },
            "x": {
              "$ref": "#/$defs/direction"
            },
            "y": {
              "$ref": "#/$defs/direction"
            },
            "z": {
              "$ref": "#/$defs/direction"
            }
          },
          "anyOf": [
            {
              "required": [
                "x"
              ]
            },
            {
              "required": [
                "y"
              ]
            },
            {
              "required": [
                "z"
              ]
            }
          ]
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/view"
          }
        },
        "features": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/semantic_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/feature_intent"
          }
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimension_request"
          }
        },
        "geometric_tolerances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/geometric_tolerance"
          }
        },
        "edges": {
          "description": "the general indication of the edges of undefined shape (ISO 13715:2017 §4.5.4); a detail drawing needs it",
          "allOf": [
            {
              "$ref": "#/$defs/edges"
            },
            {
              "required": [
                "external",
                "internal"
              ]
            }
          ]
        },
        "surface_texture": {
          "description": "the general surface texture of the surfaces with no texture of their own (ISO 21920-1 §9.1.2), or open with the reason no value has a basis yet; a detail drawing needs it",
          "oneOf": [
            {
              "$ref": "#/$defs/texture_requirement"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "open"
              ],
              "properties": {
                "open": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "process",
                  "finish",
                  "material",
                  "inspection",
                  "general"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "manufacturing": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "build_direction": {
              "$ref": "#/$defs/direction"
            },
            "interface_condition": {
              "type": "string",
              "enum": [
                "as_printed",
                "post_processed",
                "finish_machined"
              ]
            },
            "dimensions_apply": {
              "type": "string",
              "enum": [
                "before_finish",
                "after_finish"
              ]
            },
            "post_processing": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "inspection_stage": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "sheet": {
          "$ref": "#/$defs/sheet"
        }
      }
    },
    "procurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "catalog",
            "made_to_drawing"
          ]
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer_part_number": {
          "type": "string",
          "minLength": 1
        },
        "supplier_part_number": {
          "type": "string",
          "minLength": 1
        },
        "designation": {
          "type": "string",
          "minLength": 1
        },
        "standard": {
          "description": "the product standard of a standard part, such as DIN 471 or ISO 4762; its designation states the standard with its designation items (DIN 471 - 5x0.6) and identifies the item without a manufacturer or manufacturer part number",
          "type": "string",
          "pattern": "^(ISO|IEC|EN|DIN|BS|JIS|ANSI|ASME|SAE|NAS|MS)( (EN|ISO|IEC))* [A-Z]?[0-9]+(\\.[0-9]+)*(-[0-9]+)*$"
        },
        "specification": {
          "description": "the datasheet or standard that defines the item, identified by its sha256; with only a url the frozen copy is a sourcing input kept outside the record",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "revision",
            "sha256"
          ],
          "anyOf": [
            {
              "required": [
                "artifact"
              ]
            },
            {
              "required": [
                "url"
              ]
            }
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "description": "frozen copy of the specification, relative to hw/",
              "type": "string",
              "pattern": "^[^/\\n\\r\\u2028\\u2029][^\\n\\r\\u2028\\u2029]*$",
              "not": {"pattern": "(^|/)\\.\\.(/|$)"}
            },
            "url": {
              "description": "where the publisher serves the specification",
              "type": "string",
              "pattern": "^https://[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+$"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          }
        },
        "open": {
          "description": "orderable identity fields deliberately left open, each with the reason; every one blocks release",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "manufacturer": {
              "type": "string",
              "minLength": 1
            },
            "manufacturer_part_number": {
              "type": "string",
              "minLength": 1
            },
            "supplier_part_number": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "approved_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "part_number": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "qualification_evidence": {
          "type": "string",
          "minLength": 1
        },
        "certificates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fit_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PN",
        "feature"
      ],
      "properties": {
        "PN": {
          "$ref": "common.schema.json#/$defs/pn"
        },
        "occurrence": {
          "$ref": "common.schema.json#/$defs/occurrence_ref"
        },
        "feature": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        },
        "region": {
          "$ref": "common.schema.json#/$defs/semantic_id"
        }
      }
    },
    "fit": {
      "description": "An ISO 286 fit between two parts: a part pair, or a hole and a shaft feature endpoint",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit"
      ],
      "properties": {
        "fit": {
          "type": "string",
          "minLength": 1
        },
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "assembly.schema.json#/$defs/part_ref"
          }
        },
        "hole": {
          "$ref": "#/$defs/fit_endpoint"
        },
        "shaft": {
          "$ref": "#/$defs/fit_endpoint"
        },
        "engagement_length_mm": {
          "description": "engagement_length_mm: positive number, in mm. The travel along the insertion axis, back from the installed pose, over which the interfering surface of the inserted part still overlaps its partner. For a press fit seated on a bore floor, use the bore depth (an entry chamfer or counterbore may be ignored); not the press-band length and not the overlap at the installed pose. For a heat-set insert, use its embedded length. For a press fit or a heat-set insert, assembly access exempts interference up to this length plus one minimum sampling step. A running or locating fit records the length but gets no exemption. Optional; never derived.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "axial_retainer": {
          "$ref": "#/$defs/axial_retainer"
        }
      },
      "oneOf": [
        {
          "required": [
            "pair"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "hole"
                ]
              },
              {
                "required": [
                  "shaft"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "hole",
            "shaft"
          ],
          "not": {
            "required": [
              "pair"
            ]
          }
        }
      ]
    },
    "axial_retainer": {
      "description": "What keeps a press_fit or locating_fit from walking along its axis; the record validator requires one from stage parts on. Hardware types (circlip, set_screw, nut, pin, cap) name their modelled occurrences in parts",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "shoulder",
            "circlip",
            "set_screw",
            "nut",
            "pin",
            "cap",
            "captured",
            "press_fit",
            "adhesive"
          ]
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "assembly.schema.json#/$defs/part_ref"
          }
        },
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        }
      }
    },
    "heat_set": {
      "description": "A heat-set insert installed in its host part's bore; the pair is [host, insert], each a PN or an @occurrence reference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair",
        "hole_diameter_mm",
        "insert",
        "source"
      ],
      "properties": {
        "pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "assembly.schema.json#/$defs/part_ref"
          }
        },
        "hole_diameter_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "x-plausible": {
            "min": 1.5,
            "max": 25
          },
          "description": "The bore diameter, in mm"
        },
        "hole_deviation_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "The bore's [lower, upper] deviation from hole_diameter_mm, in mm"
        },
        "min_depth_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "x-plausible": {
            "min": 1.5,
            "max": 25
          },
          "description": "The minimum bore depth, in mm"
        },
        "engagement_length_mm": {
          "description": "engagement_length_mm: positive number, in mm. The travel along the insertion axis, back from the installed pose, over which the interfering surface of the inserted part still overlaps its partner. For a press fit seated on a bore floor, use the bore depth (an entry chamfer or counterbore may be ignored); not the press-band length and not the overlap at the installed pose. For a heat-set insert, use its embedded length. For a press fit or a heat-set insert, assembly access exempts interference up to this length plus one minimum sampling step. A running or locating fit records the length but gets no exemption. Optional; never derived.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "insert": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^https?://[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]+$"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "description": "the host part's bore feature that takes the insert",
          "$ref": "common.schema.json#/$defs/semantic_id"
        }
      }
    }
  },
  "examples": [
    {
      "fit": "5 H7/p6",
      "hole": {
        "PN": "LMP-0002",
        "feature": "hub_bore"
      },
      "shaft": {
        "PN": "LMP-0005",
        "feature": "press_band"
      }
    }
  ]
}
