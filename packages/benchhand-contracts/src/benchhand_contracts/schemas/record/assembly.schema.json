{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand/contracts/record/assembly.schema.json",
  "title": "benchhand assembly record (hw/assembly.yaml)",
  "x-version": "1.0.0",
  "type": "object",
  "properties": {
    "operations": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assembly_operation"
          }
        },
        {
          "$ref": "common.schema.json#/$defs/fact_unknown"
        }
      ],
      "description": "Record version 2 installation, closure, fastening, adjustment, inspection and service operations, independent of drawings; unknown until recorded"
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/occurrence_id"
          },
          "PN": {
            "$ref": "common.schema.json#/$defs/pn"
          },
          "placement": {
            "$ref": "#/$defs/placement"
          }
        },
        "required": [
          "id",
          "PN"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Explicit placements of part definitions; a PN listed in a subassembly's parts is one implicit occurrence at the identity placement instead"
    },
    "profiles": {
      "minProperties": 1,
      "description": "Reusable periodic tables a periodic_table coupling evaluates, by name",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/profile"
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mechanism"
      },
      "minItems": 1,
      "description": "Shared mechanism parameters whose outputs several slider_crank couplings follow"
    },
    "subassemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/pn"
            },
            "minItems": 1
          },
          "occurrences": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/occurrence_ref"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "parts"
            ]
          },
          {
            "required": [
              "occurrences"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "joints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/joint_id"
          },
          "type": {
            "type": "string",
            "enum": [
              "revolute",
              "prismatic",
              "fixed"
            ]
          },
          "parent": {
            "$ref": "#/$defs/part_ref"
          },
          "child": {
            "$ref": "#/$defs/part_ref"
          },
          "axis": {
            "$ref": "common.schema.json#/$defs/vector"
          },
          "origin": {
            "$ref": "common.schema.json#/$defs/vector"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "nominal": {
            "type": "number",
            "description": "The value of an independent joint; a coupled joint has none"
          },
          "coupling": {
            "$ref": "#/$defs/coupling"
          },
          "torque": {
            "description": "Whether the child carries drive torque. From stage parts on, every revolute declares it (none for a hand-positioned or free-running joint), and so does every fixed joint inside the drive train that a revolute not declared none starts; a fixed joint declared transmitted names its torque_path",
            "type": "string",
            "enum": [
              "transmitted",
              "none"
            ]
          },
          "torque_path": {
            "$ref": "#/$defs/torque_path"
          }
        },
        "required": [
          "id",
          "type",
          "parent",
          "child",
          "axis",
          "origin",
          "min",
          "max"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fixed"
                }
              }
            },
            "then": {
              "required": [
                "nominal"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "prismatic"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "torque"
                    ]
                  },
                  {
                    "required": [
                      "torque_path"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "torque_path"
              ]
            },
            "then": {
              "required": [
                "torque"
              ],
              "properties": {
                "torque": {
                  "const": "transmitted"
                }
              }
            }
          }
        ],
        "oneOf": [
          {
            "required": [
              "nominal"
            ]
          },
          {
            "required": [
              "coupling"
            ]
          }
        ]
      }
    },
    "drawing": {
      "$ref": "#/$defs/assembly_drawing"
    }
  },
  "required": [
    "subassemblies",
    "joints"
  ],
  "additionalProperties": false,
