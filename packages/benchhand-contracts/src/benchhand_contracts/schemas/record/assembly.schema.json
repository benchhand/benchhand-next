  "$defs": {
    "joint_id": {
      "type": "string",
      "pattern": "^J-[0-9]{3}$"
    },
    "torque_path": {
      "description": "What carries the drive torque across a torque: transmitted joint; required on a fixed joint, optional on a revolute driven through an unmodelled shaft. Hardware types (key, set_screw, pin) name their modelled occurrences in parts",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "key",
            "set_screw",
            "d_flat",
            "press_fit",
            "spline",
            "clamp",
            "pin",
            "adhesive"
          ]
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part_ref"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "decision": {
          "$ref": "common.schema.json#/$defs/decision"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "coupling": {
      "description": "A dependent joint's law: its value derives from a driver joint",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "linear"
            },
            "driver": {
              "$ref": "#/$defs/joint_id"
            },
            "ratio": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "driver",
            "ratio"
          ],
          "additionalProperties": false,
          "description": "q = ratio * q_driver + offset; ratio in dependent units per driver unit"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "periodic_table"
            },
            "driver": {
              "$ref": "#/$defs/joint_id"
            },
            "profile": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "phase_deg": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "driver",
            "profile"
          ],
          "additionalProperties": false,
          "description": "q = profile((q_driver + phase_deg) mod period_deg); the driver is revolute"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "slider_crank"
            },
            "mechanism": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "output": {
              "enum": [
                "displacement",
                "rod_angle"
              ]
            }
          },
          "required": [
            "type",
            "mechanism",
            "output"
          ],
          "additionalProperties": false,
          "description": "One output of a slider_crank mechanism: piston displacement (prismatic) or rod angle (revolute)"
        }
      ]
    },
    "profile": {
      "description": "Piecewise-linear periodic table: samples from 0 to period_deg with matching end values",
      "type": "object",
      "properties": {
        "input_unit": {
          "const": "deg"
        },
        "output_unit": {
          "enum": [
            "mm",
            "deg"
          ]
        },
        "period_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360
        },
        "interpolation": {
          "const": "linear"
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ]
          },
          "minItems": 2
        }
      },
      "required": [
        "input_unit",
        "output_unit",
        "period_deg",
        "interpolation",
        "samples"
      ],
      "additionalProperties": false
    },
    "mechanism": {
      "description": "A centred slider-crank: the driver turns the crank about crank_axis through origin_mm; the piston slides along bank_axis",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "type": {
          "const": "slider_crank"
        },
        "driver": {
          "$ref": "#/$defs/joint_id"
        },
        "origin_mm": {
          "$ref": "common.schema.json#/$defs/vector"
        },
        "crank_axis": {
          "$ref": "common.schema.json#/$defs/vector"
        },
        "bank_axis": {
          "$ref": "common.schema.json#/$defs/vector"
        },
        "crank_radius_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "x-plausible": {
            "max": 200
          }
        },
        "rod_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "x-plausible": {
            "max": 500
          }
        },
        "phase_deg": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "driver",
        "origin_mm",
        "crank_axis",
        "bank_axis",
        "crank_radius_mm",
        "rod_length_mm"
      ],
      "additionalProperties": false
    },
    "occurrence_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "part_ref": {
      "description": "An occurrence reference, or a PN that has exactly one occurrence",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/pn"
        },
        {
          "$ref": "common.schema.json#/$defs/occurrence_ref"
        }
      ]
    },
    "placement": {
      "description": "Rest placement x -> R x + t: rotation about the definition's local origin, then translation (mm)",
      "type": "object",
      "properties": {
        "translation_mm": {
          "$ref": "common.schema.json#/$defs/vector"
        },
        "rotation": {
          "type": "object",
          "properties": {
            "axis": {
              "$ref": "common.schema.json#/$defs/vector"
            },
            "angle_deg": {
              "type": "number"
            }
          },
          "required": [
            "axis",
            "angle_deg"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "drawing_item": {
      "description": "One assembly-drawing item row: a PN and, when it is placed more than once, the occurrences it stands for",
      "type": "object",
      "properties": {
        "item": {
          "type": "integer",
          "minimum": 1
        },
        "PN": {
          "$ref": "common.schema.json#/$defs/pn"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/occurrence_ref"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "item",
        "PN"
      ],
      "additionalProperties": false
    },
    "assembly_drawing": {
      "description": "Assembly drawing intent: identity, views, presentation-only explode offsets, parts-list items, subassembly sheets and installation operations",
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "rev": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "modeled_mechanical_assembly",
            "complete_assembly"
          ]
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "What a modelled scope leaves out, named on the drawing"
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "kind": {
                "enum": [
                  "assembled",
                  "exploded"
                ]
              },
              "direction": {
                "enum": [
                  "front",
                  "back",
                  "left",
                  "right",
                  "top",
                  "bottom",
                  "iso"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "direction"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "explode": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/part_ref"
              },
              "offset_mm": {
                "$ref": "common.schema.json#/$defs/vector"
              }
            },
            "required": [
              "ref",
              "offset_mm"
            ],
            "additionalProperties": false
          },
          "description": "Exploded-view offsets in mm, assembly frame; each occurrence also moves by its kinematic ancestors' offsets"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drawing_item"
          },
          "minItems": 1
        },
        "subassembly_sheets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "number",
        "rev",
        "title",
        "views",
        "items"
      ],
      "additionalProperties": false
    },
    "assembly_operation": {
      "description": "One assembly operation. An installation step puts `part` into `into` along `direction` (in the receiving part's model frame) until the acceptance holds; the fit, insert or ring comes from the interface limit of the same kind. predecessors name the operations that must come first, closes the parts it encloses, and tool_access the tools that must reach. A tool name alone is display text: its reach stays unknown. path, when given, is the part's insertion path; without it the part travels in a straight line along direction, and checks report that default. edge_distance is a fastener, insert or heat-set joint's distance from its hole to the nearest edge against its sourced criterion",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "press_fit",
            "heat_set",
            "retaining_ring",
            "insert",
            "fasten",
            "join",
            "close",
            "adjust",
            "inspect",
            "disassemble"
          ]
        },
        "part": {
          "$ref": "#/$defs/part_ref"
        },
        "into": {
          "$ref": "#/$defs/part_ref"
        },
        "interface": {
          "$ref": "common.schema.json#/$defs/interface_id"
        },
        "direction": {
          "$ref": "common.schema.json#/$defs/vector"
        },
        "acceptance": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "seated",
                "standoff",
                "flush",
                "engaged",
                "torqued",
                "adjusted",
                "inspected"
              ]
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 1,
              "maxItems": 2
            }
          },
          "required": [
            "kind",
            "features"
          ],
          "additionalProperties": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verify_joint": {
          "type": "string",
          "pattern": "^J-[0-9]{3}$"
        },
        "predecessors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "closes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part_ref"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "parts this operation encloses: no later operation reaches them"
        },
        "tool_access": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "$ref": "common.schema.json#/$defs/profile_id"
              },
              "approach": {
                "$ref": "common.schema.json#/$defs/vector"
              },
              "reach": {
                "$ref": "common.schema.json#/$defs/quantity_fact"
              },
              "envelope": {
                "$ref": "common.schema.json#/$defs/text_fact"
              }
            },
            "required": [
              "tool"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "engagement": {
          "$ref": "common.schema.json#/$defs/quantity_fact"
        },
        "torque": {
          "$ref": "common.schema.json#/$defs/quantity_fact"
        },
        "retention": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "service_access": {
          "$ref": "common.schema.json#/$defs/text_fact"
        },
        "edge_distance": {
          "type": "object",
          "properties": {
            "criterion": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/criterion"
                },
                {
                  "required": [
                    "units"
                  ],
                  "properties": {
                    "property": {
                      "const": "edge_distance"
                    },
                    "operator": {
                      "enum": [
                        ">=",
                        "between"
                      ]
                    },
                    "units": {
                      "enum": [
                        "mm",
                        "um",
                        "m"
                      ]
                    }
                  }
                }
              ]
            },
            "distance": {
              "$ref": "common.schema.json#/$defs/quantity_fact"
            }
          },
          "required": [
            "criterion",
            "distance"
          ],
          "additionalProperties": false,
          "description": "The joint's edge distance: the criterion it must meet (property edge_distance, a length bound with its source) and the distance the design gives, a known length (an interval's lower end governs) or an unknown with its reason"
        },
        "path": {
          "type": "object",
          "properties": {
            "start": {
              "$ref": "common.schema.json#/$defs/vector"
            },
            "via": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/vector"
              },
              "minItems": 1
            }
          },
          "required": [
            "start"
          ],
          "additionalProperties": false,
          "description": "The insertion path of `part`: its offsets in mm from the installed pose, in the receiving part's model frame, keeping the installed orientation. The part starts at start, passes via in order and arrives installed; the last leg runs along direction"
        },
        "inspection": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "part"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "press_fit",
                  "heat_set",
                  "retaining_ring"
                ]
              }
            }
          },
          "then": {
            "required": [
              "into",
              "interface",
              "direction",
              "acceptance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "insert",
                  "fasten",
                  "join"
                ]
              }
            }
          },
          "then": {
            "required": [
              "into",
              "direction",
              "acceptance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "close"
              }
            }
          },
          "then": {
            "required": [
              "into",
              "closes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "adjust",
                  "inspect"
                ]
              }
            }
          },
          "then": {
            "required": [
              "acceptance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "disassemble"
              }
            }
          },
          "then": {
            "required": [
              "into",
              "direction"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "close",
                  "adjust",
                  "inspect",
                  "disassemble"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "edge_distance"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "path"
            ]
          },
          "then": {
            "required": [
              "direction"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "press_fit",
                  "heat_set",
                  "retaining_ring",
                  "insert",
                  "fasten",
                  "join",
                  "close"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
