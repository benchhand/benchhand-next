{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/manufacturing-materials.schema.json",
  "title": "CAD material profiles (hw/manufacturing/materials.yaml and the plugin's starter material profiles)",
  "description": "Material identity and properties with their conditions. A family profile (PLA+, nylon, PETG, aluminium) is guidance, never a grade specification; a grade profile names the manufacturer's grade. Printed, moulded, bulk, cast and wrought properties are different profiles; every property states its test standard, temperature, conditioning and, for printed forms, orientation. A typical_not_allowable profile holds only typical or estimated values, never design allowables. Density is never strength. Property names and their dimensions are manufacturing_intent.MATERIAL_PROPERTIES",
  "type": "object", "additionalProperties": false, "required": ["profiles"],
  "properties": {
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "conditioning": {"description": "dry as moulded or dried, moisture-conditioned, as received, or not stated", "enum": ["dry", "conditioned", "as_received", "unknown"]},
    "qty_modulus": {
      "description": "Elastic, flexural, shear and creep modulus: above 0 and at most 1200 GPa, diamond's",
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "GPa"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 1200}, "lower": {"exclusiveMinimum": 0, "maximum": 1200}, "upper": {"exclusiveMinimum": 0, "maximum": 1200}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "MPa"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 1200000}, "lower": {"exclusiveMinimum": 0, "maximum": 1200000}, "upper": {"exclusiveMinimum": 0, "maximum": 1200000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "bar"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 12000000}, "lower": {"exclusiveMinimum": 0, "maximum": 12000000}, "upper": {"exclusiveMinimum": 0, "maximum": 12000000}}}}
      ]
    },
    "fact_modulus": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_modulus"}}}},
    "qty_density": {
      "description": "Density: above 0 and at most 25 g/cm3; below 0.5 g/cm3 is unusual for a solid",
      "x-plausible": {"min": 0.5, "units": "g_cm3"},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "g_cm3"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 25}, "lower": {"exclusiveMinimum": 0, "maximum": 25}, "upper": {"exclusiveMinimum": 0, "maximum": 25}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "kg_m3"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 25000}, "lower": {"exclusiveMinimum": 0, "maximum": 25000}, "upper": {"exclusiveMinimum": 0, "maximum": 25000}}}}
      ]
    },
    "fact_density": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_density"}}}},
    "qty_temperature": {
      "description": "A temperature property: above absolute zero and at most 1000 deg_C; above 300 deg_C is unusual for a printed polymer",
      "x-plausible": {"max": 300, "units": "deg_C"},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "deg_C"}}}, "then": {"properties": {"value": {"exclusiveMinimum": -273.15, "maximum": 1000}, "lower": {"exclusiveMinimum": -273.15, "maximum": 1000}, "upper": {"exclusiveMinimum": -273.15, "maximum": 1000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "K"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 1273.15}, "lower": {"exclusiveMinimum": 0, "maximum": 1273.15}, "upper": {"exclusiveMinimum": 0, "maximum": 1273.15}}}}
      ]
    },
    "fact_temperature": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_temperature"}}}},
    "qty_poisson": {
      "description": "Poisson's ratio: 0 up to, not including, 0.5",
      "x-plausible": {"max": 0.45, "units": "dimensionless"},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "dimensionless"}}}, "then": {"properties": {"value": {"minimum": 0, "exclusiveMaximum": 0.5}, "lower": {"minimum": 0, "exclusiveMaximum": 0.5}, "upper": {"minimum": 0, "exclusiveMaximum": 0.5}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "percent"}}}, "then": {"properties": {"value": {"minimum": 0, "exclusiveMaximum": 50}, "lower": {"minimum": 0, "exclusiveMaximum": 50}, "upper": {"minimum": 0, "exclusiveMaximum": 50}}}}
      ]
    },
    "fact_poisson": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_poisson"}}}},
    "qty_fu_fy": {
      "description": "The ratio of tensile strength fu to yield strength fy: at least 1, since fu is never below fy. EN 1993-1-1 3.2.2 recommends at least 1.10 for structural steel (clause number from a secondary source; the National Annex may change it)",
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "dimensionless"}}}, "then": {"properties": {"value": {"minimum": 1}, "lower": {"minimum": 1}, "upper": {"minimum": 1}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "percent"}}}, "then": {"properties": {"value": {"minimum": 100}, "lower": {"minimum": 100}, "upper": {"minimum": 100}}}}
      ]
    },
    "fact_fu_fy": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_fu_fy"}}}},
    "gauge": {
      "description": "The gauge length the elongation after fracture was measured on. Elongations on different gauges are not comparable: ASME uses k=5, EN uses 5.65*sqrt(S0), ASTM E8 uses 50 mm or 2 in. A missing gauge means the value cannot be compared with a ductility threshold, so a gate treats the material as not shown ductile (unknown). The thresholds are percentages and the value is a ratio, so 14% is 0.14. EN 13445-2:2014 4.1.4 requires at least 14% on 5.65*sqrt(S0) for steels, and EN 1993-1-1 3.2.2 recommends at least 15% with fu/fy of at least 1.10; both clause numbers are from secondary sources and are not checked against the standards",
      "enum": ["5.65sqrtS0", "5d", "A50mm", "A2in", "other"]
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "title", "level", "family", "grade", "form", "process_state", "typical_not_allowable", "properties"],
      "properties": {
        "id": {"$ref": "manufacturing.schema.json#/$defs/profile_id"},
        "revision": {"type": "integer", "minimum": 1},
        "title": {"$ref": "manufacturing.schema.json#/$defs/text"},
        "level": {"enum": ["family", "grade"]},
        "family": {"$ref": "manufacturing.schema.json#/$defs/text"},
        "material_family": {"description": "the structured family a guideline scope matches on, such as pla, petg, pa or tpu; unknown when not stated. It has no default", "$ref": "#/$defs/scope_fact"},
        "filler": {"description": "the fill a guideline scope matches on, such as cf or gf; not applicable for an unfilled material. It has no default", "$ref": "#/$defs/scope_fact"},
        "shore": {"description": "the Shore hardness a guideline scope matches on, such as 95A or 85A. It has no default", "$ref": "#/$defs/scope_fact"},
        "grade": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "manufacturer": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "specification": {"description": "the standard or datasheet designation the grade conforms to", "$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "form": {"enum": ["printed", "bulk", "wrought", "cast", "moulded", "sheet", "rod", "film", "purchased", "unknown"]},
        "process_state": {
          "type": "object", "additionalProperties": false, "required": ["process", "conditioning"],
          "properties": {
            "process": {"description": "the route kind that made the tested material, or unknown", "oneOf": [{"$ref": "manufacturing.schema.json#/$defs/route_kind"}, {"$ref": "manufacturing.schema.json#/$defs/fact_open"}]},
            "orientation": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "layup": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "temper": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "conditioning": {"$ref": "#/$defs/conditioning"},
            "lot": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "notes": {"$ref": "manufacturing.schema.json#/$defs/text"}
          }
        },
        "typical_not_allowable": {"type": "boolean"},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/property"}},
        "guidance": {"description": "family guidance and cautions, such as fibre fill wear on nozzles and mating surfaces; never a grade allowable", "$ref": "manufacturing.schema.json#/$defs/texts"},
        "note": {"$ref": "manufacturing.schema.json#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"level": {"const": "family"}}},
         "then": {"properties": {"grade": {"$ref": "manufacturing.schema.json#/$defs/fact_open"}}}},
        {"if": {"properties": {"level": {"const": "grade"}}},
         "then": {"properties": {"grade": {"$ref": "manufacturing.schema.json#/$defs/fact_known"}}}}
      ]
    },
    "scope_fact": {
      "description": "A fact a guideline scope matches on: a known value is lowercase, as scope names are, so 'PLA' is refused",
      "allOf": [
        {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}},
         "then": {"properties": {"value": {"pattern": "^[a-z0-9][a-z0-9_.-]*$"}}}}
      ]
    },
    "property": {
      "type": "object", "additionalProperties": false, "required": ["name", "value", "conditions"],
      "properties": {
        "name": {"$ref": "manufacturing.schema.json#/$defs/semantic_id"},
        "value": {"$ref": "manufacturing.schema.json#/$defs/quantity_fact"},
        "conditions": {
          "type": "object", "additionalProperties": false, "required": ["test_standard", "temperature", "conditioning"],
          "properties": {
            "test_standard": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
            "temperature": {"$ref": "manufacturing.schema.json#/$defs/quantity_fact"},
            "conditioning": {"$ref": "#/$defs/conditioning"},
            "orientation": {"description": "the print or grain orientation of the specimen", "$ref": "manufacturing.schema.json#/$defs/text_fact"},
            "gauge": {"description": "allowed on elongation_at_break only; optional", "$ref": "#/$defs/gauge"},
            "specimen": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "rate": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "notes": {"$ref": "manufacturing.schema.json#/$defs/text"}
          }
        }
      },
      "allOf": [
        {"if": {"required": ["name"], "properties": {"name": {"enum": ["youngs_modulus", "flexural_modulus", "shear_modulus", "creep_modulus"]}}}, "then": {"properties": {"value": {"$ref": "#/$defs/fact_modulus"}}}},
        {"if": {"required": ["name"], "properties": {"name": {"enum": ["density"]}}}, "then": {"properties": {"value": {"$ref": "#/$defs/fact_density"}}}},
        {"if": {"required": ["name"], "properties": {"name": {"enum": ["heat_deflection_temperature", "vicat_softening_temperature", "glass_transition_temperature", "melting_temperature", "max_service_temperature"]}}}, "then": {"properties": {"value": {"$ref": "#/$defs/fact_temperature"}}}},
        {"if": {"required": ["name"], "properties": {"name": {"enum": ["poisson_ratio"]}}}, "then": {"properties": {"value": {"$ref": "#/$defs/fact_poisson"}}}},
        {"if": {"required": ["name"], "properties": {"name": {"enum": ["fu_fy_ratio"]}}}, "then": {"properties": {"value": {"$ref": "#/$defs/fact_fu_fy"}}}},
        {"if": {"required": ["name"], "properties": {"name": {"not": {"const": "elongation_at_break"}}}}, "then": {"properties": {"conditions": {"not": {"required": ["gauge"]}}}}}
      ]
    }
  }
}
