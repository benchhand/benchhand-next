    },
    "qty_min_hole": {
      "description": "Calibrated smallest reliable cut hole diameter: 0.1 to 25 mm. The 0.5 to 10 mm plausibility band is a heuristic with no source table and only warns; the sourced guideline value is 2.0 mm (Protolabs, S3 in the FDM survey)",
      "x-plausible": {"min": 0.5, "max": 10, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"minimum": 0.1, "maximum": 25}, "lower": {"minimum": 0.1, "maximum": 25}, "upper": {"minimum": 0.1, "maximum": 25}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"minimum": 0.0001, "maximum": 0.025}, "lower": {"minimum": 0.0001, "maximum": 0.025}, "upper": {"minimum": 0.0001, "maximum": 0.025}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"minimum": 100, "maximum": 25000}, "lower": {"minimum": 100, "maximum": 25000}, "upper": {"minimum": 100, "maximum": 25000}}}}
      ]
    },
    "qty_deviation": {
      "description": "Calibrated as-made minus nominal deviation: -2 to 2 mm",
      "x-plausible": {"min": -0.5, "max": 0.5, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"minimum": -2, "maximum": 2}, "lower": {"minimum": -2, "maximum": 2}, "upper": {"minimum": -2, "maximum": 2}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"minimum": -0.002, "maximum": 0.002}, "lower": {"minimum": -0.002, "maximum": 0.002}, "upper": {"minimum": -0.002, "maximum": 0.002}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"minimum": -2000, "maximum": 2000}, "lower": {"minimum": -2000, "maximum": 2000}, "upper": {"minimum": -2000, "maximum": 2000}}}}
      ]
    },
    "qty_clearance_per_side": {
      "description": "Sliding clearance per side between mating parts: above 0 to 5 mm. A fact of the machine and material, so it has no default. The 0.1 to 0.5 mm plausibility band is a heuristic with no source table and only warns; the sourced value is 0.3 mm per side (S4 in the FDM survey). A press fit is not a negative clearance: use qty_interference_per_side",
      "x-plausible": {"min": 0.1, "max": 0.5, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 5}, "lower": {"exclusiveMinimum": 0, "maximum": 5}, "upper": {"exclusiveMinimum": 0, "maximum": 5}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 0.005}, "lower": {"exclusiveMinimum": 0, "maximum": 0.005}, "upper": {"exclusiveMinimum": 0, "maximum": 0.005}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 5000}, "lower": {"exclusiveMinimum": 0, "maximum": 5000}, "upper": {"exclusiveMinimum": 0, "maximum": 5000}}}}
      ]
    },
    "qty_interference_per_side": {
      "description": "Press-fit interference per side, shaft larger than hole: above 0 to 1 mm, never negative. A fact of the machine and material, so it has no default. The 0.05 to 0.3 mm plausibility band is a heuristic with no source table and only warns; the intended press-fit range is 0.10 to 0.15 mm per side",
      "x-plausible": {"min": 0.05, "max": 0.3, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 1}, "lower": {"exclusiveMinimum": 0, "maximum": 1}, "upper": {"exclusiveMinimum": 0, "maximum": 1}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 0.001}, "lower": {"exclusiveMinimum": 0, "maximum": 0.001}, "upper": {"exclusiveMinimum": 0, "maximum": 0.001}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 1000}, "lower": {"exclusiveMinimum": 0, "maximum": 1000}, "upper": {"exclusiveMinimum": 0, "maximum": 1000}}}}
      ]
    },
    "qty_min_bed_contact_area": {
      "description": "Calibrated smallest reliable first-layer contact area: above 0 mm2. A fact of the machine and material, so it has no default. The plausibility band waits for more calibrations (#141)",
      "properties": {"units": {"enum": ["mm2"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm2"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0}, "lower": {"exclusiveMinimum": 0}, "upper": {"exclusiveMinimum": 0}}}}
      ]
    },
    "material_approval": {
      "type": "object", "additionalProperties": false, "required": ["material", "status", "source"],
      "properties": {
        "material": {"description": "a material profile id", "$ref": "manufacturing.schema.json#/$defs/profile_id"},
        "status": {"enum": ["approved", "forbidden"]},
        "thickness": {"$ref": "manufacturing.schema.json#/$defs/quantity_fact"},
        "coating": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "extraction": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cut", "score", "engrave", "machine", "print", "form", "join", "other"]}},
        "reason": {"$ref": "manufacturing.schema.json#/$defs/text"},
        "source": {"$ref": "manufacturing.schema.json#/$defs/source"}
      },
      "if": {"properties": {"status": {"const": "forbidden"}}}, "then": {"required": ["reason"]}
    },
    "calibration": {
      "description": "One demonstrated capability: the characteristic measured, its exact scope and the measured limits with their uncertainty and evidence",
      "type": "object", "additionalProperties": false, "required": ["id", "characteristic", "scope", "result", "source", "date"],
      "properties": {
        "id": {"$ref": "manufacturing.schema.json#/$defs/semantic_id"},
        "characteristic": {"description": "such as hole_diameter_deviation, min_wall, kerf, flatness or bridge_span", "$ref": "manufacturing.schema.json#/$defs/semantic_id"},
        "scope": {
          "type": "object", "additionalProperties": false, "required": ["material"],
          "properties": {
            "material": {"description": "a material profile id", "$ref": "manufacturing.schema.json#/$defs/profile_id"},
            "condition": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "feature": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "size": {"$ref": "manufacturing.schema.json#/$defs/quantity"},
            "thickness": {"$ref": "manufacturing.schema.json#/$defs/quantity"},
            "orientation": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "setup": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "tool": {"$ref": "manufacturing.schema.json#/$defs/semantic_id"},
            "finish": {"$ref": "manufacturing.schema.json#/$defs/text"}
          }
        },
        "result": {
          "type": "object", "additionalProperties": false, "required": ["limits", "samples"],
          "properties": {
            "limits": {"description": "the measured range of the characteristic", "$ref": "manufacturing.schema.json#/$defs/quantity"},
            "distribution": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "uncertainty": {"description": "the measurement uncertainty", "$ref": "manufacturing.schema.json#/$defs/quantity"},
            "samples": {"type": "integer", "minimum": 1, "x-plausible": {"min": 3}}
          }
        },
        "source": {"$ref": "manufacturing.schema.json#/$defs/source"},
        "date": {"$ref": "manufacturing.schema.json#/$defs/date"},
        "valid_until": {"$ref": "manufacturing.schema.json#/$defs/date"},
        "decision": {"$ref": "manufacturing.schema.json#/$defs/decision"}
      },
      "allOf": [
        {"if": {"required": ["characteristic"], "properties": {"characteristic": {"const": "bridge_span"}}}, "then": {"properties": {"result": {"properties": {"limits": {"$ref": "#/$defs/qty_bridge_span"}}}}}},
        {"if": {"required": ["characteristic"], "properties": {"characteristic": {"const": "overhang_angle"}}}, "then": {"properties": {"result": {"properties": {"limits": {"$ref": "#/$defs/qty_overhang_angle"}}}}}},
        {"if": {"required": ["characteristic"], "properties": {"characteristic": {"const": "min_wall"}}}, "then": {"properties": {"result": {"properties": {"limits": {"$ref": "#/$defs/qty_min_wall"}}}}}},
        {"if": {"required": ["characteristic"], "properties": {"characteristic": {"const": "min_feature"}}}, "then": {"properties": {"result": {"properties": {"limits": {"$ref": "#/$defs/qty_min_feature"}}}}}},
        {"if": {"required": ["characteristic"], "properties": {"characteristic": {"const": "min_hole"}}}, "then": {"properties": {"result": {"properties": {"limits": {"$ref": "#/$defs/qty_min_hole"}}}}}},
        {"if": {"required": ["characteristic"], "properties": {"characteristic": {"const": "min_bed_contact_area"}}}, "then": {"properties": {"result": {"properties": {"limits": {"$ref": "#/$defs/qty_min_bed_contact_area"}}}}}},
        {"if": {"required": ["characteristic"], "properties": {"characteristic": {"enum": ["hole_diameter_deviation", "dimensional_deviation", "profile_deviation"]}}}, "then": {"properties": {"result": {"properties": {"limits": {"$ref": "#/$defs/qty_deviation"}}}}}}
      ]
    }
  }
}
