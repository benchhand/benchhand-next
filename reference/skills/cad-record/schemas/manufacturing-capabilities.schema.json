{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srobroek.com/cad/schemas/manufacturing-capabilities.schema.json",
  "title": "CAD manufacturing capability profiles (hw/manufacturing/capabilities.yaml)",
  "description": "What the user's actual machines, operators and suppliers can do, kept apart from design requirements. Nominal resolution, machine specifications and drawing labels are parameters that describe the machine, never its achieved accuracy: achievable dimensional performance comes only from calibrations, each scoped to a material, feature, orientation, setup and tool, with its evidence. The plugin's capability templates carry template: true and hold no machine numbers; a template is never a capability. Parameter names per process kind are manufacturing_intent.CAPABILITY_PARAMETERS",
  "type": "object", "additionalProperties": false, "required": ["profiles"],
  "properties": {
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "description": "Parameters by name. A named parameter that has a hard bound is checked in every unit of its dimension; the bounds are in the qty_* and fact_* definitions below and the plausibility band (x-plausible, a warning) beside them. layer_height at most nozzle_diameter compares two facts in possibly different units, so the config loader checks it",
      "properties": {
        "nozzle_diameter": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_nozzle_diameter"}]},
        "layer_height": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_layer_height"}]},
        "hotend_max_temperature": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_hotend_max_temperature"}]},
        "bed_max_temperature": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_bed_max_temperature"}]},
        "max_speed": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_max_speed"}]},
        "travel_x": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_travel_x"}]},
        "travel_y": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_travel_y"}]},
        "travel_z": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_travel_z"}]},
        "spindle_max_speed": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_spindle_max_speed"}]},
        "power": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_power"}]},
        "pump_pressure": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_pump_pressure"}]},
        "press_brake_force": {"allOf": [{"$ref": "manufacturing.schema.json#/$defs/fact"}, {"$ref": "#/$defs/fact_press_brake_force"}]}
      },
      "propertyNames": {"$ref": "manufacturing.schema.json#/$defs/semantic_id"},
      "additionalProperties": {"$ref": "manufacturing.schema.json#/$defs/fact"}
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "title", "process", "provider", "parameters", "materials", "calibrations"],
      "properties": {
        "id": {"$ref": "manufacturing.schema.json#/$defs/profile_id"},
        "revision": {"type": "integer", "minimum": 1},
        "title": {"$ref": "manufacturing.schema.json#/$defs/text"},
        "process": {"$ref": "manufacturing.schema.json#/$defs/route_kind"},
        "provider": {"enum": ["local", "outsourced"]},
        "template": {"description": "present only on a plugin template: copy it, record your own values, then remove this flag", "const": true},
        "guidance": {"$ref": "manufacturing.schema.json#/$defs/texts"},
        "supplier": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "operator": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "machine": {
          "type": "object", "additionalProperties": false, "required": ["identity"],
          "properties": {
            "identity": {"description": "make, model and the machine's own identity", "$ref": "manufacturing.schema.json#/$defs/text_fact"},
            "location": {"$ref": "manufacturing.schema.json#/$defs/text"}
          }
        },
        "envelope": {
          "description": "The usable working envelope in the machine frame",
          "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
          "properties": {
            "x": {"$ref": "manufacturing.schema.json#/$defs/quantity_fact"},
            "y": {"$ref": "manufacturing.schema.json#/$defs/quantity_fact"},
            "z": {"$ref": "manufacturing.schema.json#/$defs/quantity_fact"}
          }
        },
        "materials": {
          "description": "The exact materials and stock the profile is approved or forbidden for; for laser, waterjet and plasma also its thickness, coating and extraction approval. An unidentified material is never approved",
          "oneOf": [{"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/material_approval"}},
                    {"$ref": "manufacturing.schema.json#/$defs/fact_open"}]
        },
        "parameters": {"$ref": "#/$defs/parameters"},
        "tools": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "description", "parameters"],
          "properties": {
            "id": {"$ref": "manufacturing.schema.json#/$defs/semantic_id"},
            "description": {"$ref": "manufacturing.schema.json#/$defs/text"},
            "parameters": {"$ref": "#/$defs/parameters"}
          }}},
        "workholding": {"$ref": "manufacturing.schema.json#/$defs/text_fact"},
        "constraints": {"$ref": "manufacturing.schema.json#/$defs/texts"},
        "calibrations": {"type": "array", "items": {"$ref": "#/$defs/calibration"}},
        "source": {"$ref": "manufacturing.schema.json#/$defs/source"}
      },
      "if": {"required": ["template"]},
      "then": {"required": ["guidance"], "properties": {"calibrations": {"maxItems": 0}}},
      "else": {"not": {"required": ["guidance"]}}
    },
    "qty_nozzle_diameter": {
      "description": "Nozzle diameter: above 0 and at most 3 mm",
      "x-plausible": {"min": 0.2, "max": 1.2, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 3}, "lower": {"exclusiveMinimum": 0, "maximum": 3}, "upper": {"exclusiveMinimum": 0, "maximum": 3}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 0.003}, "lower": {"exclusiveMinimum": 0, "maximum": 0.003}, "upper": {"exclusiveMinimum": 0, "maximum": 0.003}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 3000}, "lower": {"exclusiveMinimum": 0, "maximum": 3000}, "upper": {"exclusiveMinimum": 0, "maximum": 3000}}}}
      ]
    },
    "fact_nozzle_diameter": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_nozzle_diameter"}}}},
    "qty_layer_height": {
      "description": "Layer height: above 0 and at most 3 mm, the largest nozzle; a plausible layer is at most 0.8 of the nozzle diameter",
      "x-plausible": {"relative_to": "nozzle_diameter", "max": 0.8},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 3}, "lower": {"exclusiveMinimum": 0, "maximum": 3}, "upper": {"exclusiveMinimum": 0, "maximum": 3}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 0.003}, "lower": {"exclusiveMinimum": 0, "maximum": 0.003}, "upper": {"exclusiveMinimum": 0, "maximum": 0.003}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 3000}, "lower": {"exclusiveMinimum": 0, "maximum": 3000}, "upper": {"exclusiveMinimum": 0, "maximum": 3000}}}}
      ]
    },
    "fact_layer_height": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_layer_height"}}}},
    "qty_hotend_max_temperature": {
      "description": "Hotend limit: 0 to 500 deg_C",
      "x-plausible": {"max": 300, "units": "deg_C"},
      "properties": {"units": {"enum": ["deg_C", "K"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "deg_C"}}}, "then": {"properties": {"value": {"minimum": 0, "maximum": 500}, "lower": {"minimum": 0, "maximum": 500}, "upper": {"minimum": 0, "maximum": 500}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "K"}}}, "then": {"properties": {"value": {"minimum": 273.15, "maximum": 773.15}, "lower": {"minimum": 273.15, "maximum": 773.15}, "upper": {"minimum": 273.15, "maximum": 773.15}}}}
      ]
    },
    "fact_hotend_max_temperature": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_hotend_max_temperature"}}}},
    "qty_bed_max_temperature": {
      "description": "Bed limit: 0 to 150 deg_C",
      "x-plausible": {"max": 120, "units": "deg_C"},
      "properties": {"units": {"enum": ["deg_C", "K"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "deg_C"}}}, "then": {"properties": {"value": {"minimum": 0, "maximum": 150}, "lower": {"minimum": 0, "maximum": 150}, "upper": {"minimum": 0, "maximum": 150}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "K"}}}, "then": {"properties": {"value": {"minimum": 273.15, "maximum": 423.15}, "lower": {"minimum": 273.15, "maximum": 423.15}, "upper": {"minimum": 273.15, "maximum": 423.15}}}}
      ]
    },
    "fact_bed_max_temperature": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_bed_max_temperature"}}}},
    "qty_max_speed": {
      "description": "Print speed: above 0 and at most 1000 mm/s",
      "x-plausible": {"max": 500, "units": "mm_s"},
      "properties": {"units": {"enum": ["mm_s", "m_s"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm_s"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 1000}, "lower": {"exclusiveMinimum": 0, "maximum": 1000}, "upper": {"exclusiveMinimum": 0, "maximum": 1000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m_s"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 1}, "lower": {"exclusiveMinimum": 0, "maximum": 1}, "upper": {"exclusiveMinimum": 0, "maximum": 1}}}}
      ]
    },
    "fact_max_speed": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_max_speed"}}}},
    "qty_travel_x": {
      "description": "Axis travel: above 0 and at most 10 m",
      "x-plausible": {"max": 2000, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10}, "lower": {"exclusiveMinimum": 0, "maximum": 10}, "upper": {"exclusiveMinimum": 0, "maximum": 10}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000000}}}}
      ]
    },
    "fact_travel_x": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_travel_x"}}}},
    "qty_travel_y": {
      "description": "Axis travel: above 0 and at most 10 m",
      "x-plausible": {"max": 2000, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10}, "lower": {"exclusiveMinimum": 0, "maximum": 10}, "upper": {"exclusiveMinimum": 0, "maximum": 10}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000000}}}}
      ]
    },
    "fact_travel_y": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_travel_y"}}}},
    "qty_travel_z": {
      "description": "Axis travel: above 0 and at most 10 m",
      "x-plausible": {"max": 2000, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10}, "lower": {"exclusiveMinimum": 0, "maximum": 10}, "upper": {"exclusiveMinimum": 0, "maximum": 10}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000000}}}}
      ]
    },
    "fact_travel_z": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_travel_z"}}}},
    "qty_spindle_max_speed": {
      "description": "Spindle limit: above 0 and at most 200000 rpm",
      "x-plausible": {"max": 60000, "units": "rpm"},
      "properties": {"units": {"enum": ["rpm", "Hz"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "rpm"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 200000}, "lower": {"exclusiveMinimum": 0, "maximum": 200000}, "upper": {"exclusiveMinimum": 0, "maximum": 200000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "Hz"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 3333.333333333333}, "lower": {"exclusiveMinimum": 0, "maximum": 3333.333333333333}, "upper": {"exclusiveMinimum": 0, "maximum": 3333.333333333333}}}}
      ]
    },
    "fact_spindle_max_speed": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_spindle_max_speed"}}}},
    "qty_power": {
      "description": "Laser power: above 0 and at most 10 kW; a desktop laser stays under 300 W",
      "x-plausible": {"max": 0.3, "units": "kW"},
      "properties": {"units": {"enum": ["kW", "W"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "kW"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10}, "lower": {"exclusiveMinimum": 0, "maximum": 10}, "upper": {"exclusiveMinimum": 0, "maximum": 10}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "W"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000}}}}
      ]
    },
    "fact_power": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_power"}}}},
    "qty_pump_pressure": {
      "description": "Waterjet pump pressure: above 0 and at most 700 MPa",
      "x-plausible": {"max": 450, "units": "MPa"},
      "properties": {"units": {"enum": ["MPa", "GPa", "bar"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "MPa"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 700}, "lower": {"exclusiveMinimum": 0, "maximum": 700}, "upper": {"exclusiveMinimum": 0, "maximum": 700}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "GPa"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 0.7}, "lower": {"exclusiveMinimum": 0, "maximum": 0.7}, "upper": {"exclusiveMinimum": 0, "maximum": 0.7}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "bar"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 7000}, "lower": {"exclusiveMinimum": 0, "maximum": 7000}, "upper": {"exclusiveMinimum": 0, "maximum": 7000}}}}
      ]
    },
    "fact_pump_pressure": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_pump_pressure"}}}},
    "qty_press_brake_force": {
      "description": "Press brake force: above 0 and at most 10000 kN",
      "properties": {"units": {"enum": ["kN", "N"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "kN"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "N"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0, "maximum": 10000000}, "lower": {"exclusiveMinimum": 0, "maximum": 10000000}, "upper": {"exclusiveMinimum": 0, "maximum": 10000000}}}}
      ]
    },
    "fact_press_brake_force": {"if": {"required": ["status"], "properties": {"status": {"const": "known"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/qty_press_brake_force"}}}},
    "qty_bridge_span": {
      "description": "Calibrated unsupported bridge: 0 to 256 mm, the largest build volume",
      "x-plausible": {"max": 50, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"minimum": 0, "maximum": 256}, "lower": {"minimum": 0, "maximum": 256}, "upper": {"minimum": 0, "maximum": 256}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"minimum": 0, "maximum": 0.256}, "lower": {"minimum": 0, "maximum": 0.256}, "upper": {"minimum": 0, "maximum": 0.256}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"minimum": 0, "maximum": 256000.00000000003}, "lower": {"minimum": 0, "maximum": 256000.00000000003}, "upper": {"minimum": 0, "maximum": 256000.00000000003}}}}
      ]
    },
    "qty_overhang_angle": {
      "description": "Calibrated unsupported overhang, from vertical: 0 to 90 deg",
      "x-plausible": {"min": 20, "max": 70, "units": "deg"},
      "properties": {"units": {"enum": ["deg", "rad"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "deg"}}}, "then": {"properties": {"value": {"minimum": 0, "maximum": 90}, "lower": {"minimum": 0, "maximum": 90}, "upper": {"minimum": 0, "maximum": 90}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "rad"}}}, "then": {"properties": {"value": {"minimum": 0, "maximum": 1.570796326795}, "lower": {"minimum": 0, "maximum": 1.570796326795}, "upper": {"minimum": 0, "maximum": 1.570796326795}}}}
      ]
    },
    "qty_min_wall": {
      "description": "Calibrated thinnest wall: 0.1 to 25 mm",
      "x-plausible": {"min": 0.4, "max": 3, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"minimum": 0.1, "maximum": 25}, "lower": {"minimum": 0.1, "maximum": 25}, "upper": {"minimum": 0.1, "maximum": 25}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"minimum": 0.0001, "maximum": 0.025}, "lower": {"minimum": 0.0001, "maximum": 0.025}, "upper": {"minimum": 0.0001, "maximum": 0.025}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"minimum": 100, "maximum": 25000.000000000004}, "lower": {"minimum": 100, "maximum": 25000.000000000004}, "upper": {"minimum": 100, "maximum": 25000.000000000004}}}}
      ]
    },
    "qty_min_feature": {
      "description": "Calibrated smallest reliable pin or boss diameter: 0.2 to 20 mm",
      "x-plausible": {"min": 0.4, "max": 5, "units": "mm"},
      "properties": {"units": {"enum": ["mm", "m", "um"]}},
      "allOf": [
        {"if": {"required": ["units"], "properties": {"units": {"const": "mm"}}}, "then": {"properties": {"value": {"minimum": 0.2, "maximum": 20}, "lower": {"minimum": 0.2, "maximum": 20}, "upper": {"minimum": 0.2, "maximum": 20}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "m"}}}, "then": {"properties": {"value": {"minimum": 0.0002, "maximum": 0.02}, "lower": {"minimum": 0.0002, "maximum": 0.02}, "upper": {"minimum": 0.0002, "maximum": 0.02}}}},
        {"if": {"required": ["units"], "properties": {"units": {"const": "um"}}}, "then": {"properties": {"value": {"minimum": 200, "maximum": 20000}, "lower": {"minimum": 200, "maximum": 20000}, "upper": {"minimum": 200, "maximum": 20000}}}}
