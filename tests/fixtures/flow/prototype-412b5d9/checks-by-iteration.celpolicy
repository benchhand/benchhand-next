# The prototype at 412b5d9: skills/cad-flow/references/flow.md, "Checks by
# iteration" and "Fail-fast check order", as a restricted cel-policy rule
# list (flow/rules.schema.json). flow.yaml names it as the checks_by_iteration
# list, so every output is a list of check ids in run order, and [] runs none.
# A check that runs only under its own condition is concatenated in with
# `cond ? [id] : []`. "Only when stale" reads the stale evidence families that
# impact.py marks. Check arguments, such as drawing with jobs above 1 at L3,
# are not expressible and are left out. The activation names are made up for
# this test, as in flow.yaml.
name: prototype.checks_by_iteration
rule:
  match:
    # "Inner loop": a unit in its scratch workspace. The scratch build runs
    # the form check on the unit's PNs and, today, the static check over
    # every pair. The full sweep, the motion render, the integrated drawings
    # and a separate all-pairs check never run here.
    - condition: iteration == "inner"
      output: >-
        ["validate"]
        + (stage_order[stage] >= stage_order["layout"]
        ? ["scratch.build", "form_check.unit"] : [])
        + ["evidence.check_scratch"]
        + (stage == "detail"
        ? ["fits.stackup", "drawings.completeness_unit"] : [])
        + (unit.moving_pairs_changed ? ["sweep.smoke_changed"] : [])
        + (record.requirements.exists(r, r.binds_visibility)
        ? ["render.visibility"] : [])
        + (unit.role == "cad-analyst" ? ["fea.smoke_coarse"] : [])
    # "Commit (batch vN)", in the fail-fast order: build and validate, the
    # form check, static --changed-only, the smoke sweep, the renders; then
    # the record checks, and the stamp at a git commit of hw/.
    - condition: iteration == "commit"
      output: >-
        ["validate", "build"]
        + (stale.exists(s, s.family == "form" && s.changed_part)
        ? ["form_check.changed"] : [])
        + ["static.changed_only"]
        + (version.has_independent_joint ? ["sweep.smoke_changed"] : [])
        + ["render.views"]
        + (version.has_independent_joint ? ["motion.default_render"] : [])
        + (stage_order[stage] >= stage_order["layout"] ? ["bom.reconcile"] : [])
        + (stage_order[stage] >= stage_order["detail"] ? ["fits.stackup"] : [])
        + (stage_order[stage] >= stage_order["detail"]
        && stale.exists(s, s.family == "drawing") ? ["drawings.parts"] : [])
        + (stale.exists(s, s.family == "sourcing")
        ? ["sourcing.selection"] : [])
        + (version.git_commit ? ["recheck.stamp"] : [])
    # "Provisional gate": it reads the commit results and runs no static or
    # sweep check again. It checks the evidence for the gate's stage, and
    # again after the decision advances flow.stage, because product.yaml is
    # a record input and the check refuses the earlier packet.
    - condition: iteration == "provisional"
      output: >-
        ["validate.result", "render.visibility_result"]
        + (version.has_independent_joint
        ? ["motion.default_render_result"] : [])
        + ["bom.result", "fits.stackup_result", "form_check.result",
        "static.result"]
        + (version.has_independent_joint ? ["sweep.smoke_result"] : [])
        + ["evidence.check_stage", "evidence.check_stage_after_advance"]
    # "Full gate (approval)": fail-fast step 5 on the same vN. The full sweep
    # runs at L1 to L4: a skip at L2 or L3 needs a hash-proven carry-forward,
    # and no tool proves one yet. The motion render and the full sweep run
    # only on a version with an independent movable joint (evidence.py
    # _not_applicable).
    - condition: iteration == "full"
      output: >-
        ["validate", "static.all_pairs", "form_check.due"]
        + (version.has_independent_joint ? ["motion.default_render"] : [])
        + ["bom.reconcile", "fits.stackup"]
        + (version.has_independent_joint
        && stage in ["layout", "parts", "detail", "analysis"]
        ? ["sweep.full"] : [])
        + (stage == "detail" ? ["drawings.all"] : [])
        + (stage == "analysis" ? ["fea.all_cases"] : [])
        + (stage == "reconcile" ? ["fea.stale_cases"] : [])
        + (stage in ["intent", "parts"] ? ["sourcing.selection"] : [])
        + ["evidence.check", "recheck.stamp"]
    # "Design freeze". build_guide.py may preview; it is not a check.
    - condition: iteration == "design_freeze"
      output: >-
        ["validate", "bom.reconcile", "fits.stackup", "evidence.check",
        "recheck.stamp"]
        + (version.has_independent_joint
        && stale.exists(s, s.family == "sweep") ? ["sweep.full"] : [])
        + (stale.exists(s, s.family == "drawing") ? ["drawings.all"] : [])
        + (stale.exists(s, s.family == "fea") ? ["fea.stale_cases"] : [])
    # "Release": the guide and the seal run only after the user approved the
    # RELEASE gate ("After approval, seal"), so before it nothing runs;
    # release.py runs the evidence check itself and refuses a release
    # decision that isn't accepted.
    - condition: iteration == "release" && gates.release.approved
      output: '["validate", "bom.reconcile", "build_guide", "release.seal"]'
    - output: "[]"
