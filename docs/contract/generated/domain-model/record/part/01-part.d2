...@../../classes
direction: right

"aggregate__record_part": {
  class: aggregate
  label: "part"
  "record_part": {
    class: document
    label: "part"
    shape: sql_table
    "PN": "pn" { constraint: "req" }
    "rev": "revision" { constraint: "req" }
    "title": "string" { constraint: "req" }
    "material": "string" { constraint: "req" }
    "process": "primary_process" { constraint: "req" }
    "finish": "string" { constraint: "req" }
    "mass_target": "number or null" { constraint: "req" }
    "make_buy": "enum make|buy" { constraint: "req" }
    "supplier": "string or null"
    "decisions": "decision[]"
    "model_frame": "enum assembly_zero|part_local"
    "form_class": "enum solid|frame|plate|skeleton|shell"
    "transparency": "enum opaque|translucent|transparent"
    "procurement": "procurement"
    "drawing": "part_drawing"
    "manufacture": "object"
    "intent": "intent"
  }
  "record_part__manufacture": {
    class: owned
    label: "part.manufacture"
    shape: sql_table
    "relationship": "enum same|different" { constraint: "req" }
    "state": "string"
    "reason": "string"
    "decision": "decision"
    "volume_rel_tolerance": "number"
    "volume_abs_tolerance_mm3": "number"
    "mesh": "object"
  }
  "record_part__manufacture__mesh": {
    class: owned
    label: "part.manufacture.mesh"
    shape: sql_table
    "linear_deflection_mm": "number"
    "angular_deflection_rad": "number"
  }
  "record_part__intent": {
    class: owned
    label: "intent"
    shape: sql_table
    "functions": "function_entry[1..*] or fact_unknown" { constraint: "req" }
    "material_profile": "profile_id or fact_open" { constraint: "req" }
    "color": "string"
    "selection": "semantic_id"
    "service": "object or fact_open" { constraint: "req" }
    "components": "component[1..*]"
    "critical_surfaces": "critical_surface[1..*] or fact_open" { constraint: "req" }
    "route": "operation[1..*] or fact_unknown" { constraint: "req" }
    "rationale": "object"
  }
  "record_part__intent__service": {
    class: union
    label: "intent.service  «union»"
    shape: sql_table
  }
  "record_part__intent__service__1": {
    class: owned
    label: "intent.service.1"
    shape: sql_table
    "requirements": "requirement_ids"
    "loads": "semantic_ids"
    "environment": "text"
    "duty": "text"
    "life": "quantity_fact"
    "differences": "text"
  }
  "record_part__component": {
    class: owned
    label: "component"
    shape: sql_table
    "id": "semantic_id" { constraint: "req" }
    "witness": "vector"
    "locator": "target"
    "material_profile": "profile_id or fact_open"
    "functions": "function_entry[1..*]"
    "multiplicity": "integer"
    "note": "text"
  }
  "record_part__critical_surface": {
    class: owned
    label: "critical_surface"
    shape: sql_table
    "id": "semantic_id" { constraint: "req" }
    "feature": "semantic_id" { constraint: "req" }
    "region": "semantic_id"
    "component": "semantic_id"
    "role": "enum" { constraint: "req" }
    "interfaces": "interface_id[1..*]"
    "requirements": "requirement_ids"
    "criteria": "criterion[1..*]"
    "finish": "text"
    "inspection": "semantic_id"
    "dimension_state": "dimension_state = as_manufactured|after_finish|assembled" { constraint: "req" }
  }
  "record_part__intent__rationale": {
    class: owned
    label: "intent.rationale"
    shape: sql_table
    "decision": "decision"
    "selection": "semantic_id"
    "alternatives": "texts"
    "tradeoffs": "text"
  }
}
