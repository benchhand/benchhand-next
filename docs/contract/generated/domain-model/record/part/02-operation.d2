...@../../classes
direction: right

"aggregate__record_part__operation": {
  class: aggregate
  label: "operation"
  "record_part__operation": {
    class: owned
    label: "operation  «type»"
    shape: sql_table
    "id": "semantic_id" { constraint: "req" }
    "kind": "semantic_id" { constraint: "req" }
    "title": "text"
    "capability": "profile_id or fact_unknown"
    "provider": "enum local|outsourced"
    "supplier": "text"
    "components": "semantic_ids"
    "depends_on": "semantic_ids"
    "input_state": "semantic_id"
    "output_state": "semantic_id"
    "material_state_in": "text"
    "material_state_out": "text"
    "targets": "target[1..*]"
    "setup": "setup"
    "orientation": "orientation or fact_open"
    "supports": "supports or fact_open"
    "allowances": "allowance[1..*]"
    "post_processing": "texts"
    "inspection": "inspection[1..*]"
    "requirements": "requirement_ids"
    "criteria": "criterion[1..*]"
    "evidence": "evidence_id[1..*]"
    "purchase": "purchase"
  }
  "record_part__operation__orientation": {
    class: union
    label: "operation.orientation  «union»"
    shape: sql_table
  }
  "record_part__orientation": {
    class: owned
    label: "orientation  «type»"
    shape: sql_table
    "status": "enum proposed|approved" { constraint: "req" }
    "rotation": "object" { constraint: "req" }
    "decision": "decision"
    "selection": "semantic_id"
    "note": "text"
  }
  "record_part__orientation__rotation": {
    class: union
    label: "orientation.rotation  «union»"
    shape: sql_table
  }
  "record_part__orientation__rotation__1": {
    class: owned
    label: "orientation.rotation.1  «type»"
    shape: sql_table
    "quaternion": "number[4]" { constraint: "req" }
  }
  "record_part__orientation__rotation__2": {
    class: owned
    label: "orientation.rotation.2  «type»"
    shape: sql_table
    "axis": "vector" { constraint: "req" }
    "angle_deg": "number" { constraint: "req" }
  }
  "record_part__operation__supports": {
    class: union
    label: "operation.supports  «union»"
    shape: sql_table
  }
  "record_part__supports": {
    class: owned
    label: "supports  «type»"
    shape: sql_table
    "strategy": "enum none|reachable_noncritical|finished_critical" { constraint: "req" }
    "start_regions": "target[1..*]"
    "contact_regions": "target[1..*]"
    "material": "text"
    "removal": "object"
    "affected_surfaces": "target[1..*]"
    "allowance": "quantity"
    "finish": "text"
    "inspection": "semantic_ids"
  }
  "record_part__supports__removal": {
    class: owned
    label: "supports.removal  «type»"
    shape: sql_table
    "tools": "texts" { constraint: "req" }
    "access": "text" { constraint: "req" }
    "path": "text"
  }
  "record_part__allowance": {
    class: owned
    label: "allowance  «type»"
    shape: sql_table
    "feature": "semantic_id" { constraint: "req" }
    "region": "semantic_id"
    "dimension": "semantic_id"
    "amount": "quantity" { constraint: "req" }
    "purpose": "enum stock|finish|coating|support_removal|shrinkage|other" { constraint: "req" }
    "limits": "text"
    "source": "source" { constraint: "req" }
  }
  "record_part__inspection": {
    class: owned
    label: "inspection  «type»"
    shape: sql_table
    "id": "semantic_id" { constraint: "req" }
    "feature": "semantic_id"
    "region": "semantic_id"
    "requirement": "requirement_id"
    "criterion": "criterion"
    "method": "text" { constraint: "req" }
    "instrument": "text"
    "capability": "profile_id"
    "state": "dimension_state = as_manufactured|after_finish|assembled" { constraint: "req" }
    "coupon": "boolean"
    "evidence": "evidence_id[1..*]"
  }
}
