"aggregate__record_evidence_assessment": {
  class: aggregate
  label: "evidence-assessment"
  "record_evidence_assessment": {
    class: document
    label: "evidence-assessment  «document»"
    shape: sql_table
    "version": "version" { constraint: "req" }
    "manifest_sha256": "sha256" { constraint: "req" }
    "build_staleness": "enum computed|not_computed" { constraint: "req" }
    "expected_sha256": "sha256" { constraint: "req" }
    "statuses": "obligation_status[]" { constraint: "req" }
    "facets": "facets by key" { constraint: "req" }
    "findings": "finding[]" { constraint: "req" }
    "critical": "critical_finding[]" { constraint: "req" }
    "complete": "boolean" { constraint: "req" }
    "acceptance": "acceptance_formed or acceptance_refused" { constraint: "req" }
  }
  "record_evidence_assessment__obligation_status": {
    class: owned
    label: "obligation_status  «type»"
    shape: sql_table
    "obligation": "obligation" { constraint: "req" }
    "result": "evidence_result" { constraint: "req" }
    "sources": "string[]" { constraint: "req" }
    "reasons": "string[]" { constraint: "req" }
    "waiver": "waiver"
  }
  "record_evidence_assessment__facets": {
    class: owned
    label: "facets  «type»"
    shape: sql_table
    "cad_valid": "facet_result" { constraint: "req" }
    "geometrically_manufacturable": "facet_result" { constraint: "req" }
    "process_planned": "facet_result" { constraint: "req" }
    "simulation_supported": "facet_result" { constraint: "req" }
    "physically_validated": "facet_result" { constraint: "req" }
  }
  "record_evidence_assessment__critical_finding": {
    class: owned
    label: "critical_finding  «type»"
    shape: sql_table
    "finding": "semantic_id" { constraint: "req" }
    "code": "finding_code"
    "bundle": "project_path" { constraint: "req" }
    "obligation": "obligation_id"
    "consequence": "text"
  }
  "record_evidence_assessment__acceptance": {
    class: union
    label: "evidence-assessment.acceptance  «abstract»"
    shape: sql_table
    "status": "discriminator" { constraint: "req" }
  }
  "record_evidence_assessment__acceptance_formed": {
    class: owned
    label: "acceptance_formed  «type»"
    shape: sql_table
    "status": "const formed" { constraint: "req" }
    "evidence_sha256": "sha256" { constraint: "req" }
    "inventory": "sha256 by key" { constraint: "req" }
  }
  "record_evidence_assessment__acceptance_refused": {
    class: owned
    label: "acceptance_refused  «type»"
    shape: sql_table
    "status": "const refused" { constraint: "req" }
    "reason": "text" { constraint: "req" }
  }
}
