    class: owned
    label: "product.manufacturing.min_wall_mm  «type»"
    shape: sql_table
    "fdm": "number"
    "cnc": "number"
  }
  "record_product__storage": {
    class: owned
    label: "product.storage  «type»"
    shape: sql_table
    "results_in_git": "boolean"
  }
}
