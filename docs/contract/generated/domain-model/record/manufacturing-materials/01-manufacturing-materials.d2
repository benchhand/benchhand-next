direction: right

"aggregate__record_manufacturing_materials": {
  class: aggregate
  label: "manufacturing-materials"
  "record_manufacturing_materials": {
    class: document
    label: "manufacturing-materials"
    shape: sql_table
    "profiles": "profile[]" { constraint: "req" }
  }
  "record_manufacturing_materials__profile": {
    class: owned
    label: "profile"
    shape: sql_table
    "id": "profile_id" { constraint: "req" }
    "revision": "integer" { constraint: "req" }
    "title": "text" { constraint: "req" }
    "level": "enum family|grade" { constraint: "req" }
    "family": "text" { constraint: "req" }
    "material_family": "scope_fact"
    "filler": "scope_fact"
    "shore": "scope_fact"
    "grade": "text_fact" { constraint: "req" }
    "manufacturer": "text_fact"
    "specification": "text_fact"
    "form": "enum" { constraint: "req" }
    "process_state": "object" { constraint: "req" }
    "typical_not_allowable": "boolean" { constraint: "req" }
    "properties": "property[]" { constraint: "req" }
    "guidance": "texts"
    "note": "text"
  }
  "record_manufacturing_materials__profile__process_state": {
    class: owned
    label: "profile.process_state"
    shape: sql_table
    "process": "semantic_id or fact_open" { constraint: "req" }
    "orientation": "text"
    "layup": "text"
    "temper": "text"
    "conditioning": "conditioning = dry|conditioned|as_received|unknown" { constraint: "req" }
    "lot": "text"
    "notes": "text"
  }
  "record_manufacturing_materials__property": {
    class: owned
    label: "property"
    shape: sql_table
    "name": "semantic_id" { constraint: "req" }
    "value": "quantity_fact" { constraint: "req" }
    "conditions": "object" { constraint: "req" }
  }
  "record_manufacturing_materials__property__conditions": {
    class: owned
    label: "property.conditions"
    shape: sql_table
    "test_standard": "text_fact" { constraint: "req" }
    "temperature": "quantity_fact" { constraint: "req" }
    "conditioning": "conditioning = dry|conditioned|as_received|unknown" { constraint: "req" }
    "orientation": "text_fact"
    "gauge": "gauge = 5.65sqrtS0|5d|A50mm|A2in|other"
    "specimen": "text"
    "rate": "text"
    "notes": "text"
  }
}
