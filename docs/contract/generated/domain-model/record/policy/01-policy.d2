...@../../classes
direction: right

"aggregate__record_policy": {
  class: aggregate
  label: "policy"
  "record_policy": {
    class: document
    label: "policy"
    shape: sql_table
    "policy_version": "const 1" { constraint: "req" }
    "default": "mode = ask|chat|auto"
    "decision": "decision"
    "gates": "gate by key"
    "rigor": "enum standard|regulated"
  }
  "record_policy__gate": {
    class: owned
    label: "gate"
    shape: sql_table
    "mode": "mode = ask|chat|auto" { constraint: "req" }
    "decision": "decision"
  }
}

"aggregate__record_policy"."record_policy"."gates" -> "aggregate__record_policy"."record_policy__gate": "gates [0..*]" { class: composition }
