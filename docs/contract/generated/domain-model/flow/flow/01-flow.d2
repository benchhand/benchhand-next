...@../../classes
direction: right

"aggregate__flow_flow": {
  class: aggregate
  label: "flow"
  "flow_flow": {
    class: document
    label: "flow"
    shape: sql_table
    "flow_version": "const 1" { constraint: "req" }
    "stages": "FlowStages" { constraint: "req" }
    "gates": "FlowGate[1..*]" { constraint: "req" }
    "edges": "FlowEdge[1..*]" { constraint: "req" }
    "rules": "FlowRuleLists" { constraint: "req" }
    "void_scope": "CelExpression" { constraint: "req" }
    "reapproval_scope": "CelExpression"
  }
  "flow_flow__FlowStages": {
    class: owned
    label: "FlowStages"
    shape: sql_table
    "ground": "FlowStage" { constraint: "req" }
    "intent": "FlowStage" { constraint: "req" }
    "specify": "FlowStage" { constraint: "req" }
    "concept": "FlowStage" { constraint: "req" }
    "layout": "FlowStage" { constraint: "req" }
    "parts": "FlowStage" { constraint: "req" }
    "detail": "FlowStage" { constraint: "req" }
    "bom": "FlowStage" { constraint: "req" }
    "analysis": "FlowStage" { constraint: "req" }
    "critique": "FlowStage" { constraint: "req" }
    "reconcile": "FlowStage" { constraint: "req" }
    "design_freeze": "FlowStage" { constraint: "req" }
    "release": "FlowStage" { constraint: "req" }
  }
  "flow_flow__FlowStage": {
    class: owned
    label: "FlowStage"
    shape: sql_table
    "guides": "FlowGuides" { constraint: "req" }
  }
  "flow_flow__FlowGuides": {
    class: owned
    label: "FlowGuides"
    shape: sql_table
    "lead": "FlowGuideFragment" { constraint: "req" }
    "[key]": "FlowGuideFragment"
  }
  "flow_flow__FlowGate": {
    class: union
    label: "FlowGate  «abstract»"
    shape: sql_table
    "kind": "discriminator" { constraint: "req" }
  }
  "flow_flow__FlowSingleHumanGate": {
    class: owned
    label: "FlowSingleHumanGate"
    shape: sql_table
    "id": "gate_id" { constraint: "req" }
    "stage": "stage" { constraint: "req" }
    "kind": "const single-human" { constraint: "req" }
    "requires": "object" { constraint: "req" }
  }
  "flow_flow__FlowSingleHumanGate__requires": {
    class: owned
    label: "FlowSingleHumanGate.requires"
    shape: sql_table
    "human": "CelExpressions" { constraint: "req" }
  }
  "flow_flow__FlowStagedGate": {
    class: owned
    label: "FlowStagedGate"
    shape: sql_table
    "id": "gate_id" { constraint: "req" }
    "stage": "stage" { constraint: "req" }
    "kind": "const provisional+full+human" { constraint: "req" }
    "requires": "object" { constraint: "req" }
  }
  "flow_flow__FlowStagedGate__requires": {
    class: owned
    label: "FlowStagedGate.requires"
    shape: sql_table
    "provisional": "CelExpressions" { constraint: "req" }
    "full": "CelExpressions" { constraint: "req" }
    "human": "CelExpressions" { constraint: "req" }
  }
  "flow_flow__FlowEdge": {
    class: owned
    label: "FlowEdge"
    shape: sql_table
    "from": "stage" { constraint: "req" }
    "to": "stage" { constraint: "req" }
    "gate": "gate_id"
    "guard": "CelExpression"
  }
}
