# Deployment and runtime: docs/architecture/overview.md.
# Solid: on main, checked against the code. Dashed: planned or open, labelled with the phase that
# docs/design-plan.md "Steps (phased)" gives it. Render: d2 --layout elk --pad 40 deployment.d2 deployment.svg (d2 0.9.0).

vars: {
  d2-legend: {
    main: "On main" {class: main}
    planned: "Planned, Phase N" {class: planned}
    open: "Open: no phase in Steps" {class: open}
    external: "Outside benchhand" {class: external}
  }
}

classes: {
  main: {style: {fill: "#e8f5e9"; stroke: "#2e7d32"; stroke-width: 2; font-color: "#1b1b1b"}}
  planned: {style: {fill: "#ffffff"; stroke: "#616161"; stroke-width: 1; stroke-dash: 4; font-color: "#1b1b1b"}}
  open: {style: {fill: "#ffebee"; stroke: "#c62828"; stroke-width: 2; stroke-dash: 2; font-color: "#1b1b1b"}}
  external: {style: {fill: "#eceff1"; stroke: "#37474f"; stroke-width: 1; font-color: "#1b1b1b"}}
  layer: {style: {fill: "#fafafa"; stroke: "#9e9e9e"; font-color: "#1b1b1b"; font-size: 20}}
  layer_planned: {style: {fill: "#fafafa"; stroke: "#9e9e9e"; stroke-dash: 4; font-color: "#1b1b1b"; font-size: 20}}
  on_main: {style: {stroke: "#2e7d32"; stroke-width: 2}}
  planned_call: {style: {stroke: "#616161"; stroke-dash: 4}}
}

direction: down

machine: "The designer's machine" {
  class: layer

  host: "MCP host process\nClaude Code, Claude Desktop, Codex, OpenCode, Kiro, Pi\ndocs/client-support.md" {class: external}
  browser: "Web browser" {class: external}

  native: "Native install (ADR-0002)" {
    class: layer
    uvx: "uv / uvx" {class: external}
    mcp: "benchhand mcp, packages/benchhand\nstdio: one process per session; --http: one shared server\nPhase 3" {
      class: layer_planned
      endpoint: "MCP endpoint\nstdio, or loopback streamable HTTP\nwith a bearer token (--http)\nPhase 3" {class: planned}
      preview: "Preview listener\n127.0.0.1, ephemeral port,\nHost-header check, path token\nPhase 5" {class: planned}
      flow: "Flow engine, benchhand-core\nloads and verifies the rules bundle\n(ADR-0020): Phase 2\nin the server from Phase 3" {class: planned}
      provider_host: "Provider host\nopen: no phase in Steps" {class: open}
      jobs: "Job service, benchhand_core.jobs\nsupervisor in its own session,\nanchored process group" {class: main}
    }
    cli: "benchhand record migrate\nbehind the record-migration flag, off\npackages/benchhand/src/benchhand/cli.py" {class: main}
    rules_compile: "benchhand rules compile\nruns the benchhand-celcheck binary\non a user's rule lists (ADR-0020)\nPhase 3" {class: planned}
    probe: "Capability probe, dev only\ntools/probe/probe.py (ADR-0016)" {class: main}
    providers: "Provider processes, providers/\none per provider, each in its own uv env\nPhase 4" {
      class: layer_planned
      others: "kernels, solvers, render,\nchecks, store\nPhase 4" {class: planned}
      freecad: "freecad provider\nlocates or installs FreeCAD,\ngates its version\nPhase 4" {class: planned}
    }
    freecadcmd: "freecadcmd\na supported FreeCAD,\nfound on the host or managed\nPhase 4" {class: planned}
  }

  container: "Container option (ADR-0002)" {
    class: layer
    launcher: "benchhand mcp --container launcher\nresolves the project, pulls, supervises\nopen: no phase in Steps" {class: open}
    runtime: "Container runtime\ndocker, podman, nerdctl, Colima" {class: external}
    image: "benchhand OCI image\nbenchhand mcp with FreeCAD, both kernels, Chromium\nPhase 7" {class: planned}
  }

  project: "Project root: the working directory, MCP roots or --project" {
    class: layer
    hw: "hw/\nthe design record" {class: main}
    dot: ".benchhand/runs/\njob run records" {class: main}
  }

  cache: "User cache, <data>/freecad/<version>\nmanaged FreeCAD\nPhase 4" {class: planned}
}

ci: "CI: GitHub Actions" {
  class: layer
  celgo: "Pinned cel-go tool, tools/celcheck/\ncompiles flow/*.celpolicy\nPhase 2 (ADR-0020)" {class: planned}
  bundle: "Rules bundle\nprofile digest, checker, entry hashes\nPhase 2 (ADR-0020)" {class: planned}
  celgo -> bundle: "fails on a stale entry\nPhase 2" {class: planned_call}
}

pypi: "PyPI" {class: external}
ghcr: "GHCR" {class: external}

machine.host -> machine.native.uvx: "spawns uvx benchhand@<ver> mcp\nthe MCP config, written by install: Phase 6" {class: planned_call}
machine.native.uvx -> pypi: "fetches and caches benchhand@<ver>\nPhase 7" {class: planned_call}
machine.native.uvx -> machine.native.mcp: "starts\nPhase 3" {class: planned_call}
machine.host <-> machine.native.mcp.endpoint: "MCP over stdio, or loopback HTTP with --http\nPhase 3" {class: planned_call}
machine.host <-> machine.native.probe: "MCP over stdio" {class: on_main}
machine.browser -> machine.native.mcp.preview: "loopback HTTP\nPhase 5" {class: planned_call}
machine.native.mcp.provider_host <-> machine.native.providers: "provider protocol: JSON-RPC 2.0 over stdio\nPhase 4" {class: planned_call}
machine.native.providers.freecad -> machine.cache: "installs FreeCAD here\nPhase 4" {class: planned_call}
machine.native.providers.freecad -> machine.native.freecadcmd: "locates and runs it\nPhase 4" {class: planned_call}
machine.native.mcp -> machine.project.hw: "reads and writes the record\nPhase 3" {class: planned_call}
machine.native.cli -> machine.project.hw: "migrates the record\nrecord-migration flag on" {class: on_main}
machine.native.mcp.jobs -> machine.project.dot: "writes run records" {class: on_main}
machine.native.rules_compile -> machine.project: "writes a user's bundle beside its rule lists\nthe path is open (ADR-0020)\nPhase 3" {class: planned_call}

machine.host -> machine.container.launcher: "spawns uvx benchhand@<ver> mcp --container\ninstall --container: Phase 6" {class: planned_call}
machine.container.launcher -> machine.container.runtime: "run -i, pumps stdio, supervises\nopen: no phase in Steps" {class: planned_call}
machine.container.runtime -> machine.container.image: "runs\nPhase 7" {class: planned_call}
machine.container.runtime -> ghcr: "pulls the pinned benchhand image\nPhase 7" {class: planned_call}
machine.container.image -> machine.project: "mounts the whole project root\nat the same path\nPhase 7" {class: planned_call}

ci.bundle -> machine.native.mcp.flow: "ships with benchhand; refused at load\nwhen missing or stale\nPhase 2" {class: planned_call}
