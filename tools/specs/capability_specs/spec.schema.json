{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchhand.github.io/benchhand-next/tools/specs/spec.schema.json",
  "title": "The front matter of a capability spec under docs/specs/",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "title", "status", "capabilities", "questions", "rules", "issues", "blocks"],
  "properties": {
    "spec": {
      "description": "The spec's id, which is its file name without .md.",
      "$ref": "#/$defs/Id"
    },
    "title": { "$ref": "#/$defs/Text" },
    "status": {
      "description": "draft: written, waiting for the owner. approved: the owner approved it, blocks may start. in-progress: a block has merged. done: every block has merged. superseded: replaced, kept for history.",
      "enum": ["draft", "approved", "in-progress", "done", "superseded"]
    },
    "capabilities": {
      "description": "The catalogue capability ids the spec covers. A capability is covered by one spec at most.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Id" }
    },
    "questions": {
      "description": "The catalogue open-question ids the spec depends on or works around.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Id" }
    },
    "rules": {
      "description": "The issue register's design rules (RULE-nn) the requirements apply.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^RULE-[0-9]{2}$" }
    },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closes", "defers"],
      "properties": {
        "closes": {
          "description": "The register entries a block of this spec closes, each with the test that proves it.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "block", "test"],
            "properties": {
              "id": { "$ref": "#/$defs/IssueId" },
              "block": { "$ref": "#/$defs/BlockId" },
              "test": { "$ref": "#/$defs/Text" }
            }
          }
        },
        "defers": {
          "description": "Register entries joined to this spec's capabilities that another capability closes.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "to", "reason"],
            "properties": {
              "id": { "$ref": "#/$defs/IssueId" },
              "to": { "$ref": "#/$defs/Id" },
              "reason": { "$ref": "#/$defs/Text" }
            }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "size", "requirements", "depends_on"],
        "properties": {
          "id": { "$ref": "#/$defs/BlockId" },
          "title": { "$ref": "#/$defs/Text" },
          "size": {
            "description": "S: a day or less. M: a few days. L: a week or more.",
            "enum": ["S", "M", "L"]
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^REQ-[1-9][0-9]*$" }
          },
          "depends_on": {
            "description": "A block id (of any spec), question:<catalogue question id>, or capability:<id> for a capability no spec covers yet.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^([A-Z]+-[1-9][0-9]*|question:[a-z][a-z0-9-]*|capability:[a-z][a-z0-9-]*)$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "Text": { "type": "string", "minLength": 1 },
    "IssueId": { "type": "string", "pattern": "^IR-[0-9]{3}$" },
    "BlockId": { "type": "string", "pattern": "^[A-Z]+-[1-9][0-9]*$" }
  }
}
