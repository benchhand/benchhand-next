name: checks_by_iteration_flat
description: >-
  The same rule list without policy variables, so the compiled expression
  has no cel.@block: plain nested conditionals.
rule:
  match:
    - condition: stage in ["parts", "detail"] && iteration == "commit"
      output: '["form_check", "check_changed_only"]'
    - condition: part.make_buy == "buy" && part.procurement.mode == "catalog"
      output: '["catalog_check"]'
    - condition: has(part.mass_target) && part.mass_target < 1.0
      output: '["mass_check"]'
    - output: '["form_check"]'
